# =============================================================================
# SignaPlan - Variables de entorno para DESARROLLO
# =============================================================================
# Copia este archivo: cp .env.example .env
# Estos valores son seguros para desarrollo local.
# Para producción usa: .env.production.example
# =============================================================================

# --- DOMINIO (desarrollo) ---
DOMAIN=localhost

# --- SEGURIDAD ---
SECRET_KEY=dev-secret-key-change-in-production
ENCRYPTION_KEY=
SSO_SECRET_KEY=
# App externa Alta Odoo (debe coincidir SSO_SECRET_KEY en su .env). Vacío = mismo host :5002
ODOO_ALTA_APP_URL=
# Subdominio del tenant para login directo en la app Alta Odoo (ej. soltec)
ODOO_ALTA_TENANT_SLUG=soltec

# --- BASE DE DATOS ---
POSTGRES_PASSWORD=postgres

# --- SUPERADMIN ---
SUPERADMIN_USER=
SUPERADMIN_PASS=

# --- CORREO (IONOS: info@signaplan.com) ---
# Sin MAIL_PASSWORD los envíos fallan con aviso explícito (recuperar, alta, avisos).
MAIL_SERVER=smtp.ionos.es
MAIL_PORT=587
MAIL_USERNAME=info@signaplan.com
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=info@signaplan.com

# --- FACTURACIÓN ---
# false (por defecto): producto usable completo sin cobro ni cupos.
# true: activa límites freemium + geo de pago (cuando haya Stripe/autónomo).
BILLING_ENFORCED=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
# SIGNAPLAN_BASE_DOMAIN=signaplan.com
# Origen canónico del marketing (sin www). Caddy redirige www → apex.
# SIGNAPLAN_PUBLIC_ORIGIN=https://signaplan.com

# --- ANALÍTICA (opcional; solo carga tras consentimiento de cookies) ---
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# --- LAN / MÓVIL (mismo comportamiento que producción) ---
# IP sola → landing. Tenant → subdominio delante:
#   http://paquito.192.168.1.141.sslip.io/fichaje/
# (sslip.io resuelve a esa IP; el Host lleva el subdominio)

# --- LEGALES (titular del servicio) ---
LEGAL_RAZON_SOCIAL=Francisco Navarro Hernández
LEGAL_NIF=18461268L
LEGAL_DOMICILIO=Calle La Ermita 23, Teruel
LEGAL_EMAIL=info@signaplan.com
# Buzón comercial del formulario /contacto (por defecto info@signaplan.com)
CONTACT_EMAIL=info@signaplan.com

# --- ODOO (dejar vacío si no se usa sincronización) ---
ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_PASSWORD=

# --- CELERY ---
CELERY_TASK_ALWAYS_EAGER=false

# --- DATOS DEMO (trial post-alta) ---
# DEMO_N_OBRAS=10
# DEMO_N_EMPLEADOS=28
# DEMO_N_EXTERNOS=4
# DEMO_N_VEHICULOS=5
# DEMO_N_JEFES=2
# DEMO_N_DIAS=14
# DEMO_N_DIAS_FLOTA=21
