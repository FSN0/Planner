# =============================================================================
# SignaPlan - Variables de entorno para DESARROLLO
# =============================================================================
# Copia este archivo: cp .env.example .env
# Estos valores son seguros para desarrollo local.
# Para producción usa: .env.production.example
# =============================================================================

# --- DOMINIO (desarrollo) ---
DOMAIN=localhost

# --- SEGURIDAD ---
SECRET_KEY=dev-secret-key-change-in-production
ENCRYPTION_KEY=hIQxMPbaYZ_WxJx4w3d9OaV8gQSNJFnKHQVfQPl7S1k=
SSO_SECRET_KEY=dev-sso-key
# App externa Alta Odoo (debe coincidir SSO_SECRET_KEY en su .env). Vacío = mismo host :5002
ODOO_ALTA_APP_URL=
# Subdominio del tenant para login directo en la app Alta Odoo (ej. soltec)
ODOO_ALTA_TENANT_SLUG=soltec

# --- BASE DE DATOS ---
POSTGRES_PASSWORD=postgres

# --- SUPERADMIN ---
SUPERADMIN_USER=admin@signaplan.com
SUPERADMIN_PASS=admin123

# --- CORREO (dejar vacío para deshabilitar envíos) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- FACTURACIÓN ---
# false (por defecto): producto usable completo sin cobro ni cupos.
# true: activa límites freemium + geo de pago (cuando haya Stripe/autónomo).
BILLING_ENFORCED=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
# SIGNAPLAN_BASE_DOMAIN=signaplan.com

# --- LAN / MÓVIL (mismo comportamiento que producción) ---
# IP sola → landing. Tenant → subdominio delante:
#   http://paquito.192.168.1.141.sslip.io/mi/
# (sslip.io resuelve a esa IP; el Host lleva el subdominio)

# --- LEGALES (titular del servicio; opcional) ---
# LEGAL_RAZON_SOCIAL=SignaPlan
# LEGAL_NIF=
# LEGAL_DOMICILIO=
# LEGAL_EMAIL=info@signaplan.com

# --- ODOO (dejar vacío si no se usa sincronización) ---
ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_PASSWORD=

# --- CELERY ---
CELERY_TASK_ALWAYS_EAGER=false
