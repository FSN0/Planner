# Configuración Caddy para DESARROLLO LOCAL
#
# En producción se usa Caddyfile.prod (montado por docker-compose.prod.yml).
# No añadas dominios reales aquí: el bloque :80 captura el puerto 80 entero
# y rompe la validación ACME / Let's Encrypt de Caddy.

:80 {
    reverse_proxy web:5000
    encode gzip
}
