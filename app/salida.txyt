===== ./auth/routes.py =====

# app/auth/routes.py

from flask import Blueprint, render_template, request, redirect, url_for, flash
from werkzeug.security import generate_password_hash, check_password_hash
from flask_login import login_user, logout_user, login_required, current_user
from app.models import User, ROLE_OPERARIO, Company
from app import db
from sqlalchemy.exc import IntegrityError
from datetime import date

auth_bp = Blueprint('auth', __name__)

@auth_bp.route('/login', methods=['GET', 'POST'])
def login():
    # Si el usuario ya está autenticado, redirige a su panel
    if current_user.is_authenticated:
        if current_user.role == 'admin':
            return redirect(url_for('admin.panel'))
        elif current_user.role == 'jefe_obra':
            # CAMBIO AQUÍ: Redirigir a obras_detailed con fecha
            return redirect(url_for('jefe.obras_detailed', selected_date=date.today()))
        elif current_user.role == 'rrhh':
            return redirect(url_for('rrhh.panel'))
        else:
            return redirect(url_for('operarios.panel')) 
    
    if request.method == 'POST':
        email = request.form.get('email')
        password = request.form.get('password')
        remember = True if request.form.get('remember') == 'on' else False

        user = User.query.filter_by(email=email).first()
        
        # Nota: Asumo que usas check_password_hash porque así estaba en tu snippet
        if user and check_password_hash(user.password_hash, password):
            login_user(user, remember=remember)
            from app.utils import register_log
            register_log(
                user_id=user.id,
                category='accesos',
                action='Inicio de Sesión',
                detail=f"Login exitoso desde IP: {request.remote_addr or 'Desconocida'}"
            )
            flash("Inicio de sesión exitoso", "success")
            
            # Redirección inteligente según rol
            if user.role == 'admin':
                return redirect(url_for('admin.panel'))
            elif user.role == 'jefe_obra':
                # CAMBIO AQUÍ TAMBIÉN
                return redirect(url_for('jefe.obras_detailed', selected_date=date.today()))
            elif user.role == 'rrhh':
                return redirect(url_for('rrhh.panel'))
            else:
                return redirect(url_for('operarios.panel'))
        else:
            if user: # Solo grabamos log si el email existe pero la contraseña falló
                from app.utils import register_log
                register_log(
                    user_id=user.id,
                    category='accesos',
                    action='Intento fallido de login',
                    detail=f"Contraseña incorrecta. IP: {request.remote_addr or 'Desconocida'}"
                )
            # --------------------------------------------
            flash("Credenciales inválidas", "danger")
            
    return render_template('login.html')

@auth_bp.route('/logout')
@login_required
def logout():
    logout_user()
    flash("Sesión cerrada", "info")
    return redirect(url_for('auth.login'))

@auth_bp.route('/register', methods=['GET', 'POST'])
def register():
    if request.method == 'POST':
        name = request.form.get('name')
        lastname = request.form.get('lastname')
        dni = request.form.get('dni')
        email = request.form.get('email')
        password = request.form.get('password')
        company_code_input = request.form.get('company_code')
        
        # Verificar que el código de empresa exista
        company = Company.query.filter_by(code=company_code_input).first()
        if not company:
            flash("El código de empresa no es válido.", "danger")
            return redirect(url_for('auth.register'))
            
        new_user = User(
            email=email,
            password_hash=generate_password_hash(password),
            role=ROLE_OPERARIO,
            name=name,
            lastname=lastname,
            dni=dni,
            company_id=company.id,
            active=False
        )
        db.session.add(new_user)
        try:
            db.session.commit()
        except IntegrityError:
            db.session.rollback()
            flash("Ya existe un usuario con ese email o DNI.", "danger")
            return redirect(url_for('auth.register'))
            
        flash("Registro exitoso, espera aprobación de RRHH", "success")
        return redirect(url_for('auth.login'))
    return render_template('register.html')

===== ./templates/gestion_personal_unificado.html =====

{% extends "base.html" %}
{% block title %}Gestión de Personal{% endblock %}
{% block body_class %}layout-admin{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/admin_layout.css') }}">
{% endblock %}

{% block wrapper %}
<div class="admin-shell">
  {% include "_admin_sidebar.html" %}

  <main class="admin-main admin-main--compact">

    <div class="page-toolbar">
      <div class="page-toolbar-left">
        <h1 class="page-toolbar-title">Personal</h1>
        <span class="page-toolbar-count">{{ internos|length }} int. · {{ (operarios_activos|length) + (operarios_pendientes|length) }} ext.</span>
      </div>
      <div class="page-toolbar-actions">
        <a href="{{ url_for('admin.create_user', tab='internos') }}" class="btn-admin btn-admin-primary">
          <i class="fas fa-plus"></i> Nuevo
        </a>
        <a href="{{ url_for('admin.import_users') }}" class="btn-admin btn-admin-ghost">
          <i class="fas fa-file-import"></i> Importar
        </a>
      </div>
    </div>

    <div id="bulk-internos" class="bulk-toolbar d-none">
      <span class="bulk-toolbar-count"><span id="count-internos">0</span> seleccionados</span>
      <div class="bulk-toolbar-actions">
        <button type="button" class="btn-bulk btn-bulk-danger" onclick="bulkDeleteUsers('tableInternos', 'interno-checkbox')">
          <i class="fas fa-trash"></i> Eliminar
        </button>
      </div>
    </div>

    <div id="bulk-externos" class="bulk-toolbar d-none">
      <span class="bulk-toolbar-count"><span id="count-externos">0</span> seleccionados</span>
      <div class="bulk-toolbar-actions">
        {% if view_mode == 'admin' %}
        <button type="button" class="btn-bulk btn-bulk-warning" onclick="bulkDeactivateUsers('tableExternos', 'externo-checkbox')">
          <i class="fas fa-ban"></i> Desactivar
        </button>
        {% endif %}
        {% if current_user.role == 'admin' %}
        <button type="button" class="btn-bulk btn-bulk-danger" onclick="bulkDeleteUsers('tableExternos', 'externo-checkbox')">
          <i class="fas fa-trash"></i> Eliminar
        </button>
        {% endif %}
      </div>
    </div>

    <section class="admin-panel admin-panel-flush admin-panel--no-header">
      <ul class="nav admin-tabs-compact" id="personalTab" role="tablist">
        <li class="nav-item">
          <a class="nav-link active" id="internos-tab" data-toggle="tab" href="#internos" role="tab">
            Internos <span class="tab-count">{{ internos|length }}</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link" id="operarios-tab" data-toggle="tab" href="#operarios" role="tab">
            Externos <span class="tab-count">{{ (operarios_activos|length) + (operarios_pendientes|length) }}</span>
          </a>
        </li>
      </ul>

      <div class="tab-content">
        <div class="tab-pane fade show active" id="internos">
          <div class="admin-table-scroll">
            <table class="filterable-table admin-data-table mb-0" id="tableInternos">
              <colgroup>
                <col style="width: 3%">
                <col style="width: 21%">
                <col style="width: 22%">
                <col style="width: 9%">
                <col style="width: 17%">
                <col style="width: 9%">
                <col style="width: 9%">
                <col class="col-actions-fixed">
              </colgroup>
              <thead>
                <tr class="header-row">
                  <th class="col-check"><input type="checkbox" id="selectAllInternos" title="Seleccionar todos"></th>
                  <th class="sortable-col" data-col-index="1" data-sort="none" onclick="sortAdminTable(this)"><span class="sortable-label">Nombre</span><i class="fas fa-sort sort-icon"></i></th>
                  <th class="sortable-col" data-col-index="2" data-sort="none" onclick="sortAdminTable(this)"><span class="sortable-label">Email</span><i class="fas fa-sort sort-icon"></i></th>
                  <th class="sortable-col" data-col-index="3" data-sort="none" onclick="sortAdminTable(this)"><span class="sortable-label">Rol</span><i class="fas fa-sort sort-icon"></i></th>
                  <th class="sortable-col" data-col-index="4" data-sort="none" onclick="sortAdminTable(this)"><span class="sortable-label">Categoría</span><i class="fas fa-sort sort-icon"></i></th>
                  <th class="sortable-col" data-col-index="5" data-sort="none" data-sort-type="rating" onclick="sortAdminTable(this)"><span class="sortable-label">Valor.</span><i class="fas fa-sort sort-icon"></i></th>
                  <th class="sortable-col" data-col-index="6" data-sort="none" onclick="sortAdminTable(this)"><span class="sortable-label">Estado</span><i class="fas fa-sort sort-icon"></i></th>
                  <th class="col-actions"></th>
                </tr>
                <tr class="filter-row">
                  <th></th>
                  <th><input type="text" class="table-filter-input" onkeyup="filterTable('tableInternos', 1, this.value)" placeholder="…" title="Filtrar nombre"></th>
                  <th><input type="text" class="table-filter-input" onkeyup="filterTable('tableInternos', 2, this.value)" placeholder="…" title="Filtrar email"></th>
                  <th><input type="text" class="table-filter-input" onkeyup="filterTable('tableInternos', 3, this.value)" placeholder="…" title="Filtrar rol"></th>
                  <th><input type="text" class="table-filter-input" onkeyup="filterTable('tableInternos', 4, this.value)" placeholder="…" title="Filtrar categoría"></th>
                  <th><input type="text" class="table-filter-input" onkeyup="filterTable('tableInternos', 5, this.value)" placeholder="…" title="Filtrar valoración"></th>
                  <th><input type="text" class="table-filter-input" onkeyup="filterTable('tableInternos', 6, this.value)" placeholder="…" title="Filtrar estado"></th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {% for user in internos %}
                <tr class="data-row">
                  <td class="col-check text-center"><input type="checkbox" class="interno-checkbox" value="{{ user.id }}"></td>
                  <td data-sort-value="{{ (user.name ~ ' ' ~ user.lastname)|lower }}">
                    <a href="{{ url_for('admin.worker_panel', user_id=user.id) }}" class="table-link-primary" title="{{ user.name }} {{ user.lastname }}">{{ user.name }} {{ user.lastname }}</a>
                  </td>
                  <td data-sort-value="{{ user.email|lower }}">{{ user.email }}</td>
                  <td data-sort-value="{{ user.role|lower }}"><span class="badge-soft badge-soft-slate">{{ user.role|upper }}</span></td>
                  <td data-sort-value="{{ (user.categoria_profesional or '')|lower }} {{ (user.especialidad or '')|lower }}">
                    {% if user.categoria_profesional %}<span class="font-weight-bold">{{ user.categoria_profesional }}</span>{% endif %}
                    {% if user.especialidad %}<span class="text-muted d-block" style="font-size:0.68rem;">{{ user.especialidad }}</span>{% endif %}
                    {% if not user.categoria_profesional and not user.especialidad %}—{% endif %}
                  </td>
                  {% set active_ratings = user.ratings_received|selectattr('is_active', 'equalto', True)|list %}
                  {% set r_count = active_ratings|length %}
                  <td data-sort-tier="{{ 1 if r_count > 0 else 0 }}" data-sort-value="{{ '%08.2f'|format(user.reputation_score) if r_count > 0 else '' }}">
                    <a href="{{ url_for('admin.worker_ratings_history', user_id=user.id) }}" class="table-link-primary" title="Ver valoraciones">
                      {% if r_count > 0 %}<i class="fas fa-star text-warning" style="font-size:0.65rem;"></i> {{ user.reputation_score }} <span class="text-muted">({{ r_count }})</span>{% else %}—{% endif %}
                    </a>
                  </td>
                  <td data-sort-value="{{ 'activo' if user.active else 'inactivo' }}">
                    {% if user.active %}<span class="badge-soft badge-soft-green"><span class="status-dot green"></span> Activo</span>
                    {% else %}<span class="badge-soft badge-soft-slate"><span class="status-dot gray"></span> Inactivo</span>{% endif %}
                  </td>
                  <td class="col-actions">
                    <div class="table-actions">
                      <button type="button" class="btn-table-action reset-pwd-btn" data-userid="{{ user.id }}" data-username="{{ user.name }}" title="Contraseña"><i class="fas fa-key"></i></button>
                      <a href="{{ url_for('admin.edit_operario', user_id=user.id) }}" class="btn-table-action" title="Editar"><i class="fas fa-pencil-alt"></i></a>
                      <form action="{{ url_for('admin.delete_user', user_id=user.id) }}" method="post" style="display:inline;" onsubmit="return confirm('¿Eliminar usuario?');">
                        <button type="submit" class="btn-table-action btn-table-action--danger" title="Eliminar"><i class="fas fa-trash"></i></button>
                      </form>
                    </div>
                  </td>
                </tr>
                {% else %}
                <tr><td colspan="8" class="table-empty-state"><i class="fas fa-users"></i>Sin registros internos.</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>

        <div class="tab-pane fade" id="operarios">
          <div class="admin-table-scroll">
            <table class="filterable-table admin-data-table admin-data-table--wide-actions mb-0" id="tableExternos">
              <colgroup>
                <col style="width: 3%">
                <col style="width: 18%">
                <col style="width: 17%">
                <col style="width: 10%">
                <col style="width: 16%">
                <col style="width: 9%">
                <col style="width: 9%">
                <col class="col-actions-fixed">
              </colgroup>
              <thead>
                <tr class="header-row">
                  <th class="col-check"><input type="checkbox" id="selectAllExternos" title="Seleccionar todos"></th>
                  <th class="sortable-col" data-col-index="1" data-sort="none" onclick="sortAdminTable(this)"><span class="sortable-label">Nombre</span><i class="fas fa-sort sort-icon"></i></th>
                  <th class="sortable-col" data-col-index="2" data-sort="none" onclick="sortAdminTable(this)"><span class="sortable-label">Empresa</span><i class="fas fa-sort sort-icon"></i></th>
                  <th class="sortable-col" data-col-index="3" data-sort="none" onclick="sortAdminTable(this)"><span class="sortable-label">DNI</span><i class="fas fa-sort sort-icon"></i></th>
                  <th class="sortable-col" data-col-index="4" data-sort="none" onclick="sortAdminTable(this)"><span class="sortable-label">Categoría</span><i class="fas fa-sort sort-icon"></i></th>
                  <th class="sortable-col" data-col-index="5" data-sort="none" data-sort-type="rating" onclick="sortAdminTable(this)"><span class="sortable-label">Valor.</span><i class="fas fa-sort sort-icon"></i></th>
                  <th class="sortable-col" data-col-index="6" data-sort="none" onclick="sortAdminTable(this)"><span class="sortable-label">Estado</span><i class="fas fa-sort sort-icon"></i></th>
                  <th class="col-actions"></th>
                </tr>
                <tr class="filter-row">
                  <th></th>
                  <th><input type="text" class="table-filter-input" onkeyup="filterTable('tableExternos', 1, this.value)" placeholder="…"></th>
                  <th><input type="text" class="table-filter-input" onkeyup="filterTable('tableExternos', 2, this.value)" placeholder="…"></th>
                  <th><input type="text" class="table-filter-input" onkeyup="filterTable('tableExternos', 3, this.value)" placeholder="…"></th>
                  <th><input type="text" class="table-filter-input" onkeyup="filterTable('tableExternos', 4, this.value)" placeholder="…"></th>
                  <th><input type="text" class="table-filter-input" onkeyup="filterTable('tableExternos', 5, this.value)" placeholder="…"></th>
                  <th><input type="text" class="table-filter-input" onkeyup="filterTable('tableExternos', 6, this.value)" placeholder="…"></th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {% for user in operarios_activos + operarios_pendientes %}
                <tr class="data-row">
                  <td class="col-check text-center"><input type="checkbox" class="externo-checkbox" value="{{ user.id }}"></td>
                  <td data-sort-value="{{ (user.name ~ ' ' ~ user.lastname)|lower }}">
                    <a href="{{ url_for('admin.worker_panel', user_id=user.id) }}" class="table-link-primary">{{ user.name }} {{ user.lastname }}</a>
                  </td>
                  <td data-sort-value="{{ (user.company_rel.nombre if user.company_rel else 'sin asignar')|lower }}">
                    {% if user.company_rel %}{{ user.company_rel.nombre }}{% else %}<span class="text-danger">Sin asignar</span>{% endif %}
                  </td>
                  <td data-sort-value="{{ user.dni or '' }}">{{ user.dni or '—' }}</td>
                  <td data-sort-value="{{ (user.categoria_profesional or '')|lower }}">
                    {% if user.categoria_profesional %}{{ user.categoria_profesional }}{% endif %}
                    {% if user.especialidad %}<span class="text-muted d-block" style="font-size:0.68rem;">{{ user.especialidad }}</span>{% endif %}
                    {% if not user.categoria_profesional and not user.especialidad %}—{% endif %}
                  </td>
                  {% set active_ratings = user.ratings_received|selectattr('is_active', 'equalto', True)|list %}
                  {% set r_count = active_ratings|length %}
                  <td data-sort-tier="{{ 1 if r_count > 0 else 0 }}" data-sort-value="{{ '%08.2f'|format(user.reputation_score) if r_count > 0 else '' }}">
                    <a href="{{ url_for('admin.worker_ratings_history', user_id=user.id) }}" class="table-link-primary">
                      {% if r_count > 0 %}<i class="fas fa-star text-warning" style="font-size:0.65rem;"></i> {{ user.reputation_score }} ({{ r_count }}){% else %}—{% endif %}
                    </a>
                  </td>
                  <td data-sort-value="{{ 'activo' if user.active else 'pendiente' }}">
                    {% if user.active %}<span class="badge-soft badge-soft-green"><span class="status-dot green"></span> Activo</span>
                    {% else %}<span class="badge-soft badge-soft-amber"><span class="status-dot" style="background:#f59e0b;"></span> Pendiente</span>{% endif %}
                  </td>
                  <td class="col-actions">
                    <div class="table-actions">
                      <button type="button" class="btn-table-action reset-pwd-btn" data-userid="{{ user.id }}" data-username="{{ user.name }}" title="Contraseña"><i class="fas fa-key"></i></button>
                      <a href="{{ url_for('admin.edit_operario', user_id=user.id) }}" class="btn-table-action" title="Editar"><i class="fas fa-pencil-alt"></i></a>
                      {% if view_mode == 'admin' %}
                      <form action="{{ url_for('admin.deactivate_operario', user_id=user.id) }}" method="post" style="display:inline;">
                        <button type="submit" class="btn-table-action btn-table-action--warn" title="Desactivar"><i class="fas fa-ban"></i></button>
                      </form>
                      {% endif %}
                      <button type="button" class="btn-table-action btn-table-action--info schedule-btn" data-user-id="{{ user.id }}" data-action="deactivate" title="Programar baja"><i class="far fa-clock"></i></button>
                      {% if current_user.role == 'admin' %}
                      <form action="{{ url_for('admin.delete_user', user_id=user.id) }}" method="post" style="display:inline;" onsubmit="return confirm('¿Eliminar definitivamente?');">
                        <button type="submit" class="btn-table-action btn-table-action--danger" title="Eliminar"><i class="fas fa-trash"></i></button>
                      </form>
                      {% endif %}
                    </div>
                  </td>
                </tr>
                {% else %}
                <tr><td colspan="8" class="table-empty-state"><i class="fas fa-hard-hat"></i>Sin operarios externos.</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
  </main>
</div>

{# modals unchanged structure #}
<div class="modal fade" id="resetPasswordModal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <form id="resetPasswordForm" method="POST" action="">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Restablecer contraseña</h5>
          <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
        </div>
        <div class="modal-body">
          <p class="small mb-2">Usuario: <strong id="resetUsernameDisplay"></strong></p>
          <label class="admin-form-label">Nueva contraseña</label>
          <input type="password" name="new_password" class="form-control" required placeholder="Nueva clave…">
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-admin btn-admin-ghost" data-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn-admin btn-admin-primary">Guardar</button>
        </div>
      </div>
    </form>
  </div>
</div>

<div class="modal fade" id="scheduleModal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <form id="scheduleForm" autocomplete="off">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="scheduleModalLabel">Programar</h5>
          <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
        </div>
        <div class="modal-body">
          <label class="admin-form-label">Fecha</label>
          <input type="date" id="scheduledDate" name="scheduledDate" class="form-control" required>
          <input type="hidden" id="scheduleUserId" name="userId">
          <input type="hidden" id="scheduleAction" name="action">
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-admin btn-admin-ghost" data-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn-admin btn-admin-primary">Guardar</button>
        </div>
      </div>
    </form>
  </div>
</div>
{% endblock %}

{% block extra_js %}
<script src="{{ url_for('static', filename='js/common.js') }}"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
document.addEventListener("DOMContentLoaded", function() {
    captureAdminTableOrder('tableInternos');
    captureAdminTableOrder('tableExternos');

    initBulkSelection({ tableId: 'tableInternos', checkboxClass: '.interno-checkbox', selectAllId: 'selectAllInternos', toolbarId: 'bulk-internos', countId: 'count-internos' });
    initBulkSelection({ tableId: 'tableExternos', checkboxClass: '.externo-checkbox', selectAllId: 'selectAllExternos', toolbarId: 'bulk-externos', countId: 'count-externos' });

    $(document).on('click', '.reset-pwd-btn', function() {
        $('#resetUsernameDisplay').text($(this).data('username'));
        $('#resetPasswordForm').attr('action', '/admin/reset_password/' + $(this).data('userid'));
        $('#resetPasswordModal').modal('show');
    });

    var hash = window.location.hash;
    if (hash) {
        var targetTab = document.querySelector('.admin-tabs-compact a[href="' + hash + '"]');
        if (targetTab) $(targetTab).tab('show');
    }
});

function bulkDeleteUsers(tableId, checkboxClass) {
    var ids = getCheckedIds(tableId, '.' + checkboxClass);
    if (!ids.length) return;
    Swal.fire({
        title: '¿Eliminar seleccionados?',
        text: 'Se eliminarán ' + ids.length + ' usuario(s).',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc2626',
        cancelButtonColor: '#64748b',
        confirmButtonText: 'Sí, eliminar'
    }).then(function(r) {
        if (!r.isConfirmed) return;
        Swal.fire({ title: 'Procesando...', allowOutsideClick: false, didOpen: function() { Swal.showLoading(); }});
        bulkJsonPost('/admin/api/users/batch_delete', { user_ids: ids }).then(function(data) {
            if (data.success) Swal.fire('Hecho', data.message, 'success').then(function() { location.reload(); });
            else Swal.fire('Error', data.message, 'error');
        });
    });
}

function bulkDeactivateUsers(tableId, checkboxClass) {
    var ids = getCheckedIds(tableId, '.' + checkboxClass);
    if (!ids.length) return;
    Swal.fire({
        title: '¿Desactivar seleccionados?',
        text: 'Se desactivarán ' + ids.length + ' operario(s).',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d97706',
        confirmButtonText: 'Sí, desactivar'
    }).then(function(r) {
        if (!r.isConfirmed) return;
        bulkJsonPost('/admin/api/users/batch_deactivate', { user_ids: ids }).then(function(data) {
            if (data.success) Swal.fire('Hecho', data.message, 'success').then(function() { location.reload(); });
            else Swal.fire('Error', data.message, 'error');
        });
    });
}

$(document).on('click', '.schedule-btn', function(){
    $('#scheduleUserId').val($(this).data('user-id'));
    $('#scheduleAction').val($(this).data('action'));
    $('#scheduleModalLabel').text($(this).data('action') === 'deactivate' ? 'Programar desactivación' : 'Programar aprobación');
    $('#scheduleModal').modal('show');
});

$('#scheduleForm').submit(function(e){
    e.preventDefault();
    $.ajax({
        url: '/admin/schedule_status/' + $('#scheduleUserId').val(),
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({ action: $('#scheduleAction').val(), date: $('#scheduledDate').val() }),
        success: function(r){ if(r.success){ alert(r.message); location.reload(); } else alert('Error: ' + r.error); },
        error: function(){ alert('Error al programar.'); }
    });
});
</script>
{% endblock %}


===== ./templates/obras_detailed_unificado.html =====

{% extends "base.html" %}

{% block title %}Tablero de Planificación{% endblock %}
{% block body_class %}layout-admin{% endblock %}

{% block extra_css %}
  {# 1. IMPORTANTE: Cargar primero los estilos base de la administración #}
  <link rel="stylesheet" href="{{ url_for('static', filename='css/admin_layout.css') }}">

  <link rel="stylesheet" href="{{ url_for('static', filename='css/kanban_board.css') }}">
{% endblock %}

{% block wrapper %}
<div class="admin-shell">
  {% include "_admin_sidebar.html" %}

  <main class="admin-main kanban-layout kanban-page">

    {% include "components/_timeline_header.html" %}

    <div class="kanban-filter-bar">
      <div class="kanban-filter-label">
        <i class="fas fa-filter"></i> Filtrar obras
      </div>
      <div class="active-filters" id="activeFiltersList"></div>
      <div class="kanban-filter-input-wrap">
        <i class="fas fa-search kanban-filter-search-icon"></i>
        <input type="text" id="kanbanFilterInput" placeholder="Obra, código o operario — Enter para añadir">
      </div>
      <button type="button" class="btn-admin btn-admin-ghost kanban-filter-clear" onclick="clearKanbanFilters()" id="btnClearFilters" style="display:none;">
        Limpiar
      </button>
    </div>

    {# --- TABLERO --- #}
    <div class="kanban-container" id="kanbanContainer">
        
        {% include "components/_kanban_col_libres.html" %}

        <div class="kanban-works-wrapper" id="kanbanWorksWrapper">
            {% for item in obra_data %}
                <div class="kanban-col-wrapper filterable-obra" 
                     data-id="{{ item.obra.id }}" 
                     data-search-text="{{ item.obra.nombre | lower }} {{ item.obra.codigo | lower }} {% for w in item.workers %}{{ w.name | lower }} {{ w.lastname | lower }} {% endfor %}">
                    
                    {% include "components/_kanban_card_obra.html" %}
                
                </div>
            {% endfor %}
        </div>
    </div>

  </main>
</div>

{# --- MODALES --- #}
{% include "components/_modal_assignment.html" %}
{% include "components/_modal_request_generic.html" %}

<div class="modal fade" id="modalEditStaff" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header py-2 bg-light">
                <h6 class="modal-title font-weight-bold text-uppercase text-dark" id="modalStaffTitle">Cambiar Responsable</h6>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            {# AÑADIDO: class text-dark para asegurar legibilidad #}
            <div class="modal-body text-dark">
                <input type="hidden" id="staffObraId">
                <input type="hidden" id="staffRoleType"> 
                
                {# AÑADIDO: Mostrar nombre de la obra #}
                <div class="mb-3 p-2 bg-light border rounded text-center">
                    <small class="text-muted text-uppercase d-block mb-1" style="font-size:0.7rem;">Editando obra</small>
                    <strong class="text-primary" id="staffObraNameDisplay"></strong>
                </div>
  
                <div class="form-group mb-3">
                    <label class="small text-muted mb-1">Selecciona nuevo usuario:</label>
                    <select id="staffSelect" class="form-control form-control-sm" style="width:100%">
                    </select>
                </div>
                
                <button type="button" class="btn btn-primary btn-sm btn-block" onclick="submitStaffChange()">
                    Guardar Cambios
                </button>
            </div>
        </div>
    </div>
  </div>

<div class="modal fade entity-rating-modal" id="ratingModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title mb-0"><i class="fas fa-star mr-1"></i> Valorar a <span id="ratingWorkerName"></span></h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="ratingWorkerId">
                <p class="rating-intro text-center mb-0">Selecciona una puntuación entre -3 y +3</p>
                <div class="entity-rating-score-grid">
                    <div class="entity-rating-score-group">
                        <button type="button" class="entity-rating-btn entity-rating-btn--neg rating-btn" data-score="-3">-3</button>
                        <button type="button" class="entity-rating-btn entity-rating-btn--neg rating-btn" data-score="-2">-2</button>
                        <button type="button" class="entity-rating-btn entity-rating-btn--neg rating-btn" data-score="-1">-1</button>
                    </div>
                    <div class="entity-rating-score-group">
                        <button type="button" class="entity-rating-btn entity-rating-btn--pos rating-btn" data-score="1">+1</button>
                        <button type="button" class="entity-rating-btn entity-rating-btn--pos rating-btn" data-score="2">+2</button>
                        <button type="button" class="entity-rating-btn entity-rating-btn--pos rating-btn" data-score="3">+3</button>
                    </div>
                </div>
                <label class="form-label-sm" for="ratingReason">Motivo (opcional)</label>
                <textarea id="ratingReason" class="form-control mb-0" rows="2" placeholder="Motivo…"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-admin btn-admin-ghost" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn-admin btn-admin-primary" onclick="submitRating()">
                    <i class="fas fa-save mr-1"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalMoveToLibres" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-xl" role="document">
    <div class="modal-content">
      <div class="modal-header bg-dark text-white">
        <h5 class="modal-title">
            <i class="fas fa-calendar-times mr-2 text-danger"></i>
            Desasignar a: <span id="libresWorkerName" class="text-warning font-weight-bold"></span>
        </h5>
        <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      
      <div class="modal-body bg-light p-4">
        <div class="alert alert-info py-2 small mb-3 shadow-sm border-0" style="border-left: 4px solid #f59e0b;">
            Estás viendo la agenda de este trabajador. <strong>Haz clic en un bloque de la obra <span id="libresSourceName"></span></strong> en el calendario para acortarlo o borrarlo.
        </div>
        
        <div id="libres-calendar-container" class="univ-calendar-root" style="min-height: 480px;"></div>
        
        <input type="hidden" id="libresWorkerId">
        <input type="hidden" id="libresSourceObraId">

        <div class="mt-4 pt-3 border-top text-right">
            <div class="custom-control custom-switch d-inline-block mr-3">
                <input type="checkbox" class="custom-control-input" id="chk-libres-all">
                <label class="custom-control-label text-danger font-weight-bold" for="chk-libres-all" style="cursor:pointer;">
                    Baja Total (Desasignar de toda la obra)
                </label>
            </div>
            <button type="button" class="btn btn-primary" onclick="submitUnassignFromLibres()">Confirmar Baja Total</button>
        </div>
      </div>
    </div>
  </div>
</div>


<script>
  var LISTA_JEFES = [
      {id: "", text: "-- Sin Jefe --"},
      {% for u in jefes %}
      {id: "{{ u.id }}", text: "{{ u.name }} {{ u.lastname }}"},
      {% endfor %}
  ];
  
  var LISTA_ENCARGADOS = [
      {id: "", text: "-- Sin Encargado --"},
      {% for u in encargados %}
      {id: "{{ u.id }}", text: "{{ u.name }} {{ u.lastname }}"},
      {% endfor %}
  ];

  // Funciones rápidas para el rating (el resto está en kanban_logic.js pero esto asegura funcionamiento en modal)
  function openRatingModal(workerId, workerName) {
      $('#ratingWorkerId').val(workerId);
      $('#ratingWorkerName').text(workerName);
      $('#ratingReason').val('');
      $('.rating-btn').removeClass('active');
      $('#ratingModal').modal('show');
  }
  
  // Delegación de eventos para rating botones se mueve a kanban_logic o script global
</script>
{% endblock %} 

{% block extra_js %}
  <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>
  <script>
        // Variable global de seguridad para JS
        const CURRENT_USER_ROLE = "{{ current_user.role }}";
    </script>
  
  <script src="{{ url_for('static', filename='js/universal_calendar.js') }}"></script>
  
  
  <script src="https://cdn.jsdelivr.net/npm/dom-autoscroller@2.3.4/dist/dom-autoscroller.min.js"></script>


    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Variable global de seguridad para JS
        window.CURRENT_USER_ROLE = "{{ current_user.role }}"
    </script>
  <script src="{{ url_for('static', filename='js/kanban_logic.js') }}"></script>
  
  <script>
    $(document).on('click', '.rating-btn', function() {
        $('.rating-btn').removeClass('active');
        $(this).addClass('active');
        window.selectedRatingScore = $(this).data('score');
    });

    function submitRating() {
        if (!window.selectedRatingScore) { alert("Selecciona puntuación"); return; }
        $.ajax({
            url: "/admin/api/rate_worker",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify({ 
                worker_id: $('#ratingWorkerId').val(), 
                score: window.selectedRatingScore, 
                reason: $('#ratingReason').val() 
            }),
            success: function() { location.reload(); },
            error: function(e) { alert("Error: " + e.responseJSON.message); }
        });
    }
  </script>



{% endblock %}

===== ./templates/edit_obra.html =====

{% extends "base.html" %}
{% block title %}Editar Obra{% endblock %}
{% block body_class %}layout-admin{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/admin_layout.css') }}">
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
{% endblock %}

{% block wrapper %}
<div class="admin-shell">
  {% include "_admin_sidebar.html" %}

  <main class="admin-main admin-main--compact admin-form-page">

    <div class="page-toolbar">
      <div class="page-toolbar-left">
        <a href="{{ url_for('admin.obras_list') }}" class="btn-admin btn-admin-ghost" style="padding: 0.25rem 0.5rem;">
          <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="page-toolbar-title">Editar obra</h1>
      </div>
    </div>

    <section class="admin-panel admin-form-panel">
      <div class="admin-panel-header">
        <h2 class="admin-panel-title">{{ obra.nombre }}</h2>
        <span class="admin-panel-subtitle">{{ obra.codigo or obra.id }}</span>
      </div>

      <form method="POST" id="editObraForm">
        <div class="form-row">
          <div class="form-group col-md-3">
            <label class="admin-form-label">Código</label>
            <input type="text" name="codigo" class="form-control" value="{{ form_data.get('codigo', obra.codigo or '') }}" required>
          </div>
          <div class="form-group col-md-9">
            <label class="admin-form-label">Nombre</label>
            <input type="text" name="nombre" class="form-control" value="{{ form_data.get('nombre', obra.nombre) }}" required>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group col-md-6">
            <label class="admin-form-label">Descripción</label>
            <textarea name="descripcion" class="form-control" rows="2" required>{{ form_data.get('descripcion', obra.descripcion) }}</textarea>
          </div>
          <div class="form-group col-md-6">
            <label class="admin-form-label">Ubicación</label>
            <input type="text" name="ubicacion" class="form-control" value="{{ form_data.get('ubicacion', obra.ubicacion) }}">
          </div>
        </div>

        <div class="form-group">
          <label class="admin-form-label"><i class="fas fa-hard-hat text-warning mr-1"></i> Plataforma PRL</label>
          <input type="url" name="url_prl" class="form-control" value="{{ form_data.get('url_prl', obra.url_prl or '') }}" placeholder="https://…">
        </div>

        <div class="admin-form-section">Planificación</div>
        <div class="form-row">
          <div class="form-group col-md-6">
            <label class="admin-form-label">Fecha inicio</label>
            <input type="date" name="fecha_inicio" class="form-control" value="{{ form_data.get('fecha_inicio', obra.fecha_inicio) }}">
          </div>
          <div class="form-group col-md-6">
            <label class="admin-form-label">Fecha fin</label>
            <input type="date" name="fecha_fin" class="form-control" value="{{ form_data.get('fecha_fin', obra.fecha_fin) }}">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group col-md-4">
            <label class="admin-form-label">Estado</label>
            <select name="estado" id="estadoSelect" class="form-control custom-select">
              {% set current_est = form_data.get('estado', obra.estado) %}
              <option value="Pendiente" {% if current_est == 'Pendiente' %}selected{% endif %}>Pendiente</option>
              <option value="En Curso" {% if current_est == 'En Curso' %}selected{% endif %}>En Curso</option>
              <option value="Finalizada" {% if current_est == 'Finalizada' %}selected{% endif %}>Finalizada</option>
            </select>
          </div>
          <div class="form-group col-md-4">
            <label class="admin-form-label">Límite trabajadores</label>
            <input type="number" name="limite_trabajadores" class="form-control" value="{{ form_data.get('limite_trabajadores', obra.limite_trabajadores) }}" required>
          </div>
          <div class="form-group col-md-4">
            <label class="admin-form-label">Color</label>
            <input type="color" name="color" class="form-control form-control-color w-100" style="height: 32px; padding: 2px;" value="{{ form_data.get('color', obra.color) }}">
          </div>
        </div>

        <div class="admin-form-section">Responsables</div>
        <div class="form-row">
          <div class="form-group col-md-6">
            <label class="admin-form-label">Jefe de obra</label>
            <select name="jefe_obra_id" id="jefe_select" class="form-control">
              <option value="">— Sin asignar —</option>
              {% for jefe in jefes %}
                {% set sel_id = form_data.get('jefe_obra_id', obra.jefe_obra_id)|string %}
                <option value="{{ jefe.id }}" {% if sel_id == jefe.id|string %}selected{% endif %}>
                  {{ jefe.name }} {{ jefe.lastname }}
                </option>
              {% endfor %}
            </select>
          </div>
          <div class="form-group col-md-6">
            <label class="admin-form-label">Encargado</label>
            <select name="encargado_id" id="encargado_select" class="form-control">
              <option value="">— Sin encargado —</option>
              {% for enc in encargados %}
                {% set sel_enc_id = form_data.get('encargado_id', obra.encargado_id)|string %}
                <option value="{{ enc.id }}" {% if sel_enc_id == enc.id|string %}selected{% endif %}>
                  {{ enc.name }} {{ enc.lastname }}
                </option>
              {% endfor %}
            </select>
          </div>
        </div>

        <div class="admin-form-actions">
          {% if current_user.role == 'admin' %}
            <button type="button" class="btn-admin-danger" onclick="if(confirm('¿Seguro que quieres eliminar esta obra?')){ document.getElementById('deleteForm').submit(); }">
              <i class="fas fa-trash-alt"></i> Eliminar
            </button>
          {% else %}
            <div></div>
          {% endif %}
          <div class="admin-form-actions-right">
            <a href="{{ url_for('admin.obras_list') }}" class="btn-admin-link">Cancelar</a>
            <button type="submit" class="btn-admin btn-admin-primary">
              <i class="fas fa-save"></i> Guardar
            </button>
          </div>
        </div>
      </form>

      {% if current_user.role == 'admin' %}
        <form id="deleteForm" method="POST" action="{{ url_for('admin.delete_obra', obra_id=obra.id) }}" style="display:none;"></form>
      {% endif %}
    </section>
  </main>
</div>
{% endblock %}

{% block extra_js %}
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script>
  $(document).ready(function() {
      $('#jefe_select').select2({ width: '100%', placeholder: "Seleccione un jefe", allowClear: true });
      $('#encargado_select').select2({ width: '100%', placeholder: "Seleccione un encargado", allowClear: true });
  });

  document.addEventListener("DOMContentLoaded", function() {
    const form = document.getElementById("editObraForm");
    const estadoSelect = document.getElementById("estadoSelect");
    const originalEstado = "{{ obra.estado }}";
    const obraId = {{ obra.id }};

    if (form) {
        form.addEventListener("submit", function(e) {
            const newEstado = estadoSelect.value;
            if (newEstado === "Pendiente" && originalEstado !== "Pendiente") {
                e.preventDefault();
                fetch("/admin/api/check_obra_status_impact", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ obra_id: obraId })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success && data.total_days > 0) {
                        const msg = `Al poner la obra en PENDIENTE se desasignarán ${data.unique_workers} operarios y se eliminarán ${data.total_days} días.\n\n¿Continuar?`;
                        if (confirm(msg)) form.submit();
                    } else { form.submit(); }
                })
                .catch(() => form.submit());
            }
        });
    }
  });
</script>
{% endblock %}


===== ./templates/admin_configuracion.html =====

{% extends "base.html" %}
{% block title %}Configuración Global{% endblock %}
{% block body_class %}layout-admin{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/admin_layout.css') }}">
{% endblock %}

{% block wrapper %}
<div class="admin-shell">
  {% include "_admin_sidebar.html" %}

  <main class="admin-main admin-main--compact config-page">

    <div class="page-toolbar">
      <div class="page-toolbar-left">
        <h1 class="page-toolbar-title">Configuración global</h1>
        <span class="page-toolbar-count">Sistema · planificación · avisos</span>
      </div>
    </div>

    <div class="config-layout">

      {# —— Operación diaria —— #}
      <section class="config-block">
        <header class="config-block-head">
          <div class="config-block-icon config-block-icon--blue"><i class="fas fa-clock"></i></div>
          <div>
            <h2>Operación diaria</h2>
            <p>Zona horaria, cortes de ausencias y reglas de asignación</p>
          </div>
        </header>
        <div class="config-block-body">
          <form action="{{ url_for('admin.update_config') }}" method="POST">
            <div class="config-fields-grid">
              <div class="config-field">
                <label for="zona_horaria">Zona horaria</label>
                <select id="zona_horaria" name="zona_horaria" class="form-control form-control-sm custom-select">
                  {% for tz_code, tz_label in timezone_options %}
                  <option value="{{ tz_code }}" {% if configs.get('zona_horaria', 'Europe/Madrid') == tz_code %}selected{% endif %}>{{ tz_label }}</option>
                  {% endfor %}
                </select>
                <p class="config-field-hint">Fichajes, Odoo y tareas programadas</p>
              </div>
              <div class="config-field">
                <label for="hora_limite_entrada">Hora límite de entrada</label>
                <input type="time" id="hora_limite_entrada" name="hora_limite_entrada" class="form-control form-control-sm font-weight-bold" value="{{ configs.get('hora_limite_entrada', '08:30') }}" required>
                <p class="config-field-hint">Corte de ausencias y resumen diario</p>
              </div>
              <div class="config-field">
                <label for="limite_custodia">Custodia jefe de obra</label>
                <div class="d-flex align-items-center" style="gap:0.35rem;">
                  <input type="number" id="limite_custodia" name="limite_custodia" class="form-control form-control-sm text-center font-weight-bold" value="{{ limite_custodia }}" min="0" required style="max-width:5rem;">
                  <span class="text-muted small">días</span>
                </div>
                <p class="config-field-hint">Derecho sobre operario tras su último día en obra</p>
              </div>
            </div>

            <div class="config-switch-box">
              <label class="admin-form-switch">
                <input type="checkbox" id="aceptar_primer_fichaje" name="aceptar_primer_fichaje"
                       {% if configs.get('aceptar_primer_fichaje', 'True') == 'True' %}checked{% endif %}>
                <span class="slider"></span>
              </label>
              <div>
                <p class="admin-form-switch-label mb-0">Aceptar automáticamente el primer fichaje</p>
                <p class="admin-form-switch-hint mb-0">Desactivado → operarios nuevos sin planificar saltan como paracaidistas.</p>
              </div>
            </div>

            <div class="config-block-actions">
              <button type="submit" class="btn-admin btn-admin-primary"><i class="fas fa-save"></i> Guardar operación</button>
            </div>
          </form>
        </div>
      </section>

      {# —— Festivos —— #}
      <section class="config-block">
        <header class="config-block-head">
          <div class="config-block-icon config-block-icon--red"><i class="fas fa-calendar-times"></i></div>
          <div>
            <h2>Calendario laboral</h2>
            <p>Días inhábiles excluidos de la auditoría de ausencias</p>
          </div>
        </header>
        <div class="config-block-body">
          <form action="{{ url_for('admin.add_festivo') }}" method="POST" class="config-festivo-form">
            <div class="config-field">
              <label for="festivo-fecha">Fecha</label>
              <input type="date" id="festivo-fecha" name="fecha" class="form-control form-control-sm" required>
            </div>
            <div class="config-field">
              <label for="festivo-desc">Descripción</label>
              <input type="text" id="festivo-desc" name="descripcion" class="form-control form-control-sm" placeholder="Ej. Festivo local">
            </div>
            <button type="submit" class="btn-admin btn-admin-primary"><i class="fas fa-plus"></i> Añadir</button>
          </form>

          <div class="config-festivos-table-wrap">
            <table class="filterable-table admin-data-table mb-0">
              <thead>
                <tr class="header-row">
                  <th style="width:28%;">Día</th>
                  <th>Descripción</th>
                  <th class="text-right" style="width:3.5rem;"></th>
                </tr>
              </thead>
              <tbody>
                {% for f in festivos %}
                <tr>
                  <td class="font-weight-bold">{{ f.fecha.strftime('%d/%m/%Y') }}</td>
                  <td>{{ f.descripcion }}</td>
                  <td class="text-right">
                    <a href="{{ url_for('admin.delete_festivo', id=f.id) }}" class="btn-table-action btn-table-action--danger"
                       onclick="return confirm('¿Eliminar este festivo?');" title="Eliminar">
                      <i class="fas fa-trash-alt"></i>
                    </a>
                  </td>
                </tr>
                {% else %}
                <tr>
                  <td colspan="3" class="table-empty-state" style="padding:1.25rem;">
                    <i class="fas fa-calendar-day"></i>
                    Sin festivos configurados
                  </td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      {# —— Emails —— #}
      <section class="config-block">
        <header class="config-block-head">
          <div class="config-block-icon config-block-icon--green"><i class="fas fa-envelope-open-text"></i></div>
          <div>
            <h2>Notificaciones por correo</h2>
            <p>Quién recibe cada aviso automático del sistema</p>
          </div>
        </header>
        <div class="config-block-body">
          <form action="{{ url_for('admin.update_config') }}" method="POST">
            <div class="config-email-groups">

              <div>
                <p class="config-email-group-title">Solicitudes de personal</p>
                <div class="config-email-table">
                  <table class="filterable-table admin-data-table mb-0">
                    <thead>
                      <tr class="header-row">
                        <th style="width:42%;">Evento</th>
                        <th>Admin</th>
                        <th>Jefe obra</th>
                        <th>Trabajador</th>
                      </tr>
                    </thead>
                    <tbody>
                      {% for clave, nombre in [
                        ('email_sol_generica', 'Nueva solicitud genérica'),
                        ('email_sol_concreta', 'Nueva solicitud concreta'),
                        ('email_sol_resuelta', 'Solicitud resuelta')
                      ] %}
                      <tr>
                        <td class="font-weight-bold">{{ nombre }}</td>
                        <td><input type="checkbox" id="{{ clave }}_admin" name="{{ clave }}" value="admin" {% if configs.get(clave) and 'admin' in configs[clave] %}checked{% endif %}></td>
                        <td><input type="checkbox" id="{{ clave }}_jefe" name="{{ clave }}" value="jefe" {% if configs.get(clave) and 'jefe' in configs[clave] %}checked{% endif %}></td>
                        <td>
                          {% if clave == 'email_sol_generica' %}<span class="text-muted">—</span>
                          {% else %}<input type="checkbox" id="{{ clave }}_trabajador" name="{{ clave }}" value="trabajador" {% if configs.get(clave) and 'trabajador' in configs[clave] %}checked{% endif %}>{% endif %}
                        </td>
                      </tr>
                      {% endfor %}
                    </tbody>
                  </table>
                </div>
              </div>

              <div>
                <p class="config-email-group-title">Planificación y movimientos</p>
                <div class="config-email-table">
                  <table class="filterable-table admin-data-table mb-0">
                    <thead>
                      <tr class="header-row">
                        <th style="width:42%;">Evento</th>
                        <th>Admin</th>
                        <th>Jefe obra</th>
                        <th>Trabajador</th>
                      </tr>
                    </thead>
                    <tbody>
                      {% for clave, nombre in [
                        ('email_asignacion', 'Nueva asignación'),
                        ('email_desasignacion', 'Desasignación'),
                        ('email_traslado', 'Traslado interno')
                      ] %}
                      <tr>
                        <td class="font-weight-bold">{{ nombre }}</td>
                        <td><input type="checkbox" id="{{ clave }}_admin" name="{{ clave }}" value="admin" {% if configs.get(clave) and 'admin' in configs[clave] %}checked{% endif %}></td>
                        <td><input type="checkbox" id="{{ clave }}_jefe" name="{{ clave }}" value="jefe" {% if configs.get(clave) and 'jefe' in configs[clave] %}checked{% endif %}></td>
                        <td><input type="checkbox" id="{{ clave }}_trabajador" name="{{ clave }}" value="trabajador" {% if configs.get(clave) and 'trabajador' in configs[clave] %}checked{% endif %}></td>
                      </tr>
                      {% endfor %}
                    </tbody>
                  </table>
                </div>
              </div>

            </div>

            <div class="config-block-actions">
              <button type="submit" class="btn-admin btn-admin-primary"><i class="fas fa-save"></i> Guardar correos</button>
            </div>
          </form>
        </div>
      </section>

    </div>
  </main>
</div>
{% endblock %}


===== ./templates/import_obras.html =====

{% extends "base.html" %}
{% block title %}Importar Obras{% endblock %}
{% block body_class %}layout-admin{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/admin_layout.css') }}">
{% endblock %}

{% block wrapper %}
<div class="admin-shell">
  {% include "_admin_sidebar.html" %}

  <main class="admin-main">
    <div class="row justify-content-center">
      <div class="col-lg-6">
        
        <div class="d-flex align-items-center mb-4">
            <a href="{{ url_for('admin.obras_list') }}" class="btn btn-sm btn-link text-muted pl-0">
                <i class="fas fa-arrow-left"></i> Volver al listado
            </a>
        </div>

        <div class="admin-panel">
            <div class="admin-panel-header border-bottom pb-3 mb-4">
                <h2 class="admin-panel-title" style="font-size: 1.1rem;">Importación Masiva de Obras</h2>
                <p class="admin-panel-subtitle mb-0">
                    Carga un archivo Excel (.xlsx) para crear múltiples obras de una vez.
                </p>
            </div>

            <div class="alert alert-info mb-4" style="font-size: 0.9rem;">
                <i class="fas fa-info-circle mr-2"></i>
                <strong>Columnas requeridas:</strong> Código, Nombre, Cliente, Dirección, Fecha de inicio.
                <br>
                <small class="ml-4">Opcional: Fecha de fin.</small>
            </div>

            <form action="{{ url_for('admin.import_obras') }}" method="post" enctype="multipart/form-data">
                
                <div class="form-group text-center p-5 border rounded bg-light mb-4" style="border-style: dashed !important; border-color: #cbd5e1 !important;">
                    <i class="fas fa-file-excel fa-3x text-success mb-3"></i>
                    <br>
                    
                    <div class="custom-file" style="max-width: 300px; margin: 0 auto;">
                        <input type="file" class="custom-file-input" id="file" name="file" accept=".xlsx" required onchange="updateFileName(this)">
                        <label class="custom-file-label text-left" for="file" id="file-label">Seleccionar archivo...</label>
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <a href="{{ url_for('admin.obras_list') }}" class="btn btn-link text-muted mr-2">Cancelar</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-upload mr-2"></i> Subir e Importar
                    </button>
                </div>
            </form>
        </div>

      </div>
    </div>
  </main>
</div>

<script>
    function updateFileName(input) {
        var fileName = input.files[0].name;
        var label = document.getElementById('file-label');
        label.innerText = fileName;
    }
</script>
{% endblock %}

===== ./templates/jefe_panel.html =====

{% extends "base.html" %}
{% block title %}Mi panel{% endblock %}
{% block body_class %}layout-admin{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/admin_layout.css') }}">
<link rel="stylesheet" href="{{ url_for('static', filename='css/person_day_timeline.css') }}">
{% endblock %}

{% block wrapper %}
<div class="admin-shell">
  {% include "_admin_sidebar.html" %}

  <main class="admin-main admin-main--compact dashboard-page">

    <div class="page-toolbar">
      <div class="page-toolbar-left">
        <h1 class="page-toolbar-title">Mi panel</h1>
        <span class="page-toolbar-count">{{ today.strftime('%d/%m/%Y') }}</span>
      </div>
      <div class="page-toolbar-actions">
        <a href="{{ url_for('jefe.obras_detailed', selected_date=today.strftime('%Y-%m-%d')) }}" class="btn-admin btn-admin-primary">
          <i class="fas fa-th-large"></i> Tablero
        </a>
        <a href="{{ url_for('admin.solicitudes_list') }}" class="btn-admin btn-admin-ghost">
          <i class="fas fa-user-plus"></i> Solicitudes
          {% if solicitudes_abiertas %}<span class="badge-soft badge-soft-amber ml-1">{{ solicitudes_abiertas }}</span>{% endif %}
        </a>
        <a href="{{ url_for('sync.auditoria_fichajes') }}" class="btn-admin btn-admin-ghost">
          <i class="fas fa-user-clock"></i> Auditoría
          {% if audit_pendientes_total %}<span class="badge-soft badge-soft-red ml-1">{{ audit_pendientes_total }}</span>{% endif %}
        </a>
      </div>
    </div>

    <section class="dashboard-kpi-grid" style="grid-template-columns: repeat(5, minmax(0, 1fr));">
      <article class="dashboard-kpi dashboard-kpi--primary">
        <div class="dashboard-kpi-icon"><i class="fas fa-building"></i></div>
        <div>
          <span class="dashboard-kpi-label">Mis obras en curso</span>
          <span class="dashboard-kpi-value">{{ obras_en_curso }}</span>
          <span class="dashboard-kpi-meta">{{ total_obras }} asignadas en total</span>
        </div>
      </article>
      <article class="dashboard-kpi">
        <div class="dashboard-kpi-icon dashboard-kpi-icon--blue"><i class="fas fa-users"></i></div>
        <div>
          <span class="dashboard-kpi-label">Personal hoy</span>
          <span class="dashboard-kpi-value">{{ planificados_hoy }}</span>
          <span class="dashboard-kpi-meta">{{ asignaciones_hoy }} asignaciones en mis obras</span>
        </div>
      </article>
      <article class="dashboard-kpi">
        <div class="dashboard-kpi-icon dashboard-kpi-icon--amber"><i class="fas fa-clipboard-list"></i></div>
        <div>
          <span class="dashboard-kpi-label">Solicitudes abiertas</span>
          <span class="dashboard-kpi-value">{{ solicitudes_abiertas }}</span>
          <span class="dashboard-kpi-meta">{{ solicitudes_por_estado.get('PENDIENTE', 0) }} pendientes · {{ solicitudes_por_estado.get('EN_PROCESO', 0) }} en proceso</span>
        </div>
      </article>
      <article class="dashboard-kpi {% if audit_pendientes_total %}dashboard-kpi--alert{% endif %}">
        <div class="dashboard-kpi-icon dashboard-kpi-icon--red"><i class="fas fa-exclamation-triangle"></i></div>
        <div>
          <span class="dashboard-kpi-label">Auditoría pendiente</span>
          <span class="dashboard-kpi-value">{{ audit_pendientes_total }}</span>
          <span class="dashboard-kpi-meta">{{ audit_conflictos }} desv. · {{ audit_paracaidistas }} sin plan. · {{ audit_ausencias }} aus.</span>
        </div>
      </article>
      <article class="dashboard-kpi">
        <div class="dashboard-kpi-icon dashboard-kpi-icon--green"><i class="fas fa-fingerprint"></i></div>
        <div>
          <span class="dashboard-kpi-label">Fichajes hoy</span>
          <span class="dashboard-kpi-value">{{ fichajes_total_hoy }}</span>
          <span class="dashboard-kpi-meta">{{ fichajes_ok_hoy }} OK{% if fichajes_incidente_hoy %} · <span class="text-danger">{{ fichajes_incidente_hoy }} incidencias</span>{% endif %}</span>
        </div>
      </article>
    </section>

    <div class="dashboard-main-grid">
      <section class="admin-panel dashboard-panel">
        <div class="dashboard-panel-head">
          <h2 class="admin-panel-title">Planificación · 14 días</h2>
          <span class="admin-panel-subtitle">Asignaciones en mis obras</span>
        </div>
        <div class="dashboard-chart-wrap">
          <canvas id="chartPlanificacion" height="120"></canvas>
        </div>
      </section>

      <section class="admin-panel dashboard-panel">
        <div class="dashboard-panel-head">
          <h2 class="admin-panel-title">Solicitudes por estado</h2>
        </div>
        <div class="dashboard-chart-row">
          <div class="dashboard-chart-donut">
            <canvas id="chartSolicitudes" height="140"></canvas>
          </div>
          <ul class="dashboard-legend">
            {% for est, cnt in solicitudes_por_estado.items() %}
            <li>
              <span class="dashboard-legend-dot dashboard-legend-dot--{{ est|lower }}"></span>
              <span>{{ est|replace('_', ' ')|title }}</span>
              <strong>{{ cnt }}</strong>
            </li>
            {% else %}
            <li class="text-muted small">Sin solicitudes en tus obras</li>
            {% endfor %}
          </ul>
        </div>
      </section>

      <section class="admin-panel dashboard-panel">
        <div class="dashboard-panel-head">
          <h2 class="admin-panel-title">Mis obras en curso</h2>
        </div>
        {% if recent_obras %}
        <ul class="dashboard-activity-list" style="margin-top:0.25rem;">
          {% for obra in recent_obras %}
          <li>
            <span class="cell-code">{{ obra.codigo or obra.id }}</span>
            <span class="dashboard-activity-body">
              <strong>{{ obra.nombre|truncate(36) }}</strong>
              <span class="text-muted">— {{ obra.ubicacion or 'Sin ubicación' }}</span>
            </span>
            <a href="{{ url_for('jefe.obras_detailed', selected_date=today.strftime('%Y-%m-%d')) }}" class="btn-admin btn-admin-ghost" style="font-size:0.62rem;padding:0.15rem 0.4rem;">Gestionar</a>
          </li>
          {% endfor %}
        </ul>
        {% else %}
        <p class="text-muted small mb-0">No tienes obras en curso asignadas.</p>
        {% endif %}
      </section>
    </div>

    <div class="dashboard-tables-grid">
      <section class="admin-panel admin-panel-flush dashboard-panel">
        <div class="dashboard-panel-head dashboard-panel-head--padded">
          <h2 class="admin-panel-title"><i class="fas fa-user-plus text-primary mr-1"></i> Solicitudes recientes</h2>
          <a href="{{ url_for('admin.solicitudes_list') }}" class="btn-admin btn-admin-ghost" style="font-size:0.68rem;padding:0.2rem 0.5rem;">Ver todas</a>
        </div>
        {% if recent_solicitudes %}
        <table class="filterable-table admin-data-table mb-0 dashboard-table">
          <thead>
            <tr class="header-row">
              <th>#</th>
              <th>Obra</th>
              <th>Tipo</th>
              <th>Periodo</th>
              <th>Estado</th>
            </tr>
          </thead>
          <tbody>
            {% for s in recent_solicitudes %}
            <tr class="row-clickable" data-href="{{ url_for('admin.solicitud_detail', solicitud_id=s.id) }}">
              <td class="text-muted">#{{ s.id }}</td>
              <td>
                {% if s.obra %}
                <span class="cell-code">{{ s.obra.codigo or s.obra.id }}</span>
                <span class="text-muted" style="font-size:0.68rem;">{{ s.obra.nombre|truncate(28) }}</span>
                {% else %}—{% endif %}
              </td>
              <td>
                {% if s.tipo|lower == 'generica' %}<span class="badge-soft badge-soft-gray">Genérica</span>
                {% else %}<span class="badge-soft badge-soft-blue">Concreta</span>{% endif %}
              </td>
              <td class="text-nowrap" style="font-size:0.72rem;">
                {{ s.fecha_inicio.strftime('%d/%m') }}–{{ s.fecha_fin.strftime('%d/%m/%y') }}
              </td>
              <td>
                {% set est = s.estado %}
                {% if est == 'PENDIENTE' %}<span class="badge-soft badge-soft-amber">Pendiente</span>
                {% elif est == 'EN_PROCESO' %}<span class="badge-soft badge-soft-blue">En proceso</span>
                {% elif est == 'CUMPLIDA' %}<span class="badge-soft badge-soft-green">Cumplida</span>
                {% elif est == 'CERRADA_PARCIAL' %}<span class="badge-soft badge-soft-gray">Cerrada P.</span>
                {% elif est == 'DENEGADA' %}<span class="badge-soft badge-soft-red">Denegada</span>
                {% else %}<span class="badge-soft badge-soft-gray">{{ est }}</span>{% endif %}
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
        {% else %}
        <p class="table-empty-state"><i class="fas fa-inbox"></i>Sin solicitudes en tus obras</p>
        {% endif %}
      </section>

      <section class="admin-panel admin-panel-flush dashboard-panel">
        <div class="dashboard-panel-head dashboard-panel-head--padded">
          <h2 class="admin-panel-title"><i class="fas fa-users text-primary mr-1"></i> Personal por obra hoy</h2>
          <a href="{{ url_for('jefe.obras_detailed', selected_date=today.strftime('%Y-%m-%d')) }}" class="btn-admin btn-admin-ghost" style="font-size:0.68rem;padding:0.2rem 0.5rem;">Tablero</a>
        </div>
        {% if obras_hoy_rows %}
        <table class="filterable-table admin-data-table mb-0 dashboard-table">
          <thead>
            <tr class="header-row">
              <th>Obra</th>
              <th class="text-center">Hoy</th>
            </tr>
          </thead>
          <tbody>
            {% for obra, count in obras_hoy_rows %}
            <tr class="row-clickable" data-href="{{ url_for('jefe.obras_detailed', selected_date=today.strftime('%Y-%m-%d')) }}">
              <td>
                <span class="cell-code">{{ obra.codigo or obra.id }}</span>
                {{ obra.nombre|truncate(32) }}
              </td>
              <td class="text-center"><span class="badge-soft badge-soft-blue">{{ count }}</span></td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
        {% else %}
        <p class="table-empty-state"><i class="fas fa-calendar-day"></i>Sin asignaciones hoy en tus obras</p>
        {% endif %}
      </section>
    </div>

    <div class="dashboard-bottom-grid">
      <section class="admin-panel admin-panel-flush dashboard-panel">
        <div class="dashboard-panel-head dashboard-panel-head--padded">
          <h2 class="admin-panel-title"><i class="fas fa-user-clock text-danger mr-1"></i> Incidencias de fichaje</h2>
          <a href="{{ url_for('sync.auditoria_fichajes') }}" class="btn-admin btn-admin-ghost" style="font-size:0.68rem;padding:0.2rem 0.5rem;">Ir a auditoría</a>
        </div>
        {% include 'components/_dashboard_incidencias.html' %}
      </section>

      <section class="admin-panel dashboard-panel">
        <div class="dashboard-panel-head">
          <h2 class="admin-panel-title"><i class="fas fa-history mr-1"></i> Actividad reciente</h2>
        </div>
        {% if recent_logs %}
        <ul class="dashboard-activity-list">
          {% for log in recent_logs %}
          <li>
            <span class="dashboard-activity-time">{{ log.timestamp|format_dt }}</span>
            <span class="dashboard-activity-body">
              <strong>{{ log.action }}</strong>
              <span class="text-muted">— {{ (log.detail or '')|truncate(80) }}</span>
            </span>
            {% if log.user %}
            <span class="badge-soft badge-soft-gray">{{ log.user.name }}</span>
            {% endif %}
          </li>
          {% endfor %}
        </ul>
        {% else %}
        <p class="text-muted small mb-0">Sin actividad reciente.</p>
        {% endif %}
      </section>
    </div>

  </main>
</div>

{% with modal_id='modalTimelineFichaje', modal_title='Historial del Fichaje' %}
  {% include 'components/_person_day_timeline_modal.html' %}
{% endwith %}
{% endblock %}

{% block extra_js %}
<script src="{{ url_for('static', filename='js/person_day_timeline.js') }}"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
function dashboardResolverFichaje(id, accion) {
  const row = document.getElementById('row-' + id);
  if (row) {
    row.style.transition = 'all 0.3s ease';
    row.style.opacity = '0.3';
    row.style.pointerEvents = 'none';
  }
  fetch("{{ url_for('sync.resolver_fichaje') }}", {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ registro_id: id, accion: accion }),
  })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (data.success) {
        setTimeout(function() {
          if (row) row.remove();
          const restantes = document.querySelectorAll('.dashboard-incidencia-row');
          if (!restantes.length) window.location.reload();
        }, 300);
      } else {
        alert('Error: ' + data.error);
        if (row) {
          row.style.opacity = '1';
          row.style.pointerEvents = 'auto';
        }
      }
    })
    .catch(function() {
      if (row) {
        row.style.opacity = '1';
        row.style.pointerEvents = 'auto';
      }
    });
}

document.addEventListener('DOMContentLoaded', function() {
  if (typeof PersonDayTimeline !== 'undefined') {
    PersonDayTimeline.bindRowClick('.fila-fichaje-auditoria', {
      modalId: 'modalTimelineFichaje',
      apiBase: '/sync/timeline_dia',
      loadingMessage: 'Recopilando el día completo del operario...',
    });
  }

  document.querySelectorAll('tr.row-clickable[data-href]').forEach(function(row) {
    row.addEventListener('click', function(e) {
      if (e.target.closest('a, button, input, .no-row-nav')) return;
      window.location.href = row.dataset.href;
    });
  });

  const planLabels = {{ chart_plan_labels|tojson }};
  const planValues = {{ chart_plan_values|tojson }};
  const solLabels = {{ chart_solicitud_labels|tojson }};
  const solValues = {{ chart_solicitud_values|tojson }};

  const chartColors = {
    primary: '#22c55e',
    primaryLight: 'rgba(34, 197, 94, 0.15)',
    slate: '#94a3b8',
    blue: '#3b82f6',
    amber: '#f59e0b',
    red: '#ef4444',
    green: '#22c55e',
    gray: '#9ca3af',
  };

  const planCtx = document.getElementById('chartPlanificacion');
  if (planCtx && typeof Chart !== 'undefined') {
    new Chart(planCtx, {
      type: 'bar',
      data: {
        labels: planLabels,
        datasets: [{
          label: 'Asignaciones',
          data: planValues,
          backgroundColor: chartColors.primaryLight,
          borderColor: chartColors.primary,
          borderWidth: 1.5,
          borderRadius: 4,
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          x: { grid: { display: false }, ticks: { font: { size: 10 } } },
          y: { beginAtZero: true, ticks: { stepSize: 1, font: { size: 10 } } }
        }
      }
    });
  }

  const solCtx = document.getElementById('chartSolicitudes');
  if (solCtx && typeof Chart !== 'undefined' && solValues.length) {
    const estadoColors = {
      'PENDIENTE': chartColors.amber,
      'EN_PROCESO': chartColors.blue,
      'CUMPLIDA': chartColors.green,
      'CERRADA_PARCIAL': chartColors.gray,
      'DENEGADA': chartColors.red,
    };
    new Chart(solCtx, {
      type: 'doughnut',
      data: {
        labels: solLabels,
        datasets: [{
          data: solValues,
          backgroundColor: solLabels.map(function(l) { return estadoColors[l] || chartColors.slate; }),
          borderWidth: 0,
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '68%',
        plugins: { legend: { display: false } }
      }
    });
  }
});
</script>
{% endblock %}


