                </div>
                <div class="d-flex flex-column gap-2">
                    <a href="{{ url_for('admin.create_user') }}" class="btn btn-outline-secondary text-left">
                        <i class="fas fa-user-plus mr-2"></i> Dar de alta nuevo empleado
                    </a>
                    <a href="{{ url_for('admin.import_users') }}" class="btn btn-outline-secondary text-left">
                        <i class="fas fa-file-upload mr-2"></i> Importar Excel de empleados
                    </a>
                </div>
            </div>
        </div>
    </section>

  </main>
</div>
{% endblock %}

