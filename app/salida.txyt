<div class="modal fade" id="requestGenericModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="fas fa-hard-hat mr-2"></i>Solicitar Personal: 
                    <span id="reqObraLinkPlaceholder"></span>
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            
            <div class="modal-body">
                <div class="alert alert-info py-2 small mb-2 shadow-sm border-info">
                    <i class="fas fa-mouse-pointer mr-1"></i>
                    <strong>Instrucciones:</strong> Selecciona días o arrastra rangos en el calendario para añadir peticiones a la lista inferior.
