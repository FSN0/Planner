/* ==========================================================================
   Fichas de entidad — Obra / Empleado / Empresa
   ========================================================================== */

.entity-panel-page {
  --entity-accent: #22c55e;
  --entity-accent-soft: #f0fdf4;
  --entity-accent-border: #bbf7d0;
  --entity-accent-text: #166534;
  gap: 1.25rem !important;
}

.entity-panel-page--worker {
