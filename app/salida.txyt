@main_bp.route('/preferencias/zona-horaria', methods=['POST'])
@login_required
def update_user_timezone():
    tz = (request.form.get('timezone') or '').strip()
    if not tz or not is_valid_timezone(tz):
        flash('Zona horaria no válida.', 'danger')
