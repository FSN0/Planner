            </div>
        </div>
    </div>
</div>

===== ./templates/components/_dashboard_incidencias.html =====

{# Tabla de incidencias de fichaje con fila clicable (timeline) y acciones al hover #}
{% if auditoria_alertas %}
<table class="filterable-table admin-data-table mb-0 dashboard-table dashboard-incidencias-table">
  <thead>
    <tr class="header-row">
      <th>Fecha</th>
      <th>Operario</th>
      <th>Estado</th>
      <th>Detalle</th>
      <th class="text-right" style="width:9rem;">Acciones</th>
    </tr>
  </thead>
  <tbody>
    {% for reg in auditoria_alertas %}
    <tr id="row-{{ reg.id }}"
        class="fila-fichaje-auditoria dashboard-incidencia-row"
        data-user-id="{{ reg.user_id }}"
        data-fecha="{{ reg.fecha.strftime('%Y-%m-%d') }}">
      <td class="text-nowrap" style="font-size:0.72rem;">{{ reg.fecha.strftime('%d/%m/%Y') }}</td>
      <td style="font-size:0.74rem;">
        {% if reg.user %}{{ reg.user.name }} {{ reg.user.lastname }}{% else %}—{% endif %}
      </td>
      <td>
        {% if reg.estado == 'Conflicto' %}<span class="badge-soft badge-soft-red">Desviación</span>
        {% elif reg.estado == 'Paracaidista' %}<span class="badge-soft badge-soft-blue">Sin planificar</span>
        {% elif reg.estado == 'Ausencia' %}<span class="badge-soft badge-soft-amber">Ausencia</span>
        {% else %}<span class="badge-soft badge-soft-gray">{{ reg.estado }}</span>{% endif %}
      </td>
      <td class="text-muted" style="font-size:0.68rem;">
        {% if reg.obra_planificada %}{{ reg.obra_planificada.codigo }}{% else %}Sin plan{% endif %}
        →
        {% if reg.obra_real %}{{ reg.obra_real.codigo }}{% else %}—{% endif %}
      </td>
      <td class="text-right dashboard-incidencia-actions">
        <div class="dashboard-row-actions no-row-nav">
          {% if reg.estado == 'Conflicto' %}
          <button type="button" class="btn btn-outline-danger btn-audit" onclick="event.stopPropagation(); dashboardResolverFichaje({{ reg.id }}, 'mover')">Mover</button>
          <button type="button" class="btn btn-outline-primary btn-audit" onclick="event.stopPropagation(); dashboardResolverFichaje({{ reg.id }}, 'anadir')">+ Añadir</button>
          {% elif reg.estado == 'Paracaidista' %}
          <button type="button" class="btn btn-outline-primary btn-audit" onclick="event.stopPropagation(); dashboardResolverFichaje({{ reg.id }}, 'anadir')">Aceptar</button>
          <button type="button" class="btn btn-light border btn-audit text-muted" onclick="event.stopPropagation(); dashboardResolverFichaje({{ reg.id }}, 'ignorar')">Ignorar</button>
          {% elif reg.estado == 'Ausencia' %}
          <button type="button" class="btn btn-outline-danger btn-audit" onclick="event.stopPropagation(); dashboardResolverFichaje({{ reg.id }}, 'confirmar_ausencia')">Ausencia</button>
          <button type="button" class="btn btn-light border btn-audit text-muted" onclick="event.stopPropagation(); dashboardResolverFichaje({{ reg.id }}, 'ignorar')">Ignorar</button>
          {% endif %}
        </div>
      </td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% else %}
<p class="table-empty-state text-success"><i class="fas fa-check-circle"></i>Sin incidencias pendientes</p>
{% endif %}


===== ./templates/components/_entity_stats.html =====

{# Indicadores / KPIs de ficha de entidad
   Espera: stats (lista de dicts), chart_14d (opcional), chart_14d_max (opcional)
#}
{% if stats %}
<section class="entity-stats-section" aria-label="Indicadores">
  <div class="entity-stats-section-head">
    <h2 class="entity-stats-heading">
      <i class="fas fa-chart-bar"></i> Indicadores
    </h2>
    {% if chart_14d %}
    <div class="entity-mini-chart" title="Actividad últimos 14 días">
      {% set mx = chart_14d_max or 1 %}
      {% for v in chart_14d %}
      <span class="entity-mini-chart-bar" style="height: {{ ((v / mx) * 100)|int }}%;" title="{{ v }}"></span>
      {% endfor %}
    </div>
    {% endif %}
  </div>
  <div class="entity-stats-grid">
    {% for s in stats %}
    {% set card_tag = 'a' if s.href else 'div' %}
    <{{ card_tag }}
      class="entity-stat-card entity-stat-card--{{ s.tone or 'slate' }}"
      {% if s.href %}href="{{ s.href }}"{% endif %}
      {% if s.sub %}title="{{ s.label }}: {{ s.value }} — {{ s.sub }}"{% endif %}
    >
      <div class="entity-stat-card-icon"><i class="fas {{ s.icon or 'fa-circle' }}"></i></div>
      <div class="entity-stat-card-body">
        <span class="entity-stat-card-label">{{ s.label }}</span>
        <span class="entity-stat-card-value">{{ s.value }}</span>
        {% if s.sub %}
        <span class="entity-stat-card-sub">{{ s.sub }}</span>
        {% endif %}
        {% if s.progress is not none %}
        <div class="entity-stat-progress" aria-hidden="true">
          <span class="entity-stat-progress-fill" style="width: {{ s.progress }}%;"></span>
        </div>
        {% endif %}
      </div>
    </{{ card_tag }}>
    {% endfor %}
  </div>
</section>
{% endif %}


===== ./templates/admin_obra_panel.html =====

{% extends "base.html" %}
{% block title %}Panel de Obra: {{ obra.nombre }}{% endblock %}
{% block body_class %}layout-admin{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/admin_layout.css') }}">
{% endblock %}

{% block wrapper %}
<div class="admin-shell">
  {% include "_admin_sidebar.html" %}

  <main class="admin-main entity-panel-page entity-panel-page--obra">

    <article class="entity-panel-card">
      <header class="entity-panel-card-top">
        <div class="entity-panel-toolbar-start">
          <a href="{{ url_for('admin.obras_list') }}" class="entity-panel-back">
            <i class="fas fa-arrow-left"></i> Obras
          </a>
          <span class="entity-type-marker"><i class="fas fa-building"></i> Obra</span>
        </div>
        <div class="entity-panel-actions">
          <a href="{{ url_for('admin.edit_obra', obra_id=obra.id) }}" class="btn-admin btn-admin-ghost">
            <i class="fas fa-pencil-alt"></i> Editar
          </a>
          <a href="{{ url_for('admin.obras_detailed', selected_date=obra.fecha_inicio.strftime('%Y-%m-%d')) }}" class="btn-admin btn-admin-primary">
            <i class="fas fa-th"></i> Tablero
          </a>
        </div>
      </header>

      <div class="entity-hero-accent" aria-hidden="true"></div>
      <div class="entity-hero-body entity-hero-body--full">
        <div class="entity-hero-main">
          <div class="entity-hero-title-row">
            <div class="entity-hero-icon-wrap">
              <div class="entity-hero-icon"><i class="fas fa-building"></i></div>
            </div>
            <div class="entity-hero-title-text">
              <h1 class="entity-hero-name">{{ obra.nombre }}</h1>
              <p class="entity-hero-subtitle">
                <span class="entity-code-badge">{{ obra.codigo or 'S/C' }}</span>
                {% if obra.cliente %}
                <span>{{ obra.cliente }}</span>
                {% endif %}
              </p>
            </div>
          </div>

          <div class="entity-meta-grid">
            <div class="entity-meta-item">
              <span class="entity-meta-item-label">Cliente</span>
              <span class="entity-meta-item-value">{{ obra.cliente or 'No especificado' }}</span>
            </div>
            <div class="entity-meta-item">
              <span class="entity-meta-item-label">Ubicación</span>
              <span class="entity-meta-item-value {{ 'entity-meta-item-value--muted' if not obra.ubicacion }}">
                {{ obra.ubicacion or 'No especificada' }}
              </span>
            </div>
            <div class="entity-meta-item">
              <span class="entity-meta-item-label">Plataforma PRL</span>
              <span class="entity-meta-item-value">
                {% if obra.url_prl %}
                  <a href="{{ obra.url_prl }}" target="_blank" rel="noopener">Enlace externo <i class="fas fa-external-link-alt small"></i></a>
                {% else %}
                  <span class="entity-meta-item-value--muted">Sin asignar</span>
                {% endif %}
              </span>
            </div>
            <div class="entity-meta-item">
              <span class="entity-meta-item-label">Estado</span>
              <span class="entity-meta-item-value">
                {% set estado_lower = (obra.estado or '')|lower %}
                {% if 'activ' in estado_lower %}
                  <span class="entity-status-badge entity-status-badge--obra-activa">{{ obra.estado }}</span>
                {% elif 'paus' in estado_lower %}
                  <span class="entity-status-badge entity-status-badge--obra-pausada">{{ obra.estado }}</span>
                {% elif 'pend' in estado_lower %}
                  <span class="entity-status-badge entity-status-badge--obra-pendiente">{{ obra.estado }}</span>
                {% elif 'final' in estado_lower or 'cerr' in estado_lower %}
                  <span class="entity-status-badge entity-status-badge--obra-finalizada">{{ obra.estado }}</span>
                {% else %}
                  {{ obra.estado or '—' }}
                {% endif %}
              </span>
            </div>
            <div class="entity-meta-item">
              <span class="entity-meta-item-label">Inicio / Fin</span>
              <span class="entity-meta-item-value">
                {{ obra.fecha_inicio.strftime('%d/%m/%Y') if obra.fecha_inicio else '—' }}
                → {% if obra.fecha_fin %}{{ obra.fecha_fin.strftime('%d/%m/%Y') }}{% else %}En curso{% endif %}
              </span>
            </div>
            <div class="entity-meta-item">
              <span class="entity-meta-item-label">Cupo máximo</span>
              <span class="entity-meta-item-value">{{ obra.limite_trabajadores or 'Sin límite' }}</span>
            </div>

            <div class="entity-meta-divider"></div>

            <div class="entity-meta-item">
              <span class="entity-meta-item-label">Jefe de obra</span>
              <span class="entity-meta-item-value">
                {% if obra.jefe_obra %}
                  {{ obra.jefe_obra.name }} {{ obra.jefe_obra.lastname }}
                {% else %}
                  <span class="entity-meta-item-value--muted">Sin asignar</span>
                {% endif %}
              </span>
            </div>
            <div class="entity-meta-item">
              <span class="entity-meta-item-label">Encargado</span>
              <span class="entity-meta-item-value">
                {% if obra.encargado %}
                  <i class="fas fa-hard-hat text-warning small mr-1"></i>{{ obra.encargado.name }} {{ obra.encargado.lastname }}
                {% else %}
                  <span class="entity-meta-item-value--muted">Sin asignar</span>
                {% endif %}
              </span>
            </div>
          </div>
        </div>
      </div>

      {% include "components/_entity_stats.html" %}
    </article>

    <section class="entity-calendar-zone">
      <h2 class="entity-calendar-zone-heading"><i class="fas fa-calendar-alt"></i> Planificación</h2>
      <div id="obra-panel-calendar" class="univ-calendar-root"></div>
    </section>

  </main>
</div>
{% endblock %}

{% block extra_js %}
<script src="{{ url_for('static', filename='js/universal_calendar.js') }}"></script>
<script>
let obraCalendarInstance = null;
const CURRENT_OBRA_ID = {{ obra.id }};

document.addEventListener('DOMContentLoaded', function() {
    var today = new Date().toISOString().split('T')[0];
    var startDate = "{{ obra.fecha_inicio.strftime('%Y-%m-%d') if obra.fecha_inicio else '' }}";
    var endDate = "{{ obra.fecha_fin.strftime('%Y-%m-%d') if obra.fecha_fin else '' }}";
    var initialDate = today;
    if (startDate && today < startDate) initialDate = startDate;
    else if (endDate && today > endDate) initialDate = endDate;

    obraCalendarInstance = new UniversalCalendarManager('obra-panel-calendar', {
        context: 'obra',
        id: CURRENT_OBRA_ID,
        entityName: {{ obra.nombre|tojson }},
        mode: 'empresas',
        hideTitle: true
    });

    setTimeout(() => {
        if (obraCalendarInstance.calendar && initialDate !== today) {
            obraCalendarInstance.calendar.gotoDate(initialDate);
        }
    }, 100);
});
</script>
{% endblock %}


