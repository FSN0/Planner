# app/services/assignment_service.py

from datetime import datetime, date
from app import db
from app.models import Asignacion, Solicitud, Obra, User, ROLE_ADMIN, ROLE_JEFE, ConfiguracionGlobal
from app.services.solicitud_service import (
    update_solicitudes_for_assignment,
    build_comentarios_config,
    merge_comentarios_dates,
    merge_notas,
)
from app.services.email_service import send_email, notificar_nueva_solicitud, notificar_traslado_interno
from app.services.core_assignment_service import CoreAssignmentService
from app.utils.timezone_utils import today_local

def process_assignment_action(actor_user, worker_id, target_obra_id, date_list, mode='check', overwrite=None, solicitud_id=None, notas=None):
    if overwrite is True:
        mode = 'overwrite'
    elif overwrite is False:
        mode = 'keep_both'

    worker = User.query.get(worker_id)
    target_obra = Obra.query.get(target_obra_id)

    if not worker or not target_obra:
        return {'success': False, 'error': 'Trabajador u Obra no encontrados'}

    valid_dates = []
    for d in date_list:
        if isinstance(d, str):
            try:
                valid_dates.append(datetime.strptime(d, "%Y-%m-%d").date())
            except ValueError:
                continue
        elif isinstance(d, date):
            valid_dates.append(d)
    
    valid_dates = sorted(list(set(valid_dates)))
    if not valid_dates:
        return {'success': False, 'error': 'No hay fechas válidas'}

    # ==========================================
    # LÓGICA DE ADMINISTRADOR (Modo Dios)
    # ==========================================
    if actor_user.role == ROLE_ADMIN:
        if mode in ['check', 'pure_check']:
            conflict_details = {}
            count_conflict = 0
            
            for d in valid_dates:
                asigs = Asignacion.query.filter_by(user_id=worker.id, fecha=d).all()
                asigs_reales = [a for a in asigs if a.obra_id != target_obra.id]

                if asigs_reales:
                    count_conflict += 1
                    for a in asigs_reales:
                        obra_ocupada = Obra.query.get(a.obra_id)
                        obra_str = obra_ocupada.nombre if obra_ocupada else "Otra Obra"
                        if obra_str not in conflict_details: conflict_details[obra_str] = []
                        if d.strftime('%d/%m') not in conflict_details[obra_str]:
                            conflict_details[obra_str].append(d.strftime('%d/%m'))
                            
            if count_conflict > 0:
                return {
                    'success': False, 
                    'conflict': True, 
                    'conflict_type': 'admin_hard',
                    'message': f'El trabajador ya está ocupado {count_conflict} día(s) en estas fechas en otras obras.',
                    'conflict_details': conflict_details,
                    'req_count': count_conflict
                }
            
            # FIX: Si solo era un simulacro, devolvemos OK sin tocar la BD
            if mode == 'pure_check':
                return {'success': True, 'message': 'Sin conflictos'}
                
            return _handle_direct_assignment(actor_user, worker, target_obra, valid_dates, overwrite=False, solicitud_id=solicitud_id)
            
        elif mode == 'overwrite':
            return _handle_direct_assignment(actor_user, worker, target_obra, valid_dates, overwrite=True, solicitud_id=solicitud_id)
        elif mode == 'keep_both':
            return _handle_direct_assignment(actor_user, worker, target_obra, valid_dates, overwrite=False, solicitud_id=solicitud_id)
        elif mode == 'only_free':
            free_dates = []
            for d in valid_dates:
                asigs = Asignacion.query.filter_by(user_id=worker.id, fecha=d).all()
                asigs_reales = [a for a in asigs if a.obra_id != target_obra.id]
                if not asigs_reales:
                    free_dates.append(d)

            if free_dates:
                res = _handle_direct_assignment(actor_user, worker, target_obra, free_dates, overwrite=False, solicitud_id=solicitud_id)
                res['message'] = f"Asignados {len(free_dates)} día(s) libre(s). Los ocupados en otras obras se ignoraron."
                return res
            else:
                return {'success': True, 'action': 'assigned', 'message': 'No quedaban días libres. No se asignó nada nuevo.'}

    # ==========================================
    # LÓGICA DE JEFE DE OBRA
    # ==========================================
    elif actor_user.role == ROLE_JEFE:
        if target_obra.jefe_obra_id != actor_user.id:
            return {'success': False, 'error': 'No tienes permiso sobre la obra destino.'}

        conf_custodia = ConfiguracionGlobal.query.filter_by(clave='limite_custodia').first()
        limite_dias = int(conf_custodia.valor) if conf_custodia and conf_custodia.valor.isdigit() else 15

        start_date = valid_dates[0]
        tiene_custodia = False
        
        last_asig = Asignacion.query.filter(
            Asignacion.user_id == worker.id, 
            Asignacion.fecha < start_date
        ).order_by(Asignacion.fecha.desc()).first()

        if last_asig:
            dias_diff = (start_date - last_asig.fecha).days
            if dias_diff <= limite_dias:
                asigs_ultimo_dia = Asignacion.query.filter_by(user_id=worker.id, fecha=last_asig.fecha).all()
                for asig in asigs_ultimo_dia:
                    obra_historial = Obra.query.get(asig.obra_id)
                    if obra_historial and obra_historial.jefe_obra_id == actor_user.id:
                        tiene_custodia = True
                        break 
        else:
            tiene_custodia = False

        dias_auto = []
        dias_solicitud = []
        conflict_details = {} 
        obras_origen_traslado = set() 
        
        for d in valid_dates:
            asigs_dia = Asignacion.query.filter_by(user_id=worker.id, fecha=d).all()
            
            if not asigs_dia:
                if tiene_custodia:
                    dias_auto.append(d)
                else:
                    dias_solicitud.append(d)
                    cat_name = "Libre (Falta custodia)"
                    if cat_name not in conflict_details: conflict_details[cat_name] = []
                    conflict_details[cat_name].append(d.strftime('%d/%m'))
            else:
                es_mio = False
                nombres_ajenas = []
                for a in asigs_dia:
                    obra_ocupada = Obra.query.get(a.obra_id)
                    if obra_ocupada and obra_ocupada.jefe_obra_id == actor_user.id:
                        es_mio = True
                        if obra_ocupada.id != target_obra.id:
                            obras_origen_traslado.add(obra_ocupada.nombre)
                    elif obra_ocupada:
                        nombres_ajenas.append(obra_ocupada.nombre)
                        
                if es_mio:
                    tiene_custodia = True 
                    dias_auto.append(d) 
                else:
                    dias_solicitud.append(d) 
                    obra_str = " / ".join(list(set(nombres_ajenas))) if nombres_ajenas else "Otra Obra"
                    if obra_str not in conflict_details: conflict_details[obra_str] = []
                    conflict_details[obra_str].append(d.strftime('%d/%m'))
                    
        if mode in ['check', 'pure_check']:
            if dias_auto and dias_solicitud:
                return {
                    'success': False,
                    'conflict': True,
                    'conflict_type': 'custody_partial',
                    'message': f"Tienes custodia para asignar {len(dias_auto)} días libres o propios, pero {len(dias_solicitud)} días pertenecen a otras obras o requieren autorización.",
                    'auto_count': len(dias_auto),
                    'req_count': len(dias_solicitud),
                    'conflict_details': conflict_details 
                }
            elif not dias_auto and dias_solicitud:
                mode = 'assign_and_request' 
            elif dias_auto and not dias_solicitud:
                mode = 'assign_all_custody'

        # FIX: Evitar grabar a fuego en BD si solo queríamos simular el conflicto
        if mode == 'pure_check':
            return {'success': True, 'message': 'Sin conflictos para el jefe'}

        msgs = []
        action_taken = 'assigned'

        if mode in ['assign_and_request', 'assign_all_custody', 'only_custody', 'overwrite']:
            
            if dias_auto and mode != 'only_requests':
                _handle_direct_assignment(actor_user, worker, target_obra, dias_auto, overwrite=True, solicitud_id=solicitud_id)
                msgs.append(f"Asignados automáticamente ({len(dias_auto)}d)")
                notificar_traslado_interno(actor_user.name, worker, target_obra, dias_auto, list(obras_origen_traslado))

            if dias_solicitud and mode in ['assign_and_request', 'overwrite']:
                sol, sol_status = _create_solicitud_concreta_obj(actor_user, worker, target_obra, dias_solicitud, notas=notas)
                
                if sol_status == "new":
                    notificar_nueva_solicitud(sol, actor_user.name)
                    msgs.append(f"Solicitud generada a RRHH ({len(dias_solicitud)}d)")
                elif sol_status == "merged":
                    msgs.append(f"Solicitud existente ampliada para cubrir días nuevos")
                elif sol_status == "duplicate":
                    msgs.append(f"Ya existía una solicitud (omitida para evitar duplicados)")

                action_taken = 'partial_request' if dias_auto else 'requested'

            return {'success': True, 'action': action_taken, 'message': " | ".join(msgs)}

    return {'success': False, 'error': 'Rol no autorizado o acción no contemplada'}


def _create_solicitud_concreta_obj(jefe, worker, obra, dates, notas=None):
    from datetime import timedelta
    start_date = min(dates)
    end_date = max(dates)
    dates_str = [d.strftime('%Y-%m-%d') if isinstance(d, date) else d for d in dates]

    open_solicitudes = Solicitud.query.filter_by(
        tipo='CONCRETA',
        obra_id=obra.id,
        empleado_id=worker.id
    ).filter(
        Solicitud.estado.in_(['PENDIENTE', 'EN_PROCESO'])
    ).all()

    for existing in open_solicitudes:
        if getattr(existing, 'accion', 'ASIGNAR') == 'DESASIGNAR':
            continue

        if (existing.fecha_inicio - timedelta(days=1)) <= end_date and (existing.fecha_fin + timedelta(days=1)) >= start_date:
            if existing.fecha_inicio <= start_date and existing.fecha_fin >= end_date:
                if notas:
                    existing.notas = merge_notas(existing.notas, notas)
                    db.session.commit()
                return existing, "duplicate"
            else:
                existing.fecha_inicio = min(existing.fecha_inicio, start_date)
                existing.fecha_fin = max(existing.fecha_fin, end_date)
                existing.comentarios = merge_comentarios_dates(existing.comentarios, dates_str)
                existing.notas = merge_notas(existing.notas, notas)
                db.session.commit()
                return existing, "merged"

    solicitud = Solicitud(
        tipo='CONCRETA',
        obra_id=obra.id,
        requested_by_id=jefe.id,
        empleado_id=worker.id,
        fecha_inicio=start_date,
        fecha_fin=end_date,
        perfil_categoria=worker.categoria_profesional,
        perfil_empresa_id=worker.company_id,
        cantidad_solicitada=1,
        cantidad_cubierta=0,
        estado='PENDIENTE',
        comentarios=build_comentarios_config(dates_str),
        notas=(notas or '').strip() or None,
    )
    db.session.add(solicitud)
    db.session.commit()
    return solicitud, "new"

def _handle_direct_assignment(actor, worker, obra, dates, overwrite, solicitud_id=None):
    count = 0
    deleted_info = [] 
    
    for d in dates:
        same_obra_conflict = Asignacion.query.filter_by(
            user_id=worker.id, fecha=d, obra_id=obra.id
        ).first()
        
        if same_obra_conflict:
            continue 

        if overwrite:
            existing_others = Asignacion.query.filter_by(user_id=worker.id, fecha=d).all()
            for exist in existing_others:
                deleted_info.append((exist.obra_id, exist.user_id, d))
                CoreAssignmentService.desasignar(
                    exist.user_id, exist.obra_id, exist.fecha, actor.id,
                    "Planificación Manual", "Sobreescritura de asignación previa."
                )

        CoreAssignmentService.asignar(
            worker.id, obra.id, d, actor.id, "Planificación Manual",
            company_id=worker.company_id, solicitud_id=solicitud_id,
        )
        count += 1

    for o_id, w_id, d_del in deleted_info:
        update_solicitudes_for_assignment(o_id, w_id, d_del, resolved_by_id=actor.id)
        
    for d in dates:
        update_solicitudes_for_assignment(obra.id, worker.id, d, resolved_by_id=actor.id)

    db.session.commit()

    return {'success': True, 'action': 'assigned', 'message': f'Asignación realizada ({count} días).'}

def process_unassign_action(actor_user, worker_id, target_obra_id, date_list, mode='selected'):
    from app.services.solicitud_service import SolicitudService, update_solicitudes_for_assignment
    from app.services.email_service import notificar_movimiento_admin_a_jo
    
    worker_id = int(worker_id) if worker_id else None
    target_obra_id = int(target_obra_id) if target_obra_id else None

    if not worker_id:
        return {'success': False, 'message': 'Falta ID trabajador'}

    query = Asignacion.query.filter_by(user_id=worker_id)
    if target_obra_id:
        query = query.filter_by(obra_id=target_obra_id)

    date_objs = []
    if mode == 'all_obra':
        asignaciones = query.filter(Asignacion.fecha >= today_local()).all()
        if not asignaciones:
            return {'success': False, 'message': 'No hay asignaciones futuras para borrar.'}
        date_objs = [a.fecha for a in asignaciones]
    else:
        raw_dates = sorted([datetime.strptime(d, '%Y-%m-%d').date() if isinstance(d, str) else d for d in date_list])
        date_objs = [d for d in raw_dates if d >= today_local()]
        asignaciones = query.filter(Asignacion.fecha.in_(date_objs)).all()

    if not date_objs:
        return {'success': False, 'message': 'No hay fechas válidas.'}
    
    fechas_con_asignacion = [a.fecha for a in asignaciones]
    
    if actor_user.role == ROLE_JEFE:
        if not fechas_con_asignacion:
            return {'success': False, 'message': 'El trabajador no tiene asignaciones en este periodo.'}
            
        sol, status = SolicitudService.create_or_merge_solicitud_baja(actor_user.id, target_obra_id, worker_id, fechas_con_asignacion)
        msg = 'Se ha generado una solicitud de baja.' if status == 'new' else 'Se han añadido los días a una solicitud existente.'
        return {'success': True, 'action': 'requested', 'message': msg}


    count = len(asignaciones)
    fechas_borradas = [a.fecha.strftime('%d/%m/%Y') for a in asignaciones]
    
    for a in asignaciones:
        CoreAssignmentService.desasignar(
            a.user_id, a.obra_id, a.fecha, actor_user.id,
            "Planificación Manual"
        )
    
    for d_obj in date_objs:
        try:
            update_solicitudes_for_assignment(target_obra_id, worker_id, d_obj, resolved_by_id=actor_user.id)
        except Exception:
            pass

    db.session.commit()
    
    if target_obra_id and count > 0:
        worker = User.query.get(worker_id)
        worker_name = f"{worker.name} {worker.lastname}" if worker else f"ID {worker_id}"
        
        if len(fechas_borradas) > 10:
            fechas_str = ", ".join(fechas_borradas[:10]) + f" ... y {len(fechas_borradas)-10} días más."
        else:
            fechas_str = ", ".join(fechas_borradas)

        notificar_movimiento_admin_a_jo(target_obra_id, worker_name, "Desasignar", fechas_str, actor_user.name)

    return {'success': True, 'action': 'unassigned', 'message': f'Se han eliminado {count} asignaciones.'}

===== ./services/sync_runner_service.py =====

"""Ejecución de sync automática por módulo (usado por Celery y «Auto ahora»)."""
import time
from datetime import datetime

from werkzeug.security import generate_password_hash

from app import db
from app.models import Obra, User, Company, SyncLog
from app.services.sync_service import OdooSyncService
from app.utils.timezone_utils import utc_now


def _log_estado(errores, had_exception=False):
    if had_exception:
        return 'error'
    if errores and errores > 0:
        return 'parcial'
    return 'ok'


def run_auto_sync_obras():
    t0 = time.time()
    ahora = utc_now()
    service = OdooSyncService()
    diff = service.get_diff_obras()
    nuevas_limpias = [o for o in diff['nuevas'] if not o.get('warn_jefe') and not o.get('warn_encargado')]
    act_limpias = [o for o in diff['actualizadas'] if not o.get('warn_jefe') and not o.get('warn_encargado')]
    errores = (len(diff['nuevas']) - len(nuevas_limpias)) + (len(diff['actualizadas']) - len(act_limpias))

    for obj in nuevas_limpias:
        f_inicio = datetime.strptime(obj['fecha_inicio'], "%Y-%m-%d").date() if obj.get('fecha_inicio') else None
        db.session.add(Obra(
            odoo_id=obj['odoo_id'], codigo=obj['codigo'], nombre=obj['nombre'],
            descripcion=obj.get('cliente', ''), fecha_inicio=f_inicio, estado='Pendiente',
            jefe_obra_id=obj.get('jefe_obra_id'), encargado_id=obj.get('encargado_id'),
            fecha_importacion=ahora,
        ))

    for obj in act_limpias:
        obra = Obra.query.get(obj['local_id'])
        if obra:
            obra.odoo_id = obj['odoo_id']
            obra.codigo = obj['codigo']
            obra.nombre = obj['nombre']
            obra.descripcion = obj.get('cliente', '')
            obra.fecha_importacion = ahora
            if obj.get('fecha_inicio'):
                obra.fecha_inicio = datetime.strptime(obj['fecha_inicio'], "%Y-%m-%d").date()
            if obj.get('jefe_obra_id'):
                obra.jefe_obra_id = obj['jefe_obra_id']
            if obj.get('encargado_id'):
                obra.encargado_id = obj['encargado_id']

    for obj in diff['finalizadas']:
        obra = Obra.query.get(obj['local_id'])
        if obra:
            obra.estado = 'Finalizada'
            obra.fecha_fin = ahora.date()
            obra.fecha_importacion = ahora

    detalle = f"Sync automática obras. {errores} omitida(s) por responsables sin resolver." if errores else "Sync automática obras completada."
    db.session.add(SyncLog(
        fecha=ahora, tipo='Obras', modo='Automático',
        nuevos=len(nuevas_limpias), actualizados=len(act_limpias),
        finalizados=len(diff['finalizadas']), errores=errores,
        detalles=detalle, estado=_log_estado(errores),
        duracion_ms=int((time.time() - t0) * 1000),
    ))
    db.session.commit()
    return {'nuevos': len(nuevas_limpias), 'actualizados': len(act_limpias), 'omitidos': errores}


def run_auto_sync_empleados():
    t0 = time.time()
    ahora = utc_now()
    service = OdooSyncService()
    diff = service.get_diff_empleados()
    emp_nuevos = diff['nuevos']
    emp_act = [e for e in diff['actualizados'] if not e.get('conflicto')]
    errores = len(diff['actualizados']) - len(emp_act)
    default_company = Company.query.first()
    default_company_id = default_company.id if default_company else None

    for obj in emp_nuevos:
        db.session.add(User(
            odoo_id=obj['odoo_id'], name=obj['name'], lastname=obj['lastname'],
            dni=obj['dni'], email=obj['email'], role=obj['role'],
            categoria_profesional=obj.get('categoria_profesional', 'Sin definir'),
            company_id=default_company_id, active=True,
            password_hash=generate_password_hash("123456"),
        ))

    for obj in emp_act:
        user = User.query.get(obj['local_id'])
        if user:
            user.odoo_id = obj['odoo_id']
            user.name = obj['name']
            user.lastname = obj['lastname']
            user.role = obj['role']
            user.categoria_profesional = obj.get('categoria_profesional', user.categoria_profesional)

    detalle = f"Sync automática empleados. {errores} omitido(s) por conflictos DNI/email." if errores else "Sync automática empleados completada."
    db.session.add(SyncLog(
        fecha=ahora, tipo='Empleados', modo='Automático',
        nuevos=len(emp_nuevos), actualizados=len(emp_act),
        finalizados=0, errores=errores,
        detalles=detalle, estado=_log_estado(errores),
        duracion_ms=int((time.time() - t0) * 1000),
    ))
    db.session.commit()
    return {'nuevos': len(emp_nuevos), 'actualizados': len(emp_act), 'omitidos': errores}


def run_auto_sync_subcontratas():
    t0 = time.time()
    ahora = utc_now()
    service = OdooSyncService()
    diff = service.get_diff_subcontratas()
    mapa_empresas = {}

    for obj in diff['empresas']['actualizadas']:
        comp = Company.query.get(obj['local_id'])
        if comp:
            comp.odoo_id = obj['odoo_id']
            comp.nombre = obj['nombre']
            mapa_empresas[obj['odoo_id']] = comp.id

    for obj in diff['empresas']['nuevas']:
        nueva = Company(odoo_id=obj['odoo_id'], nombre=obj['nombre'])
        db.session.add(nueva)
        db.session.flush()
        mapa_empresas[obj['odoo_id']] = nueva.id

    for obj in diff['empleados']['actualizados']:
        user = User.query.get(obj['local_id'])
        if user:
            user.odoo_id = obj['odoo_id']
            user.name = obj['name']
            user.lastname = obj['lastname']
            if obj['dni'] and 'SINDNI' not in obj['dni']:
                user.dni = obj['dni']
            user.categoria_profesional = obj.get('categoria_profesional')
            odoo_c_id = obj.get('odoo_company_id')
            if odoo_c_id:
                if odoo_c_id not in mapa_empresas:
                    comp = Company.query.filter_by(odoo_id=odoo_c_id).first()
                    if comp:
                        mapa_empresas[odoo_c_id] = comp.id
                if odoo_c_id in mapa_empresas:
                    user.company_id = mapa_empresas[odoo_c_id]

    dnis_en_tx = set()
    for obj in diff['empleados']['nuevos']:
        odoo_c_id = obj.get('odoo_company_id')
        local_comp_id = mapa_empresas.get(odoo_c_id)
        if not local_comp_id and odoo_c_id:
            comp = Company.query.filter_by(odoo_id=odoo_c_id).first()
            if comp:
                local_comp_id = comp.id
                mapa_empresas[odoo_c_id] = local_comp_id
        dni = obj['dni']
        if User.query.filter_by(dni=dni).first() or dni in dnis_en_tx:
            dni = f"{dni}-EXT{obj['odoo_id']}"
        dnis_en_tx.add(dni)
        db.session.add(User(
            odoo_id=obj['odoo_id'], name=obj['name'], lastname=obj['lastname'],
            dni=dni, email=obj['email'], role=obj['role'],
            categoria_profesional=obj.get('categoria_profesional'),
            company_id=local_comp_id, active=True,
            password_hash=generate_password_hash("123456"),
        ))

    tot_n = len(diff['empresas']['nuevas']) + len(diff['empleados']['nuevos'])
    tot_a = len(diff['empresas']['actualizadas']) + len(diff['empleados']['actualizados'])
    db.session.add(SyncLog(
        fecha=ahora, tipo='Subcontratas', modo='Automático',
        nuevos=tot_n, actualizados=tot_a, finalizados=0, errores=0,
        detalles="Sync automática subcontratas completada.",
        estado='ok', duracion_ms=int((time.time() - t0) * 1000),
    ))
    db.session.commit()
    return {'nuevos': tot_n, 'actualizados': tot_a, 'omitidos': 0}


===== ./services/core_assignment_service.py =====

# app/services/core_assignment_service.py
#
# ÚNICA FUENTE DE LA VERDAD para mutaciones del cuadrante (Asignaciones).
# Todo el proyecto DEBE usar exclusivamente asignar() / desasignar()
# para crear o eliminar objetos Asignacion.

from app import db
from app.utils.timezone_utils import utc_now
from app.models import Asignacion, SystemLog, Obra, User


class CoreAssignmentService:

    @staticmethod
    def format_obra_label(obra):
        if not obra:
            return "Obra desconocida"
        codigo = (obra.codigo or "").strip()
        nombre = (obra.nombre or "").strip()
        if codigo and nombre:
            return f"{codigo} — {nombre}"
        return codigo or nombre or f"Obra #{obra.id}"

    @staticmethod
    def _is_system_action(contexto_origen):
        return (
            contexto_origen in (
                "Auto-asignación por Fichaje Físico",
                "Actualización de Cuadrante (Auto)",
            )
            or "(Auto)" in (contexto_origen or "")
        )

    @staticmethod
    def asignar(user_id, obra_id, fecha, autor_id, contexto_origen,
                detalle_extra=None, *, company_id=None, solicitud_id=None):
        """
        Crea una Asignacion y registra un SystemLog en la misma transacción.
        Hace flush() para garantizar integridad referencial; el commit()
        queda como responsabilidad del flujo superior.

        Retorna el objeto Asignacion recién creado.
        """
        nueva = Asignacion(
            user_id=user_id,
            obra_id=obra_id,
            fecha=fecha,
            company_id=company_id,
            solicitud_id=solicitud_id,
        )
        db.session.add(nueva)

        CoreAssignmentService._registrar_log(
            user_id, obra_id, fecha, autor_id, contexto_origen,
            es_alta=True, detalle_extra=detalle_extra,
        )

        db.session.flush()
        return nueva

    @staticmethod
    def desasignar(user_id, obra_id, fecha, autor_id, contexto_origen,
                   detalle_extra=None):
        """
        Elimina la Asignacion que coincida con (user_id, obra_id, fecha)
        y registra un SystemLog en la misma transacción.
        Hace flush(); el commit() queda para el flujo superior.

        Retorna True si se encontró y borró, False si no existía.
        """
        asig = Asignacion.query.filter_by(
            user_id=user_id, obra_id=obra_id, fecha=fecha,
        ).first()

        if not asig:
            return False

        db.session.delete(asig)

        CoreAssignmentService._registrar_log(
            user_id, obra_id, fecha, autor_id, contexto_origen,
            es_alta=False, detalle_extra=detalle_extra,
        )

        db.session.flush()
        return True

    # ------------------------------------------------------------------
    # Helpers internos
    # ------------------------------------------------------------------
    @staticmethod
    def _registrar_log(user_id, obra_id, fecha, autor_id, contexto_origen,
                       es_alta, detalle_extra=None):
        verbo = "Asignado" if es_alta else "Desasignado"

        obra = Obra.query.get(obra_id)
        user = User.query.get(user_id)
        obra_label = CoreAssignmentService.format_obra_label(obra)
        user_nombre = f"{user.name} {user.lastname}" if user else f"ID {user_id}"

        detail = f"{verbo} {user_nombre} → '{obra_label}' ({fecha.strftime('%d/%m/%Y')})."
        if detalle_extra:
            detail = f"{detail} {detalle_extra}"

        log_user_id = None if CoreAssignmentService._is_system_action(contexto_origen) else autor_id

        db.session.add(SystemLog(
            timestamp=utc_now(),
            user_id=log_user_id,
            category='planificacion',
            action=contexto_origen,
            detail=detail,
            target_user_id=user_id,
            target_date=fecha,
        ))


