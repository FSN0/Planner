{% endblock %}

{% block wrapper %}
<div class="admin-shell">
  {# SIDEBAR ESPECÍFICA PARA RRHH (O podemos reutilizar la admin ocultando cosas por rol) #}
  {% include "_admin_sidebar.html" %}

  <main class="admin-main">
    
    <header class="admin-header">
      <div class="admin-header-title">Recursos Humanos</div>
      <p class="admin-header-subtitle">Gestión de altas, bajas y documentación del personal.</p>
    </header>

    {# TARJETAS DE RESUMEN #}
    <section class="admin-card-grid mb-4">
      <article class="admin-stat-card">
        <div class="admin-stat-label">Plantilla Activa</div>
        <div class="admin-stat-value text-success">{{ active_count }}</div>
        <div class="admin-stat-caption">Operarios disponibles para obras</div>
      </article>

      <article class="admin-stat-card">
        <div class="admin-stat-label">Pendientes de Alta</div>
        <div class="admin-stat-value text-warning">{{ pending_count }}</div>
        <div class="admin-stat-caption">Requieren revisión de documentación</div>
