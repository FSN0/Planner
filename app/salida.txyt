{% extends "base.html" %}
{% block title %}Nueva Empresa{% endblock %}
{% block body_class %}layout-admin{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/admin_layout.css') }}">
{% endblock %}

{% block wrapper %}
<div class="admin-shell">
  {% include "_admin_sidebar.html" %}

  <main class="admin-main admin-main--compact admin-form-page">

    <div class="page-toolbar">
      <div class="page-toolbar-left">
        <a href="{{ url_for('admin.companies') }}" class="btn-admin btn-admin-ghost" style="padding: 0.25rem 0.5rem;">
          <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="page-toolbar-title">Nueva subcontrata</h1>
      </div>
    </div>

    <section class="admin-panel admin-form-panel">
      <div class="admin-panel-header">
        <h2 class="admin-panel-title">Nueva empresa</h2>
        <span class="admin-panel-subtitle">Registra una subcontrata o entidad interna</span>
      </div>

      <form action="{{ url_for('admin.create_company') }}" method="POST">
        <div class="form-row">
          <div class="form-group col-md-4">
            <label class="admin-form-label">Código interno</label>
            <input type="text" name="code" class="form-control" placeholder="Ej: SOLTEC" required>
            <small class="form-text text-muted" style="font-size: 0.72rem;">Identificador único</small>
          </div>
          <div class="form-group col-md-8">
            <label class="admin-form-label">Nombre fiscal</label>
            <input type="text" name="nombre" class="form-control" placeholder="Nombre de la empresa" required>
          </div>
        </div>

        <div class="form-group">
          <label class="admin-form-label">NIF / CIF</label>
          <input type="text" name="nif" class="form-control" placeholder="A-12345678">
        </div>

        <div class="form-group">
          <label class="admin-form-label">Descripción</label>
          <textarea name="descripcion" class="form-control" rows="2" placeholder="Notas internas…"></textarea>
        </div>

        <div class="form-row">
          <div class="form-group col-md-6">
            <label class="admin-form-label">Gremio</label>
            <input type="text" name="gremio" class="form-control" placeholder="Ej: Electricidad">
          </div>
          <div class="form-group col-md-6">
            <label class="admin-form-label">Email</label>
            <input type="email" name="email" class="form-control" placeholder="contacto@empresa.com">
          </div>
        </div>

        <div class="form-group">
          <label class="admin-form-label">Color identificativo</label>
          <div class="d-flex align-items-center">
            <input type="color" name="color" class="form-control form-control-color mr-2" style="height: 32px; width: 48px; padding: 2px;" value="#cccccc">
            <span class="text-muted" style="font-size: 0.72rem;">Usado en calendario y tablero</span>
          </div>
        </div>

        <div class="admin-form-options">
          <div class="admin-form-switch-row">
            <label class="admin-form-switch">
              <input type="checkbox" name="is_internal" id="isInternalCheck">
              <span class="slider"></span>
            </label>
            <div>
              <label for="isInternalCheck" class="admin-form-switch-label" style="cursor: pointer;">Empresa interna (propia)</label>
              <p class="admin-form-switch-hint">La empresa y sus trabajadores se consideran «de la casa»</p>
            </div>
          </div>
        </div>

        <div class="admin-form-actions">
          <div></div>
          <div class="admin-form-actions-right">
            <a href="{{ url_for('admin.companies') }}" class="btn-admin-link">Cancelar</a>
            <button type="submit" class="btn-admin btn-admin-primary">
              <i class="fas fa-plus"></i> Crear empresa
            </button>
          </div>
        </div>
      </form>
    </section>
  </main>
</div>
{% endblock %}


===== ./templates/admin_worker_ratings.html =====

{% extends "base.html" %}
{% block title %}Historial: {{ worker.name }}{% endblock %}
{% block body_class %}layout-admin{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/admin_layout.css') }}">
{% endblock %}

{% block wrapper %}
<div class="admin-shell">
  {% include "_admin_sidebar.html" %}
  <main class="admin-main admin-main--compact ratings-history-page">

    <a href="{{ url_for('admin.worker_panel', user_id=worker.id) }}" class="ratings-history-back">
      <i class="fas fa-arrow-left"></i> Volver a la ficha
    </a>

    <article class="ratings-history-card">
      <header class="ratings-history-hero">
        <div>
          <h1 class="ratings-history-hero-title">Historial de valoraciones</h1>
          <p class="ratings-history-hero-sub">{{ worker.name }} {{ worker.lastname }}</p>
        </div>
        <div class="ratings-history-score">
          <span class="ratings-history-score-label">Reputación actual</span>
          <span class="ratings-history-score-value {% if worker.reputation_score > 0 %}ratings-history-score-value--pos{% elif worker.reputation_score < 0 %}ratings-history-score-value--neg{% else %}ratings-history-score-value--zero{% endif %}">
            {{ '+' if worker.reputation_score > 0 }}{{ worker.reputation_score }}
          </span>
        </div>
      </header>

      <div class="ratings-table-wrap">
        <table class="ratings-table">
          <thead>
            <tr>
              <th style="width: 140px;">Fecha</th>
              <th style="width: 80px;" class="text-center">Puntos</th>
              <th style="width: 90px;" class="text-center">Estado</th>
              <th>Motivo</th>
              <th style="width: 180px;">Evaluador</th>
              <th style="width: 90px;" class="text-right">Acciones</th>
            </tr>
          </thead>
          <tbody>
            {% for rating in ratings %}
            {% set can_manage = (current_user.role == 'admin') or (rating.created_by_id == current_user.id) %}
            <tr class="{% if not rating.is_active %}is-archived{% endif %}" data-rating-id="{{ rating.id }}">
              <td class="text-muted small text-nowrap">
                {{ rating.created_at|format_dt }}
              </td>
              <td class="text-center">
                {% if rating.score > 0 %}
                  <span class="rating-score-pill rating-score-pill--pos">+{{ rating.score }}</span>
                {% else %}
                  <span class="rating-score-pill rating-score-pill--neg">{{ rating.score }}</span>
                {% endif %}
              </td>
              <td class="text-center">
                {% if rating.is_active %}
                  <span class="badge-soft">Activo</span>
                {% else %}
                  <span class="badge-soft" style="opacity:0.7;">Archivado</span>
                {% endif %}
              </td>
              <td class="col-reason rating-reason-cell">
                {% if rating.reason %}
                  {{ rating.reason }}
                {% else %}
                  <span class="text-muted font-italic small">Sin motivo especificado</span>
                {% endif %}
              </td>
              <td>
                <span class="font-weight-bold text-dark">{{ rating.created_by.name }}</span>
                <small class="text-muted">({{ rating.created_by.role }})</small>
              </td>
              <td class="text-right">
                {% if rating.is_active and can_manage %}
                <div class="ratings-row-actions">
                  <button type="button" class="btn btn-light border btn-sm btn-icon"
                          onclick="openEditRating({{ rating.id }}, {{ rating.score }}, {{ rating.reason|tojson }})"
                          title="Editar">
                    <i class="fas fa-edit text-primary"></i>
                  </button>
                  <button type="button" class="btn btn-light border btn-sm btn-icon"
                          onclick="deleteRating({{ rating.id }})" title="Eliminar">
                    <i class="fas fa-trash-alt text-danger"></i>
                  </button>
                </div>
                {% else %}
                  <span class="text-muted small">—</span>
                {% endif %}
              </td>
            </tr>
            {% else %}
            <tr>
              <td colspan="6">
                <div class="ratings-empty">
                  <i class="far fa-folder-open d-block"></i>
                  Aún no hay valoraciones registradas para este trabajador.
                </div>
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </article>

  </main>
</div>

<div class="modal fade entity-rating-modal" id="editRatingModal" tabindex="-1" role="dialog">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title mb-0"><i class="fas fa-edit mr-1"></i> Editar valoración</h5>
        <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="editRatingId">
        <p class="rating-intro text-center mb-0">Modifica la puntuación (-3 a +3)</p>
        <div class="entity-rating-score-grid">
          <div class="entity-rating-score-group">
            <button type="button" class="entity-rating-btn entity-rating-btn--neg edit-rating-btn" data-score="-3">-3</button>
            <button type="button" class="entity-rating-btn entity-rating-btn--neg edit-rating-btn" data-score="-2">-2</button>
            <button type="button" class="entity-rating-btn entity-rating-btn--neg edit-rating-btn" data-score="-1">-1</button>
          </div>
          <div class="entity-rating-score-group">
            <button type="button" class="entity-rating-btn entity-rating-btn--pos edit-rating-btn" data-score="1">+1</button>
            <button type="button" class="entity-rating-btn entity-rating-btn--pos edit-rating-btn" data-score="2">+2</button>
            <button type="button" class="entity-rating-btn entity-rating-btn--pos edit-rating-btn" data-score="3">+3</button>
          </div>
        </div>
        <label class="form-label-sm" for="editRatingReason">Motivo</label>
        <textarea id="editRatingReason" class="form-control mb-3" rows="3" placeholder="Motivo…"></textarea>
        <button type="button" class="btn-admin btn-admin-primary btn-block" onclick="saveEditRating()">
          <i class="fas fa-save mr-1"></i> Guardar cambios
        </button>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block extra_js %}
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
var editSelectedScore = null;

function openEditRating(id, score, reason) {
  editSelectedScore = score;
  $('#editRatingId').val(id);
  $('#editRatingReason').val(reason || '');
  $('.edit-rating-btn').removeClass('active');
  $('.edit-rating-btn[data-score="' + score + '"]').addClass('active');
  $('#editRatingModal').modal('show');
}

$(document).on('click', '.edit-rating-btn', function() {
  $('.edit-rating-btn').removeClass('active');
  $(this).addClass('active');
  editSelectedScore = $(this).data('score');
});

function saveEditRating() {
  if (!editSelectedScore) { alert('Selecciona una puntuación.'); return; }
  var id = $('#editRatingId').val();
  $.ajax({
    url: '/admin/api/rating/' + id,
    type: 'PUT',
    contentType: 'application/json',
    data: JSON.stringify({ score: editSelectedScore, reason: $('#editRatingReason').val() }),
    success: function() { window.location.reload(); },
    error: function(xhr) {
      alert('Error: ' + (xhr.responseJSON ? xhr.responseJSON.message : 'Error'));
    }
  });
}

function deleteRating(id) {
  Swal.fire({
    title: '¿Eliminar valoración?',
    text: 'Se archivará y dejará de contar para la reputación.',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#dc2626',
    cancelButtonColor: '#64748b',
    confirmButtonText: 'Sí, eliminar',
    cancelButtonText: 'Cancelar'
  }).then(function(result) {
    if (result.isConfirmed) {
      $.ajax({
        url: '/admin/api/rating/' + id,
        type: 'DELETE',
        success: function() { window.location.reload(); },
        error: function(xhr) {
          Swal.fire('Error', xhr.responseJSON ? xhr.responseJSON.message : 'Error', 'error');
        }
      });
    }
  });
}
</script>
{% endblock %}


===== ./templates/_admin_sidebar.html =====

<aside class="admin-sidebar">
  <div class="admin-sidebar-head">
    <div class="admin-logo">
      <div class="admin-logo-mark"><i class="fas fa-hard-hat"></i></div>
      <div class="admin-logo-text">
        <span>SOCTEC</span>
        <span>Planning</span>
      </div>
    </div>
    <button type="button" class="sidebar-toggle-btn" id="sidebar-toggle" title="Contraer menú" aria-label="Contraer menú">
      <i class="fas fa-chevron-left" aria-hidden="true"></i>
    </button>
  </div>

  <div class="admin-user-chip">
    <span class="admin-user-name">{{ current_user.name }}</span>
    <span class="admin-user-role">{{ current_user.role|replace('_', ' ')|title }}</span>
  </div>

  <nav class="sidebar-nav-wrap" aria-label="Navegación principal">
    <ul class="sidebar-nav">
      <li>
        <a href="{% if current_user.role == 'jefe_obra' %}{{ url_for('jefe.panel') }}{% elif current_user.role == 'admin' %}{{ url_for('admin.panel') }}{% else %}{{ url_for('main.dashboard') }}{% endif %}" class="sidebar-link {% if request.endpoint in ['main.dashboard', 'admin.panel', 'jefe.panel'] %}is-active{% endif %}">
          <i class="fas fa-home fa-fw"></i><span>Inicio</span>
        </a>
      </li>
      {% if current_user.role == 'operario' %}
      <li>
        <a href="{{ url_for('operarios.calendar') }}" class="sidebar-link {% if 'calendar' in request.endpoint %}is-active{% endif %}">
          <i class="far fa-calendar-alt fa-fw"></i><span>Mi calendario</span>
        </a>
      </li>
      {% endif %}
    </ul>

    {% if current_user.role in ['admin', 'jefe_obra'] %}
    <div class="sidebar-section-title">Planificación</div>
    <ul class="sidebar-nav">
      {% if current_user.role == 'admin' %}
      <li>
        <a href="{{ url_for('admin.obras_detailed') }}" class="sidebar-link {% if request.endpoint == 'admin.obras_detailed' %}is-active{% endif %}">
          <i class="fas fa-th-large fa-fw"></i><span>Tablero</span>
        </a>
      </li>
      <li>
        <a href="{{ url_for('admin.obras_list') }}" class="sidebar-link {% if request.endpoint == 'admin.obras_list' %}is-active{% endif %}">
          <i class="fas fa-building fa-fw"></i><span>Directorio</span>
        </a>
      </li>
      {% endif %}
      <li>
        <a href="{{ url_for('admin.planificador_jo') }}" class="sidebar-link {% if 'planificador' in request.endpoint %}is-active{% endif %}">
          <i class="fas fa-calendar-check fa-fw"></i><span>Planificador</span>
        </a>
      </li>
      <li>
        <a href="{{ url_for('notas.centro_mando') }}" class="sidebar-link {% if 'notas' in request.endpoint %}is-active{% endif %}">
          <i class="fas fa-book-open fa-fw"></i><span>Reuniones</span>
        </a>
      </li>
    </ul>
    {% endif %}

    {% if current_user.role in ['admin', 'rrhh', 'jefe_obra'] %}
    <div class="sidebar-section-title">Personal</div>
    <ul class="sidebar-nav">
      {% if current_user.role in ['admin', 'rrhh'] %}
      <li>
        <a href="{{ url_for('admin.personal') }}" class="sidebar-link {% if 'personal' in request.endpoint %}is-active{% endif %}">
          <i class="fas fa-users fa-fw"></i><span>Trabajadores</span>
        </a>
      </li>
      {% endif %}
      {% if current_user.role == 'admin' %}
      <li>
        <a href="{{ url_for('admin.companies') }}" class="sidebar-link {% if 'companies' in request.endpoint %}is-active{% endif %}">
          <i class="fas fa-industry fa-fw"></i><span>Subcontratas</span>
        </a>
      </li>
      {% endif %}
      {% if current_user.role in ['admin', 'jefe_obra'] %}
      <li>
        <a href="{{ url_for('admin.solicitudes_list') }}" class="sidebar-link {% if 'solicitud' in request.endpoint %}is-active{% endif %}">
          <i class="fas fa-user-plus fa-fw"></i>
          <span>Solicitudes</span>
          {% if pending_notifications and pending_notifications > 0 %}
            <span class="sidebar-badge">{{ pending_notifications }}</span>
          {% endif %}
        </a>
      </li>
      <li>
        <a href="{{ url_for('admin.sso_odoo_contactos') }}" class="sidebar-link" target="_blank" rel="noopener" title="Panel de altas en Odoo">
          <i class="fas fa-address-book fa-fw"></i>
          <span>Alta Odoo</span>
          <i class="fas fa-external-link-alt sidebar-link-ext" aria-hidden="true"></i>
        </a>
      </li>
      {% endif %}
    </ul>
    {% endif %}

    {% if current_user.role in ['admin', 'jefe_obra'] %}
    <div class="sidebar-section-title">Control</div>
    <ul class="sidebar-nav">
      <li>
        <a href="{{ url_for('sync.auditoria_fichajes') }}" class="sidebar-link {% if request.endpoint == 'sync.auditoria_fichajes' %}is-active{% endif %}">
          <i class="fas fa-user-clock fa-fw"></i><span>Auditoría fichajes</span>
        </a>
      </li>
      {% if current_user.role == 'admin' %}
      <li>
        <a href="{{ url_for('sync.panel') }}" class="sidebar-link {% if request.endpoint == 'sync.panel' %}is-active{% endif %}">
          <i class="fas fa-sync-alt fa-fw"></i><span>Sincronizar Odoo</span>
        </a>
      </li>
      <li>
        <a href="{{ url_for('admin.configuracion_global') }}" class="sidebar-link {% if 'configuracion' in request.endpoint %}is-active{% endif %}">
          <i class="fas fa-sliders-h fa-fw"></i><span>Configuración</span>
        </a>
      </li>
      <li>
        <a href="{{ url_for('admin.system_logs') }}" class="sidebar-link {% if 'system_logs' in request.endpoint %}is-active{% endif %}">
          <i class="fas fa-history fa-fw"></i>
          <span>Logs</span>
          {% if unread_logs_count and unread_logs_count > 0 %}
            <span class="sidebar-badge sidebar-badge--danger">{{ unread_logs_count }}</span>
          {% endif %}
        </a>
      </li>
      {% endif %}
    </ul>
    {% endif %}
  </nav>

  <div class="sidebar-spacer"></div>

  <div class="sidebar-footer-block">
    <form action="{{ url_for('main.update_user_timezone') }}" method="POST" class="sidebar-tz-form">
      <label class="sidebar-tz-label" for="sidebar-timezone"><i class="fas fa-globe-europe"></i> Zona horaria</label>
      <select id="sidebar-timezone" name="timezone" class="sidebar-tz-select" onchange="this.form.submit()">
        {% for tz_code, tz_label in timezone_options %}
        <option value="{{ tz_code }}" {% if user_timezone == tz_code %}selected{% endif %}>{{ tz_label }}</option>
        {% endfor %}
      </select>
    </form>
    <a href="{{ url_for('auth.logout') }}" class="sidebar-link sidebar-link--logout">
      <i class="fas fa-sign-out-alt fa-fw"></i><span>Cerrar sesión</span>
    </a>
    <div class="sidebar-footer">v2.0 · {{ current_user.company_code or 'Interno' }}</div>
  </div>
</aside>


===== ./templates/base.html =====

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Gestión de Obras{% endblock %}</title>
    
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="{{ url_for('static', filename='css/design-tokens.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='timeline.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/styles.css') }}">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="{{ url_for('static', filename='css/universal_calendar.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/admin_features.css') }}">
    <style>
        .select2-container .select2-selection--multiple { border-color: #e2e8f0; border-radius: 10px; min-height: 38px; }
        .select2-container .select2-selection--single { border-color: #e2e8f0; border-radius: 10px; }
        /* Estilos para el botón de notas al colapsar */
  .sidebar-collapsed .texto-nueva-nota { display: none !important; }
  .sidebar-collapsed .nota-btn-container { padding: 0 10px !important; }
  .sidebar-collapsed .nota-btn-container .btn { padding: 10px 0 !important; }
  .sidebar-collapsed .nota-btn-container i { margin: 0 !important; font-size: 1.2rem; }
    </style>
    <script>
        (function() {
            var isCollapsed = localStorage.getItem("sidebarCollapsed") === "1";
            if (isCollapsed) {
                document.documentElement.classList.add('sidebar-collapsed');
            }
        })();
    </script>

    {% block extra_css %}{% endblock %}
</head>
<body class="preload {% block body_class %}{% endblock %}">
    
    <nav class="navbar navbar-expand-lg navbar-light bg-light" style="display:none !important;">
    </nav>
    
    <div class="container-fluid mt-3" style="position: absolute; z-index: 9999; pointer-events: none;">
        <div class="row justify-content-center">
            <div class="col-md-8" style="pointer-events: auto;">
                 {% include "components/_flashes.html" %}
            </div>
        </div>
    </div>

    {% block wrapper %}
    <div class="container mt-4">
        {% block content %}{% endblock %}
    </div>
    {% endblock %}
    
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js'></script>
    <script src="https://unpkg.com/@popperjs/core@2"></script>
    <script src="https://unpkg.com/tippy.js@6"></script>

    <script src="{{ url_for('static', filename='js/layout.js') }}"></script>
    <script src="{{ url_for('static', filename='js/common.js') }}"></script>

    {% block extra_js %}{% endblock %}

    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    {% if current_user.is_authenticated and current_user.role in ['admin', 'jefe_obra'] %}
    <div class="modal fade admin-note-modal" id="modalNuevaNota" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title mb-0" id="modalNuevaNotaTitle"><i class="fas fa-pen-alt mr-2"></i>Redactar nota / reunión</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <form id="formNuevaNota">
                        <input type="hidden" name="nota_id" id="notaGlobalId" value="">
                        <div class="row">
                            <div class="col-md-8 form-group">
                                <label class="form-label-sm" for="notaGlobalTitulo">Título</label>
                                <input type="text" class="form-control" id="notaGlobalTitulo" name="titulo" required placeholder="Ej. Visita obra Edificio Sur…">
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="form-label-sm" for="notaGlobalFecha">Fecha</label>
                                <input type="date" class="form-control" name="fecha" id="notaGlobalFecha" required>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label class="form-label-sm" for="globalSelectObras"><i class="fas fa-hard-hat mr-1"></i> Obras implicadas</label>
                                <select class="form-control select2-modal" name="obras_ids[]" multiple="multiple" id="globalSelectObras" style="width: 100%;"></select>
                            </div>
                            <div class="col-md-6 form-group">
                                <label class="form-label-sm" for="globalSelectUsers"><i class="fas fa-users mr-1"></i> Personas implicadas</label>
                                <select class="form-control select2-modal" name="users_ids[]" multiple="multiple" id="globalSelectUsers" style="width: 100%;"></select>
                            </div>
                        </div>

                        <div class="form-group mb-0">
                            <label class="form-label-sm" for="notaGlobalContenido">Contenido</label>
                            <textarea class="form-control note-content-area" id="notaGlobalContenido" name="contenido" rows="5" required placeholder="Escribe aquí los detalles…" style="min-height:140px;"></textarea>
                        </div>

                        <div class="custom-control custom-switch mt-3">
                            <input type="checkbox" class="custom-control-input" id="esPrivadaSwitch" name="es_privada" value="true">
                            <label class="custom-control-label privacy-switch-label" for="esPrivadaSwitch">
                                <i class="fas fa-lock text-warning mr-1"></i> Nota privada
                                <span class="text-muted font-weight-normal small">(solo tú podrás verla)</span>
                            </label>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-admin btn-admin-ghost" data-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn-admin btn-admin-primary" onclick="guardarNotaGlobal()">
                        <i class="fas fa-save mr-1"></i> Guardar nota
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function() {
            // Poner la fecha de hoy por defecto
            let dateInput = document.getElementById('notaGlobalFecha');
            if(dateInput) dateInput.valueAsDate = new Date();
            
            // Inicializar Select2 en el modal
            $('#globalSelectObras').select2({ placeholder: "Buscar obras...", allowClear: true, dropdownParent: $('#modalNuevaNota'), dropdownCssClass: 'admin-select2-dropdown' });
            $('#globalSelectUsers').select2({ placeholder: "Buscar operarios/jefes...", allowClear: true, dropdownParent: $('#modalNuevaNota'), dropdownCssClass: 'admin-select2-dropdown' });

            // Cargar datos reales de Obras y Personas SIEMPRE
            fetch("{{ url_for('api_v6.recursos_activos') }}")
                .then(res => res.json())
                .then(data => {
                    $('#globalSelectObras').empty();
                    $('#globalSelectUsers').empty();
                    
                    data.obras.forEach(o => {
                        $('#globalSelectObras').append(new Option(o.text, o.id, false, false));
                    });
                    data.users.forEach(u => {
                        $('#globalSelectUsers').append(new Option(u.text, u.id, false, false));
                    });
                })
                .catch(err => console.error("Error cargando datos del modal:", err));
        });

        function guardarNotaGlobal() {
            let form = document.getElementById('formNuevaNota');
            if(!form.checkValidity()) { form.reportValidity(); return; }

            let notaId = document.getElementById('notaGlobalId').value;
            let url = notaId ? `/notas/${notaId}/editar` : '/notas/crear'; // Decide si crea o actualiza

            let formData = new FormData(form);
            fetch(url, { method: 'POST', body: formData })
            .then(r => r.json()).then(data => {
                if(data.success) {
                    $('#modalNuevaNota').modal('hide');
                    if (window.location.pathname.includes('/notas')) window.location.reload();
                    else alert(notaId ? "Nota actualizada." : "Nota guardada."); 
                } else {
                    alert("Error: " + data.message);
                }
            });
        }

        // NUEVA FUNCIÓN: Carga los datos de la base de datos al pulsar "Editar"
        function editarNotaModal(id) {
            fetch(`/notas/${id}/datos`)
            .then(res => res.json())
            .then(data => {
                if(!data.success) return alert("Error: " + data.message);
                
                document.getElementById('notaGlobalId').value = data.id;
                document.getElementById('notaGlobalTitulo').value = data.titulo;
                document.getElementById('notaGlobalFecha').value = data.fecha;
                document.getElementById('notaGlobalContenido').value = data.contenido;
                document.getElementById('esPrivadaSwitch').checked = data.es_privada;
                
                // Setear selects
                $('#globalSelectObras').val(data.obras_ids).trigger('change');
                $('#globalSelectUsers').val(data.users_ids).trigger('change');
                
                // Cambiar títulos para que quede claro que estamos editando
                document.getElementById('modalNuevaNotaTitle').innerHTML = '<i class="fas fa-edit mr-2"></i>Editar nota';
                
                $('#modalNuevaNota').modal('show');
            });
        }

        // Resetear el modal al cerrarlo para que "Nueva Nota" esté limpia
        $('#modalNuevaNota').on('hidden.bs.modal', function () {
            document.getElementById('formNuevaNota').reset();
            document.getElementById('notaGlobalId').value = '';
            document.getElementById('notaGlobalFecha').valueAsDate = new Date();
            $('#globalSelectObras').val(null).trigger('change');
            $('#globalSelectUsers').val(null).trigger('change');
            document.getElementById('modalNuevaNotaTitle').innerHTML = '<i class="fas fa-pen-alt mr-2"></i>Redactar nota / reunión';
        });
    </script>
    {% endif %}
    
</body>
</html>

===== ./templates/gestion_operario_form.html =====

{% extends "base.html" %}
{% block title %}{% if edit_mode %}Editar Usuario{% else %}Nuevo Usuario{% endif %}{% endblock %}
{% block body_class %}layout-admin{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/admin_layout.css') }}">
{% endblock %}

{% block wrapper %}
<div class="admin-shell">
  {% include "_admin_sidebar.html" %}

  <main class="admin-main admin-main--compact admin-form-page">

    <div class="page-toolbar">
      <div class="page-toolbar-left">
        <a href="{{ cancel_url }}" class="btn-admin btn-admin-ghost" style="padding: 0.25rem 0.5rem;">
          <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="page-toolbar-title">{% if edit_mode %}Editar persona{% else %}Nueva persona{% endif %}</h1>
      </div>
    </div>

    <section class="admin-panel admin-form-panel">
      <div class="admin-panel-header">
        {% if edit_mode %}
          <h2 class="admin-panel-title">{{ user.name }} {{ user.lastname }}</h2>
          <span class="admin-panel-subtitle">{{ user.email }}</span>
        {% else %}
          <h2 class="admin-panel-title">Nuevo usuario</h2>
          <span class="admin-panel-subtitle">Complete la información del personal</span>
        {% endif %}
      </div>

      <form action="{{ action_url }}" method="POST">

        <div class="admin-form-section">Datos de cuenta</div>
        <div class="form-row">
          <div class="form-group col-md-6">
            <label class="admin-form-label">Email</label>
            <input type="email" name="email" class="form-control" value="{{ user.email if edit_mode else '' }}" required>
          </div>
          {% if not edit_mode %}
          <div class="form-group col-md-6">
            <label class="admin-form-label">Contraseña</label>
            <input type="password" name="password" class="form-control" required>
          </div>
          {% endif %}
        </div>

        <div class="form-group">
          <label class="admin-form-label">Rol de sistema</label>
          <select name="role" class="form-control custom-select" required>
            <option value="operario" {% if edit_mode and user.role == 'operario' %}selected{% endif %}>Operario</option>
            <option value="jefe_obra" {% if edit_mode and user.role == 'jefe_obra' %}selected{% endif %}>Jefe de obra</option>
            <option value="rrhh" {% if edit_mode and user.role == 'rrhh' %}selected{% endif %}>RRHH / Administrativo</option>
            <option value="admin" {% if edit_mode and user.role == 'admin' %}selected{% endif %}>Administrador</option>
          </select>
          <small class="form-text text-muted" style="font-size: 0.72rem;">Define los permisos de acceso a la plataforma.</small>
        </div>

        <div class="admin-form-section">Información personal</div>
        <div class="form-row">
          <div class="form-group col-md-6">
            <label class="admin-form-label">Nombre</label>
            <input type="text" name="name" class="form-control" value="{% if edit_mode %}{{ user.name }}{% endif %}" required>
          </div>
          <div class="form-group col-md-6">
            <label class="admin-form-label">Apellidos</label>
            <input type="text" name="lastname" class="form-control" value="{% if edit_mode %}{{ user.lastname }}{% endif %}" required>
          </div>
        </div>
        <div class="form-group" style="max-width: 220px;">
          <label class="admin-form-label">DNI / NIE</label>
          <input type="text" name="dni" class="form-control" value="{% if edit_mode %}{{ user.dni }}{% endif %}" required>
        </div>

        <div class="admin-form-section">Perfil profesional</div>
        <div class="form-row">
          <div class="form-group col-md-6">
            <label class="admin-form-label">Categoría (nómina)</label>
            <input type="text" name="categoria_profesional" class="form-control" placeholder="Ej: Oficial 1ª" value="{{ user.categoria_profesional or '' }}">
          </div>
          <div class="form-group col-md-6">
            <label class="admin-form-label">Especialidad (oficio)</label>
            <input type="text" name="especialidad" class="form-control" placeholder="Ej: Electricista" value="{{ user.especialidad or '' }}">
          </div>
        </div>

        <div class="admin-form-section">Afiliación</div>
        <div class="form-group">
          <label class="admin-form-label">Empresa</label>
          <select name="company_id" class="form-control custom-select" required>
            <option value="">— Seleccione empresa —</option>
            {% for company in companies %}
              <option value="{{ company.id }}" {% if edit_mode and user.company_id == company.id %}selected{% endif %}>
                {{ company.nombre }}
              </option>
            {% endfor %}
          </select>
        </div>

        <div class="admin-form-options">
          <div class="admin-form-switch-row mb-2">
            <label class="admin-form-switch">
              <input type="checkbox" id="activeCheck" name="active" {% if edit_mode and user.active %}checked{% endif %}>
              <span class="slider"></span>
            </label>
            <div>
              <p class="admin-form-switch-label">Usuario activo</p>
              <p class="admin-form-switch-hint">Puede ser asignado a obras</p>
            </div>
          </div>
          <div class="admin-form-switch-row">
            <label class="admin-form-switch">
              <input type="checkbox" id="receiveEmailsCheck" name="receive_emails"
                {% if edit_mode and user.receive_emails %}checked{% elif not edit_mode %}checked{% endif %}>
              <span class="slider"></span>
            </label>
            <div>
              <p class="admin-form-switch-label">Notificaciones por email</p>
              <p class="admin-form-switch-hint">Recibir avisos de asignaciones y cambios</p>
            </div>
          </div>
        </div>

        <div class="admin-form-actions">
          <div></div>
          <div class="admin-form-actions-right">
            <a href="{{ cancel_url }}" class="btn-admin-link">Cancelar</a>
            <button type="submit" class="btn-admin btn-admin-primary">
              <i class="fas fa-save"></i>
              {% if edit_mode %}Guardar{% else %}Crear usuario{% endif %}
            </button>
          </div>
        </div>
      </form>
    </section>
  </main>
</div>
{% endblock %}


