===== ./utils/header_utils.py =====

from datetime import date, timedelta
import calendar
from app.models import Asignacion, User, ROLE_OPERARIO
from sqlalchemy import func

def get_header_day_data(year, month, selected_date_obj):
    """
    Genera una lista de diccionarios para cada día del mes.
    Cada día contiene:
    - date_str: 'YYYY-MM-DD'
    - day_num: 1, 2, 3...
    - weekday: 'LUN', 'MAR'...
    - free_count: Nº libres
    - ins: Nº personas que EMPIEZAN asignación ese día
    - outs: Nº personas que TERMINAN asignación el día anterior
    - is_selected: True si coincide con selected_date_obj
    """
    _, last_day = calendar.monthrange(year, month)
    header_days = []
    
    # Total activos base
    total_active = User.query.filter_by(role=ROLE_OPERARIO, active=True, is_deleted=False).count()

    # Pre-cargar todas las asignaciones del mes para no hacer 30 queries
    start_month = date(year, month, 1)
    end_month = date(year, month, last_day)
    
    # Query optimizada: obtener todas las tuplas (fecha, user_id)
    raw_assignments = Asignacion.query.filter(
        Asignacion.fecha.between(start_month - timedelta(days=1), end_month)
    ).with_entities(Asignacion.fecha, Asignacion.user_id).all()
    
    # Mapa: fecha -> set(user_ids)
    assignments_map = {}
    for d, uid in raw_assignments:
        assignments_map.setdefault(d, set()).add(uid)

    days_es = ['DOM','LUN','MAR','MIÉ','JUE','VIE','SÁB']

    for day in range(1, last_day + 1):
        current_dt = date(year, month, day)
        prev_dt = current_dt - timedelta(days=1)
        
        users_today = assignments_map.get(current_dt, set())
        users_prev = assignments_map.get(prev_dt, set())
        
        # Cálculos
        free_count = total_active - len(users_today)
        if free_count < 0: free_count = 0 # Por seguridad
        
        # Entradas: Hoy están, ayer no estaban
        ins = len(users_today - users_prev)
        
        # Salidas: Ayer estaban, hoy no están
        outs = len(users_prev - users_today)
        
        # Weekday ajuste (Python 0=Lunes, mi array 0=Domingo requiere ajuste)
        wd_idx = (current_dt.weekday() + 1) % 7 
        
        header_days.append({
            'date_str': current_dt.strftime('%Y-%m-%d'),
            'date_human': current_dt.strftime('%d/%m/%Y'),
            'day_num': day,
            'weekday': days_es[wd_idx],
            'free_count': free_count,
            'ins': ins,
            'outs': outs,
            'is_selected': (current_dt == selected_date_obj)
        })
        
    return header_days

===== ./utils/timezone_utils.py =====

# app/utils/timezone_utils.py
#
# Convención del proyecto:
#   - Los DateTime en BD se almacenan como naive UTC.
#   - La visualización convierte UTC → zona del usuario (o la global si no tiene).
#   - La lógica de negocio ("hoy", cortes horarios) usa la zona global de la app.

from datetime import datetime, date, timezone
from functools import lru_cache
from zoneinfo import ZoneInfo, available_timezones

DEFAULT_TIMEZONE = 'Europe/Madrid'
CONFIG_KEY_TIMEZONE = 'zona_horaria'

COMMON_TIMEZONES = [
    ('Europe/Madrid', 'España peninsular (CET/CEST)'),
    ('Atlantic/Canary', 'Islas Canarias'),
    ('Europe/Lisbon', 'Portugal'),
    ('Europe/London', 'Reino Unido'),
    ('Europe/Paris', 'Francia'),
    ('Europe/Berlin', 'Alemania'),
    ('Europe/Rome', 'Italia'),
    ('America/Mexico_City', 'México (Ciudad de México)'),
    ('America/Bogota', 'Colombia'),
    ('America/Argentina/Buenos_Aires', 'Argentina'),
    ('America/Santiago', 'Chile'),
    ('UTC', 'UTC (sin desplazamiento)'),
]


def _safe_zone(name):
    try:
        ZoneInfo(name)
        return name
    except Exception:
        return DEFAULT_TIMEZONE


@lru_cache(maxsize=1)
def get_app_timezone():
    """Zona horaria global de la aplicación (lógica de negocio y fichajes)."""
    try:
        from app.models import ConfiguracionGlobal
        conf = ConfiguracionGlobal.query.filter_by(clave=CONFIG_KEY_TIMEZONE).first()
        if conf and conf.valor:
            return _safe_zone(conf.valor.strip())
    except Exception:
        pass
    return DEFAULT_TIMEZONE


def invalidate_app_timezone_cache():
    get_app_timezone.cache_clear()


def get_user_timezone(user=None):
    """Zona horaria efectiva para visualización."""
    try:
        from flask_login import current_user
        u = user or (current_user if current_user.is_authenticated else None)
        if u and getattr(u, 'timezone', None):
            return _safe_zone(u.timezone)
    except Exception:
        pass
    return get_app_timezone()


def utc_now():
    """Hora actual en UTC naive (para persistir en BD)."""
    return datetime.now(timezone.utc).replace(tzinfo=None)


def now_in_tz(tz_name):
    """Hora actual naive en una zona concreta."""
    return datetime.now(ZoneInfo(tz_name)).replace(tzinfo=None)


def now_local():
    """Hora actual naive en la zona global de la app (cortes, ausencias)."""
    return now_in_tz(get_app_timezone())


def today_local():
    """Fecha de hoy según la zona global de la app."""
    return now_local().date()


def utc_to_local(dt, user=None):
    """Convierte datetime naive UTC → naive en zona del usuario."""
    if dt is None:
        return None
    tz = get_user_timezone(user)
    aware = dt.replace(tzinfo=timezone.utc)
    return aware.astimezone(ZoneInfo(tz)).replace(tzinfo=None)


def local_to_utc(dt, tz_name=None):
    """Convierte datetime naive en zona dada → naive UTC."""
    if dt is None:
        return None
    tz = tz_name or get_app_timezone()
    aware = dt.replace(tzinfo=ZoneInfo(tz))
    return aware.astimezone(timezone.utc).replace(tzinfo=None)


def parse_odoo_datetime(dt_str):
    """
    Odoo envía timestamps en UTC. Devuelve naive UTC para almacenar en BD.
    """
    if not dt_str:
        return None
    try:
        dt_utc = datetime.strptime(dt_str, '%Y-%m-%d %H:%M:%S').replace(tzinfo=timezone.utc)
        return dt_utc.replace(tzinfo=None)
    except ValueError:
        return None


def format_datetime(dt, fmt='%d/%m/%Y %H:%M', user=None):
    """Formatea un datetime UTC de BD en la zona horaria del usuario."""
    if dt is None:
        return ''
    local_dt = utc_to_local(dt, user)
    return local_dt.strftime(fmt)


def format_time(dt, user=None):
    return format_datetime(dt, '%H:%M', user)


def format_date(dt, fmt='%d/%m/%Y', user=None):
    if dt is None:
        return ''
    if isinstance(dt, date) and not isinstance(dt, datetime):
        return dt.strftime(fmt)
    local_dt = utc_to_local(dt, user)
    return local_dt.strftime(fmt)


def timezone_label(tz_name):
    for code, label in COMMON_TIMEZONES:
        if code == tz_name:
            return label
    return tz_name


def is_valid_timezone(tz_name):
    return tz_name in available_timezones()


