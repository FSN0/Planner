                <div class="admin-panel-header border-bottom pb-3 mb-3">
                    <h2 class="admin-panel-title">Gestión de Personal</h2>
                </div>
                <p class="text-muted small">Accede al listado completo para validar documentos, editar datos personales o procesar bajas.</p>
                <a href="{{ url_for('admin.personal', tab='operarios') }}" class="btn btn-primary btn-block">
                    <i class="fas fa-users mr-2"></i> Ir al Directorio de Personal
