"""Estadísticas y contexto para el panel de sincronización Odoo."""
import os
from datetime import timedelta

from sqlalchemy import func

from app import db
from app.models import Obra, User, Company, SyncLog, RegistroFichaje
from app.services.sync_config_service import SyncConfigService, SYNC_MODULES
from app.utils.timezone_utils import utc_now, today_local


def _last_log_for_tipo(tipo_prefix):
    return (
        SyncLog.query.filter(SyncLog.tipo.like(f'{tipo_prefix}%'))
        .order_by(SyncLog.fecha.desc())
        .first()
    )


def _stats_for_period(days=7):
    since = utc_now() - timedelta(days=days)
    logs = SyncLog.query.filter(SyncLog.fecha >= since).all()
    total_runs = len(logs)
    errors = sum(1 for l in logs if (getattr(l, 'estado', None) or 'ok') == 'error')
    partial = sum(1 for l in logs if (getattr(l, 'estado', None) or 'ok') == 'parcial')
    ok = sum(1 for l in logs if (getattr(l, 'estado', None) or 'ok') == 'ok')
    skipped = sum(l.errores or 0 for l in logs)
    nuevos = sum(l.nuevos or 0 for l in logs)
    actualizados = sum(l.actualizados or 0 for l in logs)
    return {
        'total_runs': total_runs,
        'ok': ok,
        'errors': errors,
        'partial': partial,
        'skipped_records': skipped,
        'nuevos': nuevos,
        'actualizados': actualizados,
    }


def test_odoo_connection():
    try:
        from app.services.sync_service import OdooSyncService
        svc = OdooSyncService()
        return {
            'connected': True,
            'url': os.environ.get('ODOO_URL', ''),
            'db': os.environ.get('ODOO_DB', ''),
            'uid': svc.uid,
            'message': 'Conexión XML-RPC establecida correctamente.',
        }
    except Exception as e:
        return {
            'connected': False,
            'url': os.environ.get('ODOO_URL', ''),
            'db': os.environ.get('ODOO_DB', ''),
            'uid': None,
            'message': str(e),
        }


def get_recent_sync_alerts():
    """Errores críticos + un único resumen por módulo (sin repetir cada ejecución)."""
    critical = (
        SyncLog.query.filter(SyncLog.estado == 'error')
        .order_by(SyncLog.fecha.desc())
        .limit(5)
        .all()
    )

    seen = set()
    partial_summaries = []
    for log in (
        SyncLog.query.filter(
            db.or_(SyncLog.estado == 'parcial', SyncLog.errores > 0)
        )
        .order_by(SyncLog.fecha.desc())
        .limit(80)
        .all()
    ):
        if log.tipo in seen:
            continue
        if (log.errores or 0) > 0 or (getattr(log, 'estado', None) or '') == 'parcial':
            seen.add(log.tipo)
            partial_summaries.append(log)
        if len(partial_summaries) >= 4:
            break

    return critical, partial_summaries


def get_sync_panel_context():
    cfg = SyncConfigService.get_config()
    conn = test_odoo_connection()
    stats_7d = _stats_for_period(7)
    stats_30d = _stats_for_period(30)

    today = today_local()
    fichajes_hoy = RegistroFichaje.query.filter(RegistroFichaje.fecha == today).count()
    incidencias_pendientes = RegistroFichaje.query.filter(
        RegistroFichaje.estado.in_(['Conflicto', 'Paracaidista', 'Ausencia'])
    ).count()

    entity_counts = {
        'obras_vinculadas': Obra.query.filter(Obra.odoo_id.isnot(None)).count(),
        'obras_total': Obra.query.count(),
        'empleados_vinculados': User.query.filter(User.odoo_id.isnot(None), User.is_deleted == False).count(),
        'empleados_total': User.query.filter(User.is_deleted == False).count(),
        'empresas_vinculadas': Company.query.filter(Company.odoo_id.isnot(None)).count(),
        'empresas_total': Company.query.count(),
    }

    modules = []
    for mod in SYNC_MODULES:
        last = _last_log_for_tipo(mod['tipo_log'])
        if mod['key'] == 'fichajes':
            schedule = SyncConfigService.format_fichajes_schedule(cfg)
            enabled = cfg['fichajes_enabled']
            next_run = SyncConfigService.estimate_next_fichajes(cfg)
        else:
            schedule = SyncConfigService.format_master_schedule(cfg)
            enabled = cfg.get(f"{mod['key']}_enabled", True)
            next_run = SyncConfigService.estimate_next_master(cfg)

        modules.append({
            **mod,
            'enabled': enabled,
            'schedule': schedule,
            'last_log': last,
            'next_run': next_run,
        })

    critical_errors, partial_summaries = get_recent_sync_alerts()

    logs = SyncLog.query.order_by(SyncLog.fecha.desc()).limit(50).all()

    return {
        'config': cfg,
        'connection': conn,
        'stats_7d': stats_7d,
        'stats_30d': stats_30d,
        'entity_counts': entity_counts,
        'modules': modules,
        'fichajes_hoy': fichajes_hoy,
        'incidencias_pendientes': incidencias_pendientes,
        'critical_errors': critical_errors,
        'partial_summaries': partial_summaries,
        'logs': logs,
    }


===== ./services/email_service.py =====

# app/services/email_service.py
from flask_mail import Message
from flask import current_app
from app import mail
from app.models import User, Obra, RegistroFichaje, ConfiguracionGlobal
from datetime import datetime, date, timedelta

def send_email(subject, recipients, text_body, html_body=None):
    """Función genérica para enviar correos usando Flask-Mail"""
    if not recipients:
        return
    msg = Message(subject, sender=current_app.config.get('MAIL_DEFAULT_SENDER'), recipients=recipients)
    msg.body = text_body
    if html_body:
        msg.html = html_body
    try:
        mail.send(msg)
    except Exception as e:
        print(f"Error enviando correo a {recipients}: {e}")

def _obtener_destinatarios(evento_clave, obra_id=None, worker_id=None):
    """
    Función maestra que lee la Matriz de Configuración.
    Busca los correos de Admin, Jefe y Trabajador solo si están marcados (tick) en la BD.
    Sin filtros de silencio: si está tickado, se envía siempre.
    """
    conf = ConfiguracionGlobal.query.filter_by(clave=evento_clave).first()
    if not conf or not conf.valor:
        return [] # Nadie suscrito a este evento
        
    suscritos = conf.valor.split(',') # Ej: ['admin', 'jefe', 'trabajador']
    correos = []
    
    if 'admin' in suscritos:
        admins = User.query.filter_by(role='admin', active=True).all()
        correos.extend([a.email for a in admins if a.email])
        
    if 'jefe' in suscritos and obra_id:
        obra = Obra.query.get(obra_id)
        if obra and obra.jefe_obra_id:
            jefe = User.query.get(obra.jefe_obra_id)
            if jefe and jefe.email: correos.append(jefe.email)
            
    if 'trabajador' in suscritos and worker_id:
        worker = User.query.get(worker_id)
        if worker and worker.email: correos.append(worker.email)
        
    # Eliminamos duplicados (por si un admin también es jefe de esa obra)
    return list(set(correos))

def notificar_nueva_solicitud(solicitud, solicitante_name):
    """Notifica la creación de una solicitud (Genérica o Concreta)"""
    clave = 'email_sol_generica' if solicitud.tipo == 'GENERICA' else 'email_sol_concreta'
    destinatarios = _obtener_destinatarios(clave, obra_id=solicitud.obra_id, worker_id=solicitud.empleado_id)
    if not destinatarios: return

    obra = Obra.query.get(solicitud.obra_id)
    
    # Obtener nombre completo del Jefe y saber si es Baja
    jefe = User.query.get(solicitud.requested_by_id)
    nombre_jefe = f"{jefe.name} {jefe.lastname}" if jefe else solicitante_name
    tipo_solic = "baja de personal" if getattr(solicitud, 'accion', '') == 'DESASIGNAR' else "personal"

    asunto = f"NUEVA SOLICITUD DE {tipo_solic.upper()} - {obra.nombre}"
    
    texto = (
        f"El Jefe de Obra {nombre_jefe} ha creado una nueva solicitud de {tipo_solic}.\n\n"
        f"Obra: {obra.nombre}\n"
    )
    if solicitud.tipo == 'CONCRETA':
        worker = User.query.get(solicitud.empleado_id)
        if worker:
            texto += f"Trabajador Solicitado: {worker.name} {worker.lastname}\n"
    else:
        texto += f"Perfil Solicitado: {solicitud.perfil_categoria} (Cant: {solicitud.cantidad_solicitada})\n"
        
    texto += f"Fechas: {solicitud.fecha_inicio.strftime('%d/%m/%Y')} al {solicitud.fecha_fin.strftime('%d/%m/%Y')}\n"

    from app.services.solicitud_service import get_solicitud_notas
    notas = get_solicitud_notas(solicitud)
    if notas:
        texto += f"\nNotas del solicitante:\n{notas}\n"

    texto += "\nPor favor, entra en la plataforma para revisarla y gestionarla."
    
    send_email(asunto, destinatarios, texto)

def notificar_resolucion_solicitud(solicitud, admin_name, worker_id=None):
    """Notifica cuando una solicitud cambia de estado (Aprobada, Denegada, etc.)"""
    # Usamos el worker_id si lo hay, o el de la solicitud
    id_trabajador = solicitud.empleado_id or worker_id
    
    destinatarios = _obtener_destinatarios('email_sol_resuelta', obra_id=solicitud.obra_id, worker_id=id_trabajador)
    if not destinatarios: return

    obra = Obra.query.get(solicitud.obra_id)
    asunto = f"Resolución de solicitud #{solicitud.id} - {obra.nombre}"
    
    texto = (
        f"La solicitud para la obra {obra.nombre} ha sido resuelta por {admin_name}.\n\n"
        f"Estado: {solicitud.estado}\n"
        f"Acción solicitada: {getattr(solicitud, 'accion', 'ASIGNAR')}\n"
    )
    
    # AQUÍ PONEMOS EL NOMBRE Y LA EMPRESA SIN IMPORTAR SI ES CONCRETA O GENÉRICA
    if id_trabajador:
        worker = User.query.get(id_trabajador)
        if worker:
            empresa = worker.company_rel.nombre if worker.company_rel else "Sin empresa"
            texto += f"Trabajador movido: {worker.name} {worker.lastname}\n"
            texto += f"Empresa: {empresa}\n"
            
    texto += f"Fechas: {solicitud.fecha_inicio.strftime('%d/%m/%Y')} al {solicitud.fecha_fin.strftime('%d/%m/%Y')}\n\n"
    texto += f"Revisa la plataforma para más detalles."
    
    send_email(asunto, destinatarios, texto)

def notificar_traslado_interno(jefe_name, worker, target_obra, dates, obras_origen=None):
    """Notifica cuando un Jefe mueve a un operario por custodia entre sus obras"""
    destinatarios = _obtener_destinatarios('email_traslado', obra_id=target_obra.id, worker_id=worker.id)
    if not destinatarios: return
    
    if len(dates) > 1:
        fecha_str = f"Desde el {min(dates).strftime('%d/%m/%Y')} hasta el {max(dates).strftime('%d/%m/%Y')}"
    else:
        fecha_str = f"El {dates[0].strftime('%d/%m/%Y')}"

    # Buscar el nombre completo del jefe
    jefe_obj = User.query.filter(User.name.like(f"%{jefe_name.split()[0]}%")).first()
    nombre_jefe_completo = f"{jefe_obj.name} {jefe_obj.lastname}" if jefe_obj else jefe_name

    # Diferenciamos si es Traslado o Extensión
    if obras_origen:
        asunto = f"Aviso: Traslado de Personal - {nombre_jefe_completo}"
        texto = (
            f"El Jefe de Obra {nombre_jefe_completo} ha realizado un traslado entre sus obras.\n\n"
            f"Trabajador movido: {worker.name} {worker.lastname}\n\n"
            f"Obra origen: {', '.join(obras_origen)}\n"
            f"Fechas origen: {fecha_str}\n\n"
            f"Obra Destino: {target_obra.nombre}\n"
            f"Fechas: {fecha_str}\n\n"
            f"Este movimiento ha sido auto-aprobado por el sistema ya que se disponía de custodia activa sobre el trabajador."
        )
    else:
        asunto = f"Aviso: Extensión de Personal - {nombre_jefe_completo}"
        texto = (
            f"El Jefe de Obra {nombre_jefe_completo} ha realizado una extensión de personal.\n\n"
            f"Trabajador movido: {worker.name} {worker.lastname}\n"
            f"Obra Destino: {target_obra.nombre}\n"
            f"Fechas: {fecha_str}\n\n"
            f"Este movimiento ha sido auto-aprobado por el sistema ya que se disponía de custodia activa sobre el trabajador."
        )

    send_email(asunto, destinatarios, texto)

def notificar_movimiento_admin_a_jo(obra_id, worker_name, accion, fecha_str, admin_name):
    """Notifica cuando se asigna o desasigna personal directamente en el planificador"""
    is_baja = 'desasignar' in accion.lower() or 'baja' in accion.lower()
    clave = 'email_desasignacion' if is_baja else 'email_asignacion'
    
    worker_id = None
    if worker_name:
        worker = User.query.filter(User.name.like(f"%{worker_name.split()[0]}%")).first()
        if worker:
            worker_id = worker.id

    destinatarios = _obtener_destinatarios(clave, obra_id=obra_id, worker_id=worker_id)
    if not destinatarios: return

    obra = Obra.query.get(obra_id)
    asunto = f"Actualización de Personal - {obra.nombre}"
    texto = (
        f"El administrador {admin_name} ha realizado un movimiento en la obra ({obra.nombre}):\n\n"
        f"Acción: {accion.upper()}\n"
        f"Operario: {worker_name}\n"
        f"Fecha/s afectada(s): {fecha_str}\n\n"
        f"Revisa el planificador para ver los detalles."
    )
    send_email(asunto, destinatarios, texto)


def enviar_super_reporte_diario():
    """
    Sustituye a 'notificar_auditoria_diaria_0830'.
    Manda correos agrupados a JO y Admins sobre ausencias de HOY y paracaidistas/conflictos de AYER.
    """
    from app.utils.timezone_utils import today_local
    hoy = today_local()
    ayer = hoy - timedelta(days=1)
    
    # 1. Ausencias tempranas de HOY
    ausencias_hoy = RegistroFichaje.query.filter_by(fecha=hoy, estado='Ausencia').all()
    
    # 2. Paracaidistas/Conflictos de AYER (por si en la BD guardas Paracaidista o Conflicto)
    conflictos_ayer = RegistroFichaje.query.filter(
        RegistroFichaje.fecha == ayer,
        RegistroFichaje.estado.in_(['Conflicto', 'Paracaidista'])
    ).all()

    if not ausencias_hoy and not conflictos_ayer:
        return 

    # ==========================================
    # CORREO GLOBAL PARA LOS ADMINISTRADORES
    # ==========================================
    admins = User.query.filter_by(role='admin', active=True).all()
    admin_emails = [a.email for a in admins if a.email]
    
    if admin_emails:
        asunto_admin = f"Alerta de Fichajes Global ({hoy.strftime('%d/%m/%Y')})"
        
        html_admin = f"""
        <div style="font-family: Arial, sans-serif; padding: 20px; color: #333;">
            <h2 style="color: #1d4ed8;">Reporte de Presencia y Fichajes 📋</h2>
            <p>Resumen automático generado en la hora de corte de entrada.</p>
            
            <h3 style="color: #dc2626; border-bottom: 1px solid #ddd; padding-bottom: 5px;">
                Ausencias Detectadas HOY ({hoy.strftime('%d/%m/%Y')}):
            </h3>
            <ul>
        """
        if ausencias_hoy:
            for a in ausencias_hoy:
                obra_nom = a.obra_planificada.nombre if a.obra_planificada else 'Obra Desconocida'
                html_admin += f"<li><b>{a.user.name} {a.user.lastname}</b> - Faltó en: {obra_nom}</li>"
        else:
            html_admin += "<li><i style='color: green;'>Todo el personal planificado ha fichado.</i></li>"
            
        html_admin += f"""
            </ul>
            <h3 style="color: #f59e0b; border-bottom: 1px solid #ddd; padding-bottom: 5px; margin-top: 20px;">
                Fichajes No Planificados AYER ({ayer.strftime('%d/%m/%Y')}):
            </h3>
            <ul>
        """
        
        if conflictos_ayer:
            for c in conflictos_ayer:
                obra_real = c.obra_real.nombre if c.obra_real else 'Desconocida'
                obra_plan = c.obra_planificada.nombre if c.obra_planificada else 'NINGUNA'
                html_admin += f"<li><b>{c.user.name} {c.user.lastname}</b> - Apareció en: {obra_real} (Estaba planificado en: {obra_plan})</li>"
        else:
            html_admin += "<li><i style='color: green;'>No hubo incidencias de paracaidistas ayer.</i></li>"
            
        html_admin += "</ul></div>"
            
        send_email(asunto_admin, admin_emails, "Contenido en HTML.", html_body=html_admin)

    # ==========================================
    # CORREOS ESPECÍFICOS PARA CADA JEFE DE OBRA
    # ==========================================
    obras_afectadas_ids = set(
        [a.obra_planificada_id for a in ausencias_hoy if a.obra_planificada_id] + 
        [c.obra_real_id for c in conflictos_ayer if c.obra_real_id]
    )
    
    for obra_id in obras_afectadas_ids:
        obra = Obra.query.get(obra_id)
        if not obra or not obra.jefe_obra or not obra.jefe_obra.email: continue
            
        aus_obra = [a for a in ausencias_hoy if a.obra_planificada_id == obra.id]
        con_obra = [c for c in conflictos_ayer if c.obra_real_id == obra.id]
        
        asunto_jo = f"Alerta de Personal - {obra.nombre} ({hoy.strftime('%d/%m/%Y')})"
        
        html_jo = f"""
        <div style="font-family: Arial, sans-serif; padding: 20px; color: #333;">
            <h3>Hola {obra.jefe_obra.name},</h3>
            <p>Incidencias detectadas en tu obra <b>{obra.nombre}</b> en la hora de corte:</p>
        """
        
        if aus_obra:
            html_jo += f"<h4 style='color: #dc2626;'>NO HAN FICHADO HOY ({hoy.strftime('%d/%m/%Y')}):</h4><ul>"
            for a in aus_obra: html_jo += f"<li>{a.user.name} {a.user.lastname}</li>"
            html_jo += "</ul>"
                
        if con_obra:
            html_jo += f"<h4 style='color: #f59e0b;'>FICHARON AYER ({ayer.strftime('%d/%m/%Y')}) SIN ESTAR PLANIFICADOS:</h4><ul>"
            for c in con_obra: html_jo += f"<li>{c.user.name} {c.user.lastname}</li>"
            html_jo += "</ul>"
            
        html_jo += "</div>"
            
        send_email(asunto_jo, [obra.jefe_obra.email], "Contenido en HTML.", html_body=html_jo)

===== ./services/person_day_timeline_service.py =====

# app/services/person_day_timeline_service.py
import re
from datetime import datetime, date

from flask import url_for
from markupsafe import Markup, escape

from app.models import User, SystemLog, RegistroFichaje, Obra
from app.services.core_assignment_service import CoreAssignmentService
from app.utils.timezone_utils import format_datetime, format_time

SYSTEM_ACTOR = "Sistema Automático"
SYSTEM_ACTIONS = {
    "Auto-asignación por Fichaje Físico",
    "Actualización de Cuadrante (Auto)",
}

format_obra_label = CoreAssignmentService.format_obra_label

CATEGORY_STYLES = {
    "fichaje_app": {"icon": "fa-mobile-alt", "color": "#0369a1"},
    "fichajes": {"icon": "fa-balance-scale", "color": "#6d28d9"},
    "planificacion": {"icon": "fa-calendar-check", "color": "#047857"},
    "default": {"icon": "fa-cog", "color": "#64748b"},
}

ACTION_TITLE_ALIASES = {
    "Resolución de Fichaje: Error al Planificar": "Borrar Planificación",
    "Resolución de Fichaje: Error Al Planificar": "Borrar Planificación",
    "Resolución de Fichaje: Borrar Planificacion": "Resolución de Fichaje: Borrar Planificación",
}

LEGACY_SHORT_FICHAJE_DETAILS = {
    "Ignorado",
    "Ausencia confirmada manualmente.",
    "Planificación eliminada (Error al planificar).",
    "Reasignado a la obra real",
    "Añadida multi-asignación (Pluriempleo).",
    "Añadida multi-asignación (pluriempleo).",
}


def _normalize_title(action):
    title = (action or "").strip()
    for prefix in ("📍 ", "📅 ", "⚖️ "):
        if title.startswith(prefix):
            title = title[len(prefix):]
    return ACTION_TITLE_ALIASES.get(title, title)


def _enrich_legacy_fichaje_detail(log, detail):
    if log.category != "fichajes" or not detail:
        return detail
    if detail not in LEGACY_SHORT_FICHAJE_DETAILS:
        if "Error al planificar" in detail:
            return detail.replace(" (Error al planificar)", "").replace(
                "(Error al planificar)", ""
            ).strip()
        return detail

    regs = RegistroFichaje.query.filter_by(
        user_id=log.target_user_id,
        fecha=log.target_date,
    ).filter(RegistroFichaje.resuelto_por_id.isnot(None)).all()

    if not regs:
        return detail.replace(" (Error al planificar)", "").strip()

    reg = regs[0]
    if len(regs) > 1 and log.timestamp:
        with_ts = [r for r in regs if r.fecha_auditoria]
        if with_ts:
            reg = min(
                with_ts,
                key=lambda r: abs((r.fecha_auditoria - log.timestamp).total_seconds()),
            )

    obra_real = format_obra_label(Obra.query.get(reg.obra_real_id)) if reg.obra_real_id else None
    obra_plan = (
        format_obra_label(Obra.query.get(reg.obra_planificada_id))
        if reg.obra_planificada_id
        else None
    )

    if detail == "Ignorado":
        if obra_real and obra_plan and obra_real != obra_plan:
            return (
                f"Se ignora el fichaje en '{obra_real}' "
                f"(estaba planificado en '{obra_plan}')."
            )
        if obra_real:
            return f"Se ignora el fichaje en '{obra_real}'."
        if obra_plan:
            return f"Se ignora la incidencia en '{obra_plan}'."
    elif detail == "Ausencia confirmada manualmente." and obra_plan:
        return f"Ausencia confirmada: no acudió a '{obra_plan}'."
    elif "Error al planificar" in detail:
        if obra_plan:
            return (
                f"Se elimina la planificación en '{obra_plan}' "
                f"(el operario no fichó en esa obra)."
            )
        return "Planificación eliminada."
    elif detail == "Reasignado a la obra real":
        if obra_plan and obra_real:
            return f"Cuadrante actualizado: de '{obra_plan}' a '{obra_real}'."
        if obra_real:
            return f"Reasignado a '{obra_real}'."
    elif "multi-asignación" in detail.lower() and obra_real:
        return f"Añadida asignación en '{obra_real}' (pluriempleo)."

    return detail


def _resolve_actor(log, user):
    action = log.action or ""
    if action in SYSTEM_ACTIONS or "(Auto)" in action:
        return SYSTEM_ACTOR
    if log.category == "fichaje_app":
        return f"{user.name} {user.lastname} (Fichaje en App)"
    if log.category == "planificacion" and "(Auto)" in action:
        return SYSTEM_ACTOR
    if log.user:
        return f"{log.user.name} {log.user.lastname}".strip()
    return "Sistema"


def _lookup_obra(fragment, cache):
    raw = (fragment or "").strip()
    if not raw:
        return None

    key = raw.lower()
    if key in cache:
        return cache[key]

    obra = None
    if "—" in raw:
        codigo_part = raw.split("—", 1)[0].strip()
        obra = Obra.query.filter(Obra.codigo.ilike(codigo_part)).first()

    if not obra:
        obra = Obra.query.filter(Obra.codigo.ilike(raw)).first()

    if not obra:
        obra = Obra.query.filter(Obra.nombre.ilike(raw)).first()

    if not obra and len(raw) > 3:
        obra = Obra.query.filter(Obra.nombre.ilike(f"%{raw}%")).first()

    cache[key] = obra
    return obra


def _obra_label_for_fragment(fragment, cache):
    obra = _lookup_obra(fragment, cache)
    return format_obra_label(obra) if obra else fragment.strip()


def _normalize_detail_obras(text, cache):
    if not text:
        return text

    def repl_ficho(match):
        label = _obra_label_for_fragment(match.group(1), cache)
        return f"fichó en {label}."

    text = re.sub(r"fichó en ([^.]+)\.", repl_ficho, text, flags=re.IGNORECASE)

    def repl_arrow(match):
        label = _obra_label_for_fragment(match.group(1), cache)
        return f"→ '{label}'"

    text = re.sub(r"→ '([^']+)'", repl_arrow, text)

    def repl_en_quoted(match):
        prefix = match.group(1)
        label = _obra_label_for_fragment(match.group(2), cache)
        return f"{prefix}'{label}'"

    text = re.sub(
        r"(sin planificar en |en )'([^']+)'",
        repl_en_quoted,
        text,
        flags=re.IGNORECASE,
    )

    return text


def _utc_time_label_to_local(hm, target_date):
    """Convierte HH:MM guardado en UTC (texto de logs antiguos) a hora local."""
    if not hm or not target_date:
        return hm
    try:
        t = datetime.strptime(hm, "%H:%M").time()
        dt_utc = datetime.combine(target_date, t)
        return format_time(dt_utc)
    except ValueError:
        return hm


def _fichaje_detail_uses_utc(text, target_date, log_timestamp):
    """Detecta logs antiguos con Entrada/Salida en UTC (no en hora local)."""
    match = re.search(r"Entrada: (\d{2}:\d{2})", text or "")
    if not match or not log_timestamp:
        return False
    entrada = match.group(1)
    ts_local = format_datetime(log_timestamp, "%H:%M")
    if entrada == ts_local:
        return False
    return _utc_time_label_to_local(entrada, target_date) == ts_local


def _normalize_fichaje_times_in_detail(text, target_date, log_timestamp=None):
    if not text or not target_date:
        return text
    if not _fichaje_detail_uses_utc(text, target_date, log_timestamp):
        return text

    def repl_entrada(match):
        return f"Entrada: {_utc_time_label_to_local(match.group(1), target_date)}"

    def repl_salida(match):
        return f"Salida: {_utc_time_label_to_local(match.group(1), target_date)}"

    def repl_hora_detectada(match):
        return f"Hora detectada: {_utc_time_label_to_local(match.group(1), target_date)}"

    text = re.sub(r"Entrada: (\d{2}:\d{2})", repl_entrada, text)
    text = re.sub(r"Salida: (\d{2}:\d{2})", repl_salida, text)
    text = re.sub(r"Hora detectada: (\d{2}:\d{2})", repl_hora_detectada, text)
    return text


def _worker_panel_url(user_id):
    if not user_id:
        return None
    return url_for("admin.worker_panel", user_id=user_id)


def _obra_panel_url(obra_id):
    if not obra_id:
        return None
    return url_for("admin.obra_panel", obra_id=obra_id)


def _link_obras_in_text(text, obra_cache):
    if not text:
        return ""

    html = str(escape(text))
    linked_ids = set()

    for obra in obra_cache.values():
        if not obra or obra.id in linked_ids:
            continue
        linked_ids.add(obra.id)
        label = format_obra_label(obra)
        escaped_label = str(escape(label))
        if escaped_label not in html:
            continue
        obra_url = _obra_panel_url(obra.id)
        link = (
            f'<a href="{obra_url}" class="pdt-link pdt-link-obra" '
            f'target="_blank" rel="noopener" title="Ver obra">{escaped_label}</a>'
        )
        html = html.replace(escaped_label, link)

    return Markup(html)


def _link_subject_in_text(html, subject_user):
    if not subject_user:
        return html

    full_name = f"{subject_user.name} {subject_user.lastname}".strip()
    escaped_name = str(escape(full_name))
    html_str = str(html)
    if escaped_name not in html_str:
        return Markup(html_str)

    worker_url = _worker_panel_url(subject_user.id)
    link = (
        f'<a href="{worker_url}" class="pdt-link pdt-link-user" '
        f'target="_blank" rel="noopener" title="Ver ficha">{escaped_name}</a>'
    )
    return Markup(html_str.replace(escaped_name, link, 1))


def _append_fichaje_notes_from_registro(log, detail):
    """Añade notas Odoo al detalle del log si el registro local las tiene."""
    if log.category != 'fichaje_app' or not detail or 'Notas:' in detail:
        return detail
    if not log.target_user_id or not log.target_date:
        return detail

    regs = RegistroFichaje.query.filter_by(
        user_id=log.target_user_id,
        fecha=log.target_date,
    ).filter(RegistroFichaje.nota_odoo.isnot(None)).all()

    for reg in regs:
        note = (reg.nota_odoo or '').strip()
        if not note:
            continue
        obra = Obra.query.get(reg.obra_real_id) if reg.obra_real_id else None
        if not obra:
            continue
        label = format_obra_label(obra)
        codigo = (obra.codigo or '').strip()
        if label in detail or (codigo and codigo in detail):
            return f"{detail.rstrip('.')} Notas: {note}"
    return detail


def _build_detail_html(text, obra_cache, subject_user, target_date=None, log_timestamp=None, log=None):
    plain = _enrich_legacy_fichaje_detail(log, text or "") if log else (text or "")
    plain = _append_fichaje_notes_from_registro(log, plain) if log else plain
    plain = _normalize_detail_obras(plain, obra_cache)
    plain = _normalize_fichaje_times_in_detail(plain, target_date, log_timestamp)
    html = _link_obras_in_text(plain, obra_cache)
    return plain, _link_subject_in_text(html, subject_user)


def _category_style(log):
    if log.category == "fichaje_app":
        return CATEGORY_STYLES["fichaje_app"], 0
    if log.category == "fichajes":
        return CATEGORY_STYLES["fichajes"], 1
    if log.category == "planificacion":
        style = dict(CATEGORY_STYLES["planificacion"])
        if not (log.detail or "").startswith("Asignado"):
            style["icon"] = "fa-trash-alt"
        return style, 2
    return CATEGORY_STYLES["default"], 3


def _build_hito(log, user, obra_cache):
    detail, detail_html = _build_detail_html(
        log.detail, obra_cache, user, log.target_date, log.timestamp, log
    )
    style, prioridad = _category_style(log)
    autor = _resolve_actor(log, user)

    actor_user_id = None
    if autor != SYSTEM_ACTOR and log.user_id:
        actor_user_id = log.user_id
    elif log.category == "fichaje_app":
        actor_user_id = user.id

    local_ts = format_datetime(log.timestamp, "%Y-%m-%d %H:%M:%S")
    return {
        "id": log.id,
        "sort_time": local_ts,
        "prioridad": prioridad,
        "fecha": format_datetime(log.timestamp, "%d/%m %H:%M"),
        "icon_class": style["icon"],
        "icon_color": style["color"],
        "titulo": _normalize_title(log.action),
        "autor": autor,
        "actor_user_id": actor_user_id,
        "actor_url": _worker_panel_url(actor_user_id),
        "descripcion": detail,
        "descripcion_html": str(detail_html),
    }


def build_person_day_timeline(user_id, fecha_obj):
    user = User.query.get(user_id)
    if not user:
        return None

    if isinstance(fecha_obj, str):
        fecha_obj = datetime.strptime(fecha_obj, "%Y-%m-%d").date()
    elif isinstance(fecha_obj, datetime):
        fecha_obj = fecha_obj.date()

    logs_del_dia = (
        SystemLog.query.filter_by(target_user_id=user_id, target_date=fecha_obj)
        .order_by(SystemLog.timestamp.asc())
        .all()
    )

    obra_cache = {}
    hitos = [_build_hito(log, user, obra_cache) for log in logs_del_dia]
    hitos.sort(key=lambda x: (x["sort_time"], x["prioridad"]))

    if not hitos:
        hitos = [{
            "sort_time": "0000-00-00 00:00:00",
            "fecha": "--/-- --:--",
            "icon_class": "fa-ghost",
            "icon_color": "#94a3b8",
            "titulo": "Sin actividad",
            "autor": "-",
            "actor_user_id": None,
            "actor_url": None,
            "descripcion": "No hay ningún evento histórico registrado en el sistema para este día.",
            "descripcion_html": "No hay ningún evento histórico registrado en el sistema para este día.",
        }]

    registro = RegistroFichaje.query.filter_by(user_id=user_id, fecha=fecha_obj).first()
    if registro and registro.estado:
        estado_actual = registro.estado
    elif hitos and hitos[0].get("titulo") != "Sin actividad":
        estado_actual = "Actividad registrada"
    else:
        estado_actual = "Sin registro"

    return {
        "success": True,
        "empleado": f"{user.name} {user.lastname}",
        "empleado_url": _worker_panel_url(user.id),
        "target_user_id": user.id,
        "fecha": fecha_obj.strftime("%d/%m/%Y"),
        "fecha_iso": fecha_obj.strftime("%Y-%m-%d"),
        "estado_actual": estado_actual,
        "hitos": hitos,
    }


