    <p class="mis show_mis"><span class="n"><a id="t109" href="#t109">109</a></span><span class="t">    <span class="key">return</span> <span class="nam">redirect</span><span class="op">(</span><span class="nam">url_for</span><span class="op">(</span><span class="str">'superadmin.dashboard'</span><span class="op">)</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
