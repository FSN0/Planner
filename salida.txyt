    <p class="mis show_mis"><span class="n"><a id="t36" href="#t36">36</a></span><span class="t">        <span class="nam">correos</span><span class="op">.</span><span class="nam">extend</span><span class="op">(</span><span class="op">[</span><span class="nam">a</span><span class="op">.</span><span class="nam">email</span> <span class="key">for</span> <span class="nam">a</span> <span class="key">in</span> <span class="nam">admins</span> <span class="key">if</span> <span class="nam">a</span><span class="op">.</span><span class="nam">email</span><span class="op">]</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t37" href="#t37">37</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t38" href="#t38">38</a></span><span class="t">    <span class="key">if</span> <span class="str">'jefe'</span> <span class="key">in</span> <span class="nam">suscritos</span> <span class="key">and</span> <span class="nam">obra_id</span><span class="op">:</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t39" href="#t39">39</a></span><span class="t">        <span class="nam">obra</span> <span class="op">=</span> <span class="nam">Obra</span><span class="op">.</span><span class="nam">query</span><span class="op">.</span><span class="nam">get</span><span class="op">(</span><span class="nam">obra_id</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t40" href="#t40">40</a></span><span class="t">        <span class="key">if</span> <span class="nam">obra</span> <span class="key">and</span> <span class="nam">obra</span><span class="op">.</span><span class="nam">jefe_obra_id</span><span class="op">:</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t41" href="#t41">41</a></span><span class="t">            <span class="nam">jefe</span> <span class="op">=</span> <span class="nam">User</span><span class="op">.</span><span class="nam">query</span><span class="op">.</span><span class="nam">get</span><span class="op">(</span><span class="nam">obra</span><span class="op">.</span><span class="nam">jefe_obra_id</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t42" href="#t42">42</a></span><span class="t">            <span class="key">if</span> <span class="nam">jefe</span> <span class="key">and</span> <span class="nam">jefe</span><span class="op">.</span><span class="nam">email</span><span class="op">:</span> <span class="nam">correos</span><span class="op">.</span><span class="nam">append</span><span class="op">(</span><span class="nam">jefe</span><span class="op">.</span><span class="nam">email</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t43" href="#t43">43</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t44" href="#t44">44</a></span><span class="t">    <span class="key">if</span> <span class="str">'trabajador'</span> <span class="key">in</span> <span class="nam">suscritos</span> <span class="key">and</span> <span class="nam">worker_id</span><span class="op">:</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t45" href="#t45">45</a></span><span class="t">        <span class="nam">worker</span> <span class="op">=</span> <span class="nam">User</span><span class="op">.</span><span class="nam">query</span><span class="op">.</span><span class="nam">get</span><span class="op">(</span><span class="nam">worker_id</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t46" href="#t46">46</a></span><span class="t">        <span class="key">if</span> <span class="nam">worker</span> <span class="key">and</span> <span class="nam">worker</span><span class="op">.</span><span class="nam">email</span><span class="op">:</span> <span class="nam">correos</span><span class="op">.</span><span class="nam">append</span><span class="op">(</span><span class="nam">worker</span><span class="op">.</span><span class="nam">email</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t47" href="#t47">47</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t48" href="#t48">48</a></span><span class="t">    <span class="com"># Eliminamos duplicados (por si un admin tambi&#233;n es jefe de esa obra)</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t49" href="#t49">49</a></span><span class="t">    <span class="key">return</span> <span class="nam">list</span><span class="op">(</span><span class="nam">set</span><span class="op">(</span><span class="nam">correos</span><span class="op">)</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t50" href="#t50">50</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="run"><span class="n"><a id="t51" href="#t51">51</a></span><span class="t"><span class="key">def</span> <span class="nam">notificar_nueva_solicitud</span><span class="op">(</span><span class="nam">solicitud</span><span class="op">,</span> <span class="nam">solicitante_name</span><span class="op">)</span><span class="op">:</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t52" href="#t52">52</a></span><span class="t">    <span class="str">"""Notifica la creaci&#243;n de una solicitud (Gen&#233;rica o Concreta)"""</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t53" href="#t53">53</a></span><span class="t">    <span class="nam">clave</span> <span class="op">=</span> <span class="str">'email_sol_generica'</span> <span class="key">if</span> <span class="nam">solicitud</span><span class="op">.</span><span class="nam">tipo</span> <span class="op">==</span> <span class="str">'GENERICA'</span> <span class="key">else</span> <span class="str">'email_sol_concreta'</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t54" href="#t54">54</a></span><span class="t">    <span class="nam">destinatarios</span> <span class="op">=</span> <span class="nam">_obtener_destinatarios</span><span class="op">(</span><span class="nam">clave</span><span class="op">,</span> <span class="nam">obra_id</span><span class="op">=</span><span class="nam">solicitud</span><span class="op">.</span><span class="nam">obra_id</span><span class="op">,</span> <span class="nam">worker_id</span><span class="op">=</span><span class="nam">solicitud</span><span class="op">.</span><span class="nam">empleado_id</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t55" href="#t55">55</a></span><span class="t">    <span class="key">if</span> <span class="key">not</span> <span class="nam">destinatarios</span><span class="op">:</span> <span class="key">return</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t56" href="#t56">56</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t57" href="#t57">57</a></span><span class="t">    <span class="nam">obra</span> <span class="op">=</span> <span class="nam">Obra</span><span class="op">.</span><span class="nam">query</span><span class="op">.</span><span class="nam">get</span><span class="op">(</span><span class="nam">solicitud</span><span class="op">.</span><span class="nam">obra_id</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t58" href="#t58">58</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t59" href="#t59">59</a></span><span class="t">    <span class="com"># Obtener nombre completo del Jefe y saber si es Baja</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t60" href="#t60">60</a></span><span class="t">    <span class="nam">jefe</span> <span class="op">=</span> <span class="nam">User</span><span class="op">.</span><span class="nam">query</span><span class="op">.</span><span class="nam">get</span><span class="op">(</span><span class="nam">solicitud</span><span class="op">.</span><span class="nam">requested_by_id</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t61" href="#t61">61</a></span><span class="t">    <span class="nam">nombre_jefe</span> <span class="op">=</span> <span class="str">f"{jefe.name} {jefe.lastname}"</span> <span class="key">if</span> <span class="nam">jefe</span> <span class="key">else</span> <span class="nam">solicitante_name</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t62" href="#t62">62</a></span><span class="t">    <span class="nam">tipo_solic</span> <span class="op">=</span> <span class="str">"baja de personal"</span> <span class="key">if</span> <span class="nam">getattr</span><span class="op">(</span><span class="nam">solicitud</span><span class="op">,</span> <span class="str">'accion'</span><span class="op">,</span> <span class="str">''</span><span class="op">)</span> <span class="op">==</span> <span class="str">'DESASIGNAR'</span> <span class="key">else</span> <span class="str">"personal"</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t63" href="#t63">63</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t64" href="#t64">64</a></span><span class="t">    <span class="nam">asunto</span> <span class="op">=</span> <span class="str">f"NUEVA SOLICITUD DE {tipo_solic.upper()} - {obra.nombre}"</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t65" href="#t65">65</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t66" href="#t66">66</a></span><span class="t">    <span class="nam">texto</span> <span class="op">=</span> <span class="op">(</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis mis2 show_mis"><span class="n"><a id="t67" href="#t67">67</a></span><span class="t">        <span class="str">f"El Jefe de Obra {nombre_jefe} ha creado una nueva solicitud de {tipo_solic}.\n\n"</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis mis2 show_mis"><span class="n"><a id="t68" href="#t68">68</a></span><span class="t">        <span class="str">f"Obra: {obra.nombre}\n"</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis mis2 show_mis"><span class="n"><a id="t69" href="#t69">69</a></span><span class="t">    <span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t70" href="#t70">70</a></span><span class="t">    <span class="key">if</span> <span class="nam">solicitud</span><span class="op">.</span><span class="nam">tipo</span> <span class="op">==</span> <span class="str">'CONCRETA'</span><span class="op">:</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t71" href="#t71">71</a></span><span class="t">        <span class="nam">worker</span> <span class="op">=</span> <span class="nam">User</span><span class="op">.</span><span class="nam">query</span><span class="op">.</span><span class="nam">get</span><span class="op">(</span><span class="nam">solicitud</span><span class="op">.</span><span class="nam">empleado_id</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t72" href="#t72">72</a></span><span class="t">        <span class="key">if</span> <span class="nam">worker</span><span class="op">:</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t73" href="#t73">73</a></span><span class="t">            <span class="nam">texto</span> <span class="op">+=</span> <span class="str">f"Trabajador Solicitado: {worker.name} {worker.lastname}\n"</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t74" href="#t74">74</a></span><span class="t">    <span class="key">else</span><span class="op">:</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t75" href="#t75">75</a></span><span class="t">        <span class="nam">texto</span> <span class="op">+=</span> <span class="str">f"Perfil Solicitado: {solicitud.perfil_categoria} (Cant: {solicitud.cantidad_solicitada})\n"</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t76" href="#t76">76</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t77" href="#t77">77</a></span><span class="t">    <span class="nam">texto</span> <span class="op">+=</span> <span class="str">f"Fechas: {solicitud.fecha_inicio.strftime('%d/%m/%Y')} al {solicitud.fecha_fin.strftime('%d/%m/%Y')}\n\n"</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t78" href="#t78">78</a></span><span class="t">    <span class="nam">texto</span> <span class="op">+=</span> <span class="str">"Por favor, entra en la plataforma para revisarla y gestionarla."</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t79" href="#t79">79</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t80" href="#t80">80</a></span><span class="t">    <span class="nam">send_email</span><span class="op">(</span><span class="nam">asunto</span><span class="op">,</span> <span class="nam">destinatarios</span><span class="op">,</span> <span class="nam">texto</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t81" href="#t81">81</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="run"><span class="n"><a id="t82" href="#t82">82</a></span><span class="t"><span class="key">def</span> <span class="nam">notificar_resolucion_solicitud</span><span class="op">(</span><span class="nam">solicitud</span><span class="op">,</span> <span class="nam">admin_name</span><span class="op">,</span> <span class="nam">worker_id</span><span class="op">=</span><span class="key">None</span><span class="op">)</span><span class="op">:</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t83" href="#t83">83</a></span><span class="t">    <span class="str">"""Notifica cuando una solicitud cambia de estado (Aprobada, Denegada, etc.)"""</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t84" href="#t84">84</a></span><span class="t">    <span class="com"># Usamos el worker_id si lo hay, o el de la solicitud</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t85" href="#t85">85</a></span><span class="t">    <span class="nam">id_trabajador</span> <span class="op">=</span> <span class="nam">solicitud</span><span class="op">.</span><span class="nam">empleado_id</span> <span class="key">or</span> <span class="nam">worker_id</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t86" href="#t86">86</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t87" href="#t87">87</a></span><span class="t">    <span class="nam">destinatarios</span> <span class="op">=</span> <span class="nam">_obtener_destinatarios</span><span class="op">(</span><span class="str">'email_sol_resuelta'</span><span class="op">,</span> <span class="nam">obra_id</span><span class="op">=</span><span class="nam">solicitud</span><span class="op">.</span><span class="nam">obra_id</span><span class="op">,</span> <span class="nam">worker_id</span><span class="op">=</span><span class="nam">id_trabajador</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t88" href="#t88">88</a></span><span class="t">    <span class="key">if</span> <span class="key">not</span> <span class="nam">destinatarios</span><span class="op">:</span> <span class="key">return</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t89" href="#t89">89</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t90" href="#t90">90</a></span><span class="t">    <span class="nam">obra</span> <span class="op">=</span> <span class="nam">Obra</span><span class="op">.</span><span class="nam">query</span><span class="op">.</span><span class="nam">get</span><span class="op">(</span><span class="nam">solicitud</span><span class="op">.</span><span class="nam">obra_id</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t91" href="#t91">91</a></span><span class="t">    <span class="nam">asunto</span> <span class="op">=</span> <span class="str">f"Resoluci&#243;n de solicitud #{solicitud.id} - {obra.nombre}"</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t92" href="#t92">92</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t93" href="#t93">93</a></span><span class="t">    <span class="nam">texto</span> <span class="op">=</span> <span class="op">(</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis mis2 show_mis"><span class="n"><a id="t94" href="#t94">94</a></span><span class="t">        <span class="str">f"La solicitud para la obra {obra.nombre} ha sido resuelta por {admin_name}.\n\n"</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis mis2 show_mis"><span class="n"><a id="t95" href="#t95">95</a></span><span class="t">        <span class="str">f"Estado: {solicitud.estado}\n"</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis mis2 show_mis"><span class="n"><a id="t96" href="#t96">96</a></span><span class="t">        <span class="str">f"Acci&#243;n solicitada: {getattr(solicitud, 'accion', 'ASIGNAR')}\n"</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis mis2 show_mis"><span class="n"><a id="t97" href="#t97">97</a></span><span class="t">    <span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t98" href="#t98">98</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t99" href="#t99">99</a></span><span class="t">    <span class="com"># AQU&#205; PONEMOS EL NOMBRE Y LA EMPRESA SIN IMPORTAR SI ES CONCRETA O GEN&#201;RICA</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t100" href="#t100">100</a></span><span class="t">    <span class="key">if</span> <span class="nam">id_trabajador</span><span class="op">:</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t101" href="#t101">101</a></span><span class="t">        <span class="nam">worker</span> <span class="op">=</span> <span class="nam">User</span><span class="op">.</span><span class="nam">query</span><span class="op">.</span><span class="nam">get</span><span class="op">(</span><span class="nam">id_trabajador</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t102" href="#t102">102</a></span><span class="t">        <span class="key">if</span> <span class="nam">worker</span><span class="op">:</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t103" href="#t103">103</a></span><span class="t">            <span class="nam">empresa</span> <span class="op">=</span> <span class="nam">worker</span><span class="op">.</span><span class="nam">company_rel</span><span class="op">.</span><span class="nam">nombre</span> <span class="key">if</span> <span class="nam">worker</span><span class="op">.</span><span class="nam">company_rel</span> <span class="key">else</span> <span class="str">"Sin empresa"</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t104" href="#t104">104</a></span><span class="t">            <span class="nam">texto</span> <span class="op">+=</span> <span class="str">f"Trabajador movido: {worker.name} {worker.lastname}\n"</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t105" href="#t105">105</a></span><span class="t">            <span class="nam">texto</span> <span class="op">+=</span> <span class="str">f"Empresa: {empresa}\n"</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t106" href="#t106">106</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t107" href="#t107">107</a></span><span class="t">    <span class="nam">texto</span> <span class="op">+=</span> <span class="str">f"Fechas: {solicitud.fecha_inicio.strftime('%d/%m/%Y')} al {solicitud.fecha_fin.strftime('%d/%m/%Y')}\n\n"</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t108" href="#t108">108</a></span><span class="t">    <span class="nam">texto</span> <span class="op">+=</span> <span class="str">f"Revisa la plataforma para m&#225;s detalles."</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t109" href="#t109">109</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
