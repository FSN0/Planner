    <p class="pln"><span class="n"><a id="t47" href="#t47">47</a></span><span class="t">        <span class="com"># C&#225;lculos</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t48" href="#t48">48</a></span><span class="t">        <span class="nam">free_count</span> <span class="op">=</span> <span class="nam">total_active</span> <span class="op">-</span> <span class="nam">len</span><span class="op">(</span><span class="nam">users_today</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t49" href="#t49">49</a></span><span class="t">        <span class="key">if</span> <span class="nam">free_count</span> <span class="op">&lt;</span> <span class="num">0</span><span class="op">:</span> <span class="nam">free_count</span> <span class="op">=</span> <span class="num">0</span> <span class="com"># Por seguridad</span>&nbsp;</span><span class="r"></span></p>
