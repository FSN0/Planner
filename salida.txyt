    <p class="pln"><span class="n"><a id="t1760" href="#t1760">1760</a></span><span class="t">        <span class="com"># request.form.getlist te da los values marcados, ej: ['admin', 'trabajador']</span>&nbsp;</span><span class="r"></span></p>
