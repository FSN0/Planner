    <p class="mis mis2 show_mis"><span class="n"><a id="t141" href="#t141">141</a></span><span class="t">            <span class="str">f"El Jefe de Obra {nombre_jefe_completo} ha realizado una extensi&#243;n de personal.\n\n"</span>&nbsp;</span><span class="r"></span></p>
