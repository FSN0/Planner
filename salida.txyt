    .doc-status.missing { color: #9ca3af; }
</style>
{% endblock %}

{% block wrapper %}
<div class="admin-shell">
  {# El operario verá la sidebar, pero muy vacía. Podríamos crear una _operario_sidebar.html específica si quieres #}
  {# Por ahora usamos la admin_sidebar, que se adapta sola (oculta cosas de admin) #}
