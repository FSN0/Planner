    <p class="mis mis2 show_mis"><span class="n"><a id="t167" href="#t167">167</a></span><span class="t">        <span class="str">f"El administrador {admin_name} ha realizado un movimiento en la obra ({obra.nombre}):\n\n"</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis mis2 show_mis"><span class="n"><a id="t168" href="#t168">168</a></span><span class="t">        <span class="str">f"Acci&#243;n: {accion.upper()}\n"</span>&nbsp;</span><span class="r"></span></p>
