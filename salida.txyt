    <p class="pln"><span class="n"><a id="t99" href="#t99">99</a></span><span class="t">    <span class="com"># Si Odoo est&#225; activo, guardamos el adaptador en el JSON</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t100" href="#t100">100</a></span><span class="t">    <span class="key">if</span> <span class="nam">estado_modulos</span><span class="op">.</span><span class="nam">get</span><span class="op">(</span><span class="str">'odoo'</span><span class="op">)</span><span class="op">:</span>&nbsp;</span><span class="r"></span></p>
