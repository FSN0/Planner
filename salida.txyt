    <p class="run"><span class="n"><a id="t9" href="#t9">9</a></span><span class="t">    <span class="key">return</span> <span class="nam">val</span><span class="op">.</span><span class="nam">strip</span><span class="op">(</span><span class="op">)</span><span class="op">.</span><span class="nam">lower</span><span class="op">(</span><span class="op">)</span> <span class="key">in</span> <span class="op">(</span><span class="str">'1'</span><span class="op">,</span> <span class="str">'true'</span><span class="op">,</span> <span class="str">'yes'</span><span class="op">,</span> <span class="str">'on'</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
