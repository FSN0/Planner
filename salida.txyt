    <p class="mis mis2 show_mis"><span class="n"><a id="t130" href="#t130">130</a></span><span class="t">            <span class="str">f"El Jefe de Obra {nombre_jefe_completo} ha realizado un traslado entre sus obras.\n\n"</span>&nbsp;</span><span class="r"></span></p>
