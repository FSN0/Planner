===== ./full_restart_app_DATA_LOST.sh =====

#!/bin/bash

set -e  # Detener el script si hay algún error

echo "🛑 Deteniendo y eliminando contenedores, volúmenes e imágenes..."
docker-compose down -v --remove-orphans
docker system prune -a -f

echo "🗑️ Eliminando directorio de migraciones..."
rm -rf app/migrations/

echo "🔧 Reconstruyendo la aplicación sin caché..."
docker-compose build --no-cache
docker-compose up -d

echo "📦 Esperando a que los contenedores inicien..."
sleep 5

echo "🚀 Inicializando la base de datos y aplicando migraciones..."
docker exec -it project-web-1 bash -c "
    flask db init &&
    flask db migrate -m 'Initial migration with updated User model and new features' &&
    flask db upgrade
"

echo "🔄 Reiniciando el contenedor web..."
docker-compose restart web

# ... (parte anterior del script igual) ...

# Opción para crear el usuario admin
read -p "¿Deseas crear el usuario administrador? (y/n): " create_admin
if [[ $create_admin == "y" ]]; then
    echo "👤 Creando empresa principal y usuario administrador..."
    docker exec -i project-web-1 flask shell <<EOF
from app import db
from app.models import User, Company
from werkzeug.security import generate_password_hash

# 1. Crear la empresa primero (ya que la DB está vacía)
empresa = Company.query.filter_by(code="ADMIN").first()
if not empresa:
    empresa = Company(
        code="ADMIN",
        nombre="Empresa Principal SOCTEC",
        is_internal=True,  # Importante: marcar como interna
        color="#a8d5ba"
    )
    db.session.add(empresa)
    db.session.commit()
    print(f"🏢 Empresa creada: {empresa.nombre} (ID: {empresa.id})")

# 2. Crear el usuario asignándole el ID de la empresa
if not User.query.filter_by(email="admin@example.com").first():
    admin = User(
        email="admin@example.com",
        password_hash=generate_password_hash("admin123"),
        role="admin",
        name="Admin",
        lastname="Principal",
        dni="00000000X",
        company_id=empresa.id,  # USA EL ID, NO EL CÓDIGO DIRECTAMENTE
        active=True
    )
    db.session.add(admin)
    db.session.commit()
    print("✅ Usuario administrador creado: admin@example.com / admin123")
else:
    print("⚠️ El usuario admin ya existe.")
EOF
fi

echo "✅ Proceso completado correctamente."

echo "✅ Proceso completado correctamente."



===== ./Dockerfile =====

FROM python:3.9-slim-bullseye
# Instala dependencias y wkhtmltopdf
RUN apt-get update && apt-get install -y \
    wkhtmltopdf \
    xfonts-75dpi \
    xfonts-base

WORKDIR /app

COPY requirements.txt requirements.txt
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY . .

RUN mkdir -p /app/uploads

EXPOSE 5000

CMD ["python", "run.py"]






===== ./create_admin.sh =====

#!/bin/bash
echo "👤 Gestionando usuario administrador..."

# Usamos exec(''' ... ''') para evitar errores de indentación en la consola
docker exec -i project-web-1 flask shell <<EOF
exec('''
from app import db
from app.models import User, Company
from werkzeug.security import generate_password_hash

print("--- INICIANDO ---")

# 1. RECUPERAR O CREAR EMPRESA
# Como ya sabemos que la empresa existe (del intento anterior), la buscamos.
empresa = Company.query.filter_by(code="ADMIN").first()

if not empresa:
    print("✨ Creando empresa...")
    empresa = Company(
        code="ADMIN",
        nombre="Empresa Principal SOCTEC",
        is_internal=True,
        color="#a8d5ba"
    )
    db.session.add(empresa)
    db.session.commit()
    print(f"✅ Empresa creada con ID: {empresa.id}")
else:
    print(f"ℹ️ La empresa ya existe con ID: {empresa.id}")

# 2. VERIFICAR SI EL USUARIO EXISTE
user = User.query.filter_by(email="admin@example.com").first()

if user:
    print("⚠️ El usuario admin ya existe. No se hace nada.")
else:
    print("✨ Creando usuario admin...")
    try:
        admin = User(
            email="admin@example.com",
            password_hash=generate_password_hash("admin123"),
            role="admin",
            name="Admin",
            lastname="Principal",
            dni="00000000X",
            company_id=empresa.id,  # Usamos el ID de la empresa recuperada arriba
            active=True
        )
        db.session.add(admin)
        db.session.commit()
        print("✅ Usuario administrador creado: admin@example.com / admin123")
    except Exception as e:
        db.session.rollback()
        print(f"❌ Error creando usuario: {e}")
''')
EOF

echo "✅ Script finalizado."


===== ./restore.sh =====

#!/bin/bash

# Directorio de backups
BACKUP_DIR="./backups"

# Colores para mensajes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}=== SISTEMA DE RESTAURACIÓN SOLTEC ===${NC}"

# 1. Listar backups disponibles
if [ -z "$(ls -A $BACKUP_DIR/*.sql 2>/dev/null)" ]; then
   echo "❌ No hay backups .sql en la carpeta $BACKUP_DIR"
   exit 1
fi

echo "Copias de seguridad encontradas:"
ls -1 $BACKUP_DIR/*.sql | xargs -n 1 basename | sed 's/db_//' | sed 's/.sql//'
echo ""
echo -e "${YELLOW}Introduce el TIMESTAMP (la fecha/hora, ej: 20251216_173000) que quieres restaurar:${NC}"
read TIMESTAMP

DB_FILE="$BACKUP_DIR/db_$TIMESTAMP.sql"
UPLOADS_FILE="$BACKUP_DIR/uploads_$TIMESTAMP.tar.gz"

# 2. Verificar que existen los archivos
if [[ ! -f "$DB_FILE" ]]; then
    echo -e "${RED}Error: No encuentro el archivo de base de datos: $DB_FILE${NC}"
    exit 1
fi

if [[ ! -f "$UPLOADS_FILE" ]]; then
    echo -e "${RED}Error: No encuentro el archivo de uploads: $UPLOADS_FILE${NC}"
    exit 1
fi

# 3. Confirmación de seguridad
echo -e "${RED}¡PELIGRO! Vas a restaurar la copia del $TIMESTAMP.${NC}"
echo -e "${RED}ESTO BORRARÁ TODOS LOS DATOS ACTUALES DE LA BASE DE DATOS Y LOS FICHEROS SUBIDOS.${NC}"
echo "¿Estás absolutamente seguro? (escribe 'si' para continuar)"
read CONFIRMATION

if [[ "$CONFIRMATION" != "si" ]]; then
    echo "Cancelado."
    exit 0
fi

echo -e "${GREEN}Iniciando restauración...${NC}"

# 4. Parar servicios web (para que nadie escriba mientras restauramos)
echo "1. Deteniendo la web y los workers..."
docker compose stop web celery_worker

# 5. Restaurar Ficheros (Uploads)
echo "2. Restaurando carpeta 'uploads'..."
# Borramos la carpeta actual para que no queden ficheros 'zombies'
rm -rf ./uploads/*
# Descomprimimos
tar -xzf "$UPLOADS_FILE" -C .
echo "✅ Ficheros restaurados."

# 6. Restaurar Base de Datos
echo "3. Restaurando Base de Datos..."

# Truco PRO: Borramos el esquema 'public' y lo recreamos.
# Es más rápido y limpio que borrar toda la base de datos o ir tabla por tabla.
echo "   - Limpiando base de datos actual..."
docker compose exec -T db psql -U postgres gestion_obra_db -c "DROP SCHEMA public CASCADE; CREATE SCHEMA public;" > /dev/null 2>&1

echo "   - Importando datos desde el backup..."
cat "$DB_FILE" | docker compose exec -T db psql -U postgres gestion_obra_db > /dev/null 2>&1

if [ $? -eq 0 ]; then
    echo "✅ Base de datos restaurada correctamente."
else
    echo -e "${RED}❌ Hubo un error al importar la base de datos.${NC}"
    # Intentamos arrancar de todos modos por si acaso
fi

# 7. Arrancar todo de nuevo
echo "4. Arrancando servicios..."
docker compose start web celery_worker

echo -e "${GREEN}✨ RESTAURACIÓN COMPLETADA CON ÉXITO ✨${NC}"

