/* =================== Table Styles =================== */
/* (Bloque 1 y 2; se elige box-shadow con 0.1 para mayor contraste) */
body:not(.layout-admin):not(.layout-auth) .table {
    background: #fff;
    border-radius: 8px;
    overflow: hidden;
