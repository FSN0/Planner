<div class="admin-actions-bar">
    <div class="admin-actions-text">
        <span class="d-inline-flex align-items-center flex-wrap text-muted" style="font-size:0.75rem; gap:0.35rem;">
          <i class="fas fa-clipboard-check"></i>
          <span>Estado:</span>
          {% set est = solicitud.estado %}
          {% if est == 'PENDIENTE' %}<span class="badge-soft badge-soft-amber">Pendiente</span>
          {% elif est == 'EN_PROCESO' %}<span class="badge-soft badge-soft-blue">En proceso</span>
          {% elif est == 'CUMPLIDA' %}<span class="badge-soft badge-soft-green">Cumplida</span>
          {% elif est == 'CERRADA_PARCIAL' %}<span class="badge-soft badge-soft-gray">Cerrada P.</span>
          {% elif est == 'DENEGADA' %}<span class="badge-soft badge-soft-red">Denegada</span>
          {% else %}<span class="badge-soft badge-soft-gray">{{ est }}</span>
          {% endif %}
          {% if cobertura_texto %}
            <span class="text-muted">·</span>
            <span>Cobertura: <strong class="text-dark">{{ cobertura_texto }}</strong></span>
          {% endif %}
        </span>
    </div>

    <div class="admin-actions-buttons">
        {% if solicitud.estado in ['PENDIENTE', 'EN_PROCESO'] %}
            {% if solicitud.tipo|lower == 'concreta' %}
                <button type="button" onclick="submitConcretaTotal()" class="btn-admin btn-admin-primary">
                    <i class="fas fa-check-double"></i> Todo el periodo
                </button>
                <button type="button" id="btn-assign-partial" class="btn-admin btn-admin-ghost" onclick="submitPartialFromMain()">
                    <i class="far fa-calendar-check"></i> Días sueltos
                </button>
            {% else %}
                <button type="button" class="btn-admin btn-admin-primary" onclick="submitGenericTotal()">
                    <i class="fas fa-check-double"></i> Asignar seleccionados
                </button>
                <button type="button" id="btn-assign-partial" class="btn-admin btn-admin-ghost" onclick="submitPartialFromMain()">
                    <i class="far fa-calendar-check"></i> Días sueltos
                </button>
            {% endif %}
            <button type="button" onclick="resolverSolicitudApi('{{ solicitud.id }}', 'denegar')" class="btn-admin btn-admin-danger">
                <i class="fas fa-ban"></i> Denegar
            </button>
        {% else %}
            <button type="button" onclick="resolverSolicitudApi('{{ solicitud.id }}', 'reabrir')" class="btn-admin btn-admin-ghost">
                <i class="fas fa-undo"></i> Reabrir
            </button>
        {% endif %}
    </div>
</div>


