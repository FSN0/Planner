}

.vis-timeline { 
    border: 1px solid #e2e8f0; 
    border-radius: 8px; 
    border: none; 
}

/* =========================================================
   CABECERA FLOTANTE - HACHAZO A LOS CLICS FANTASMAS CORREGIDO
   ========================================================= */

/* 1. Anulamos la sombra nativa de vis.js que bloquea las primeras filas */
.vis-shadow {
    pointer-events: none !important;
    display: none !important;
}

.vis-panel.vis-top {
    transform: translateY(var(--sticky-top, 0px));
    z-index: 100 !important;
    background-color: #ffffff !important;
}

/* 2. Hacemos que TODO el panel superior (incluidos los textos) sea traspasable */
.vis-panel.vis-top,
.vis-panel.vis-top * {
    pointer-events: none !important; 
}

/* IMPORTANTE: BORRA la regla de .vis-panel.vis-top .vis-text que tenías aquí. 
   Es la que te estaba bloqueando a los operarios de arriba cuando la cabecera bajaba. */

.vis-time-axis { background-color: #ffffff; }
.vis-panel.vis-left, .vis-panel.vis-center, .vis-panel.vis-right, .vis-panel.vis-bottom { border-color: #f1f5f9; }
.vis-time-axis .vis-text { font-size: 12px; font-weight: 600; color: #1e293b; }
.vis-time-axis .vis-grid.vis-minor { border-color: #f8fafc; }
.vis-time-axis .vis-grid.vis-major { border-color: #e2e8f0; border-width: 2px; }

/* Para indicar que se pueden arrastrar las obras */
.vis-label { cursor: grab !important; touch-action: none; }
.vis-label:active { cursor: grabbing !important; }
.vis-label a { pointer-events: auto; }

/* LIMPIEZA DE MÁRGENES */
.vis-label .vis-inner {
    padding: 0 !important; 
    margin: 0 !important;
    width: 100% !important;
    box-sizing: border-box !important;
    display: block !important;
}

.btn-ojo-magico:hover { background-color: #e2e8f0 !important; }

/* EL TIRADOR DE CAMBIO DE TAMAÑO */
#col-resizer {
    position: absolute; top: 0; bottom: 0; width: 14px; margin-left: -7px; 
    cursor: ew-resize; z-index: 200; background: transparent;
}
#col-resizer:hover, #col-resizer.is-resizing {
    background: rgba(59, 130, 246, 0.3); border-left: 2px solid #3b82f6;
}
#col-resizer-ghost {
    display: none; position: absolute; top: 0; bottom: 0; width: 2px;
    background: #2563eb; z-index: 201; pointer-events: none;
}

/* =========================================================
   TAMAÑO Y DISEÑO DE LOS OPERARIOS
