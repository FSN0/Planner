===== ./entrypoint.sh =====

#!/bin/sh
set -e

echo "Verificando migraciones..."
if [ ! -f "migrations/env.py" ]; then
    echo "No se encontró migrations/env.py, inicializando migraciones..."
    flask db init
    flask db migrate -m "Initial migration"
fi

echo "Ejecutando migraciones..."
flask db upgrade

echo "Creando usuario administrador (si no existe)..."
python create_admin.py

echo "Iniciando la aplicación..."
exec python run.py


===== ./backup.sh =====

#!/bin/bash

# 1. Definir fecha y directorio de backups
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
BACKUP_DIR="./backups"
mkdir -p $BACKUP_DIR

echo "--- Iniciando Backup [$TIMESTAMP] ---"

# 2. Backup de la Base de Datos
echo "1. Exportando Base de Datos..."
docker compose exec -T db pg_dump -U postgres gestion_obra_db > "$BACKUP_DIR/db_$TIMESTAMP.sql"

# 3. Backup de los Archivos (Uploads)
echo "2. Comprimiendo ficheros subidos..."
tar -czf "$BACKUP_DIR/uploads_$TIMESTAMP.tar.gz" ./uploads

# 4. (Opcional) Borrar backups antiguos de más de 7 días para no llenar el disco
find $BACKUP_DIR -type f -mtime +7 -name "*.sql" -delete
find $BACKUP_DIR -type f -mtime +7 -name "*.tar.gz" -delete

echo "✅ Backup completado en la carpeta $BACKUP_DIR"


===== ./m.sh =====

#!/bin/bash
# Script para automatizar las migraciones de la base de datos en Docker.
# Uso: ./migrate.sh "Mensaje descriptivo para la migración"

if [ "$#" -ne 1 ]; then
    echo "Uso: $0 \"Mensaje descriptivo para la migración\""
    exit 1
fi

MIGRATION_MESSAGE="$1"

echo "Reconstruyendo las imágenes Docker..."
docker compose build

echo "Levantando contenedores en modo detached..."
docker compose up -d

# --- CORRECCIÓN AQUÍ ---
# Se añade 'rm -rf migrations' antes de 'flask db init' para limpiar carpetas corruptas
echo "Verificando estado de migraciones..."
docker exec -it project-web-1 bash -c 'if [ ! -f "migrations/env.py" ]; then
    echo "Carpeta de migraciones corrupta o inexistente. Reinicializando...";
    rm -rf migrations;
    flask db init && flask db migrate -m "Initial migration";
fi'

# Opcional: Si existe algún problema con una revisión antigua, limpia la tabla alembic_version
echo "Limpiando la tabla alembic_version..."
docker exec -it project-db-1 psql -U postgres -d gestion_obra_db -c "TRUNCATE TABLE alembic_version;"

echo "Marcando la versión head en la base de datos..."
docker exec -it project-web-1 flask db stamp head

echo "Generando migración: $MIGRATION_MESSAGE"
docker exec -it project-web-1 flask db migrate -m "$MIGRATION_MESSAGE"

echo "Aplicando migración en la base de datos..."
docker exec -it project-web-1 flask db upgrade

echo "Proceso de migración completado."



===== ./scripts/add_solicitud_notas_column.py =====

#!/usr/bin/env python3
"""Añade la columna solicitudes.notas si aún no existe."""
from sqlalchemy import inspect, text

from app import create_app, db

app = create_app()

with app.app_context():
    inspector = inspect(db.engine)
    columns = {col["name"] for col in inspector.get_columns("solicitudes")}
    if "notas" in columns:
        print("La columna solicitudes.notas ya existe.")
    else:
        db.session.execute(text("ALTER TABLE solicitudes ADD COLUMN notas TEXT"))
        db.session.commit()
        print("Columna solicitudes.notas creada correctamente.")


