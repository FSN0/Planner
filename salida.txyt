    <p class="mis show_mis"><span class="n"><a id="t79" href="#t79">79</a></span><span class="t">        <span class="nam">provision_new_tenant</span><span class="op">(</span><span class="nam">nombre</span><span class="op">,</span> <span class="nam">subdominio</span><span class="op">,</span> <span class="nam">admin_email</span><span class="op">,</span> <span class="nam">admin_password</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t80" href="#t80">80</a></span><span class="t">        <span class="nam">flash</span><span class="op">(</span><span class="str">f"Inquilino '{nombre}' creado. El administrador ya puede iniciar sesi&#243;n."</span><span class="op">,</span> <span class="str">"success"</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t81" href="#t81">81</a></span><span class="t">    <span class="key">except</span> <span class="nam">Exception</span> <span class="key">as</span> <span class="nam">e</span><span class="op">:</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t82" href="#t82">82</a></span><span class="t">        <span class="nam">flash</span><span class="op">(</span><span class="str">f"Error al crear inquilino: {str(e)}"</span><span class="op">,</span> <span class="str">"danger"</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
