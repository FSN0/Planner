    <p class="pln"><span class="n"><a id="t13" href="#t13">13</a></span><span class="t">    <span class="com"># SECRET_KEY: NUNCA debe tener un valor por defecto en producci&#243;n.</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t14" href="#t14">14</a></span><span class="t">    <span class="com"># Si no est&#225; definida, create_app() abortar&#225; el arranque (ver app/__init__.py).</span>&nbsp;</span><span class="r"></span></p>
