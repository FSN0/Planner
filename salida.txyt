{% extends "base.html" %}
{% block title %}Mi Espacio{% endblock %}
{% block body_class %}layout-admin{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/admin_layout.css') }}">
<style>
    /* Ocultar sidebar en móvil para operarios si se desea, o simplificarla */
    .upload-box {
        border: 2px dashed #cbd5e1;
        border-radius: 8px;
        padding: 20px;
        text-align: center;
        transition: 0.2s;
