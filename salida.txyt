    <p class="mis show_mis"><span class="n"><a id="t85" href="#t85">85</a></span><span class="t">    <span class="nam">flash</span><span class="op">(</span><span class="str">"Sesi&#243;n cerrada"</span><span class="op">,</span> <span class="str">"info"</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t86" href="#t86">86</a></span><span class="t">    <span class="key">return</span> <span class="nam">redirect</span><span class="op">(</span><span class="nam">url_for</span><span class="op">(</span><span class="str">'auth.login'</span><span class="op">)</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
