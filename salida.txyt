    <p class="pln"><span class="n"><a id="t24" href="#t24">24</a></span><span class="t">        <span class="com"># Los admins gestionan todo: ven las notas de todas las obras</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t25" href="#t25">25</a></span><span class="t">        <span class="com"># (Pero si la nota NO tiene obras ni implicados, .any() es False -> privada a efectos pr&#225;cticos)</span>&nbsp;</span><span class="r"></span></p>
