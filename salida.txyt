    <p class="run"><span class="n"><a id="t88" href="#t88">88</a></span><span class="t"><span class="op">@</span><span class="nam">auth_bp</span><span class="op">.</span><span class="nam">route</span><span class="op">(</span><span class="str">'/register'</span><span class="op">,</span> <span class="nam">methods</span><span class="op">=</span><span class="op">[</span><span class="str">'GET'</span><span class="op">,</span> <span class="str">'POST'</span><span class="op">]</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
