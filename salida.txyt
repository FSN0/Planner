    <p class="run"><span class="n"><a id="t92" href="#t92">92</a></span><span class="t">        <span class="nam">flash</span><span class="op">(</span><span class="str">"Accede desde la URL de tu empresa para registrarte."</span><span class="op">,</span> <span class="str">"warning"</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="run"><span class="n"><a id="t93" href="#t93">93</a></span><span class="t">        <span class="key">return</span> <span class="nam">redirect</span><span class="op">(</span><span class="str">'http://localhost:5000/superadmin/'</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
