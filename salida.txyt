    <p class="mis show_mis"><span class="n"><a id="t153" href="#t153">153</a></span><span class="t">    <span class="nam">clave</span> <span class="op">=</span> <span class="str">'email_desasignacion'</span> <span class="key">if</span> <span class="nam">is_baja</span> <span class="key">else</span> <span class="str">'email_asignacion'</span>&nbsp;</span><span class="r"></span></p>
