    <p class="pln"><span class="n"><a id="t41" href="#t41">41</a></span><span class="t">    <span class="str">"""Env&#237;a un error 401 que fuerza al navegador a mostrar el popup de login."""</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t42" href="#t42">42</a></span><span class="t">    <span class="key">return</span> <span class="nam">Response</span><span class="op">(</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis mis2 show_mis"><span class="n"><a id="t43" href="#t43">43</a></span><span class="t">        <span class="str">'Acceso denegado. &#193;rea exclusiva de infraestructura SaaS.\n'</span><span class="op">,</span> <span class="num">401</span><span class="op">,</span>&nbsp;</span><span class="r"></span></p>
