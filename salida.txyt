    <p class="run"><span class="n"><a id="t733" href="#t733">733</a></span><span class="t"><span class="op">@</span><span class="nam">admin_bp</span><span class="op">.</span><span class="nam">route</span><span class="op">(</span><span class="str">"/obras_detailed"</span><span class="op">,</span> <span class="nam">methods</span><span class="op">=</span><span class="op">[</span><span class="str">"GET"</span><span class="op">]</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="run"><span class="n"><a id="t734" href="#t734">734</a></span><span class="t"><span class="op">@</span><span class="nam">login_required</span>&nbsp;</span><span class="r"></span></p>
    <p class="run"><span class="n"><a id="t735" href="#t735">735</a></span><span class="t"><span class="key">def</span> <span class="nam">obras_detailed</span><span class="op">(</span><span class="op">)</span><span class="op">:</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t736" href="#t736">736</a></span><span class="t">    <span class="com"># 1. Obtener fecha de la URL</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t737" href="#t737">737</a></span><span class="t">    <span class="nam">date_str</span> <span class="op">=</span> <span class="nam">request</span><span class="op">.</span><span class="nam">args</span><span class="op">.</span><span class="nam">get</span><span class="op">(</span><span class="str">'selected_date'</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t738" href="#t738">738</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t739" href="#t739">739</a></span><span class="t">    <span class="com"># 2. Llamar al SERVICIO CENTRALIZADO</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t740" href="#t740">740</a></span><span class="t">    <span class="com"># 'view_param="todas"' indica que el Admin quiere ver todas las obras activas</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t741" href="#t741">741</a></span><span class="t">    <span class="nam">context</span> <span class="op">=</span> <span class="nam">get_dashboard_data</span><span class="op">(</span><span class="nam">current_user</span><span class="op">,</span> <span class="nam">date_str</span><span class="op">,</span> <span class="nam">view_param</span><span class="op">=</span><span class="str">'todas'</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t742" href="#t742">742</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t743" href="#t743">743</a></span><span class="t">    <span class="com"># 3. Inyectar las URLs de navegaci&#243;n espec&#237;ficas para el Admin</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t744" href="#t744">744</a></span><span class="t">    <span class="com"># Esto sobreescribe las del servicio para que los botones apunten a /admin/...</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t745" href="#t745">745</a></span><span class="t">    <span class="nam">context</span><span class="op">[</span><span class="str">'prev_month_url'</span><span class="op">]</span> <span class="op">=</span> <span class="nam">url_for</span><span class="op">(</span><span class="str">'admin.obras_detailed'</span><span class="op">,</span> <span class="nam">selected_date</span><span class="op">=</span><span class="nam">context</span><span class="op">[</span><span class="str">'prev_date_str'</span><span class="op">]</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t746" href="#t746">746</a></span><span class="t">    <span class="nam">context</span><span class="op">[</span><span class="str">'next_month_url'</span><span class="op">]</span> <span class="op">=</span> <span class="nam">url_for</span><span class="op">(</span><span class="str">'admin.obras_detailed'</span><span class="op">,</span> <span class="nam">selected_date</span><span class="op">=</span><span class="nam">context</span><span class="op">[</span><span class="str">'next_date_str'</span><span class="op">]</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t747" href="#t747">747</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t748" href="#t748">748</a></span><span class="t">    <span class="com"># 4. Configurar modo vista (para activar botones de edici&#243;n en el HTML)</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t749" href="#t749">749</a></span><span class="t">    <span class="nam">context</span><span class="op">[</span><span class="str">'view_mode'</span><span class="op">]</span> <span class="op">=</span> <span class="str">'admin'</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t750" href="#t750">750</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t751" href="#t751">751</a></span><span class="t">    <span class="com"># 5. Renderizar desempaquetando el contexto (header_days, timeline_data, free_workers, etc.)</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t752" href="#t752">752</a></span><span class="t">    <span class="key">return</span> <span class="nam">render_template</span><span class="op">(</span><span class="str">"obras_detailed_unificado.html"</span><span class="op">,</span> <span class="op">**</span><span class="nam">context</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t753" href="#t753">753</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t754" href="#t754">754</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t755" href="#t755">755</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="run"><span class="n"><a id="t756" href="#t756">756</a></span><span class="t"><span class="op">@</span><span class="nam">admin_bp</span><span class="op">.</span><span class="nam">route</span><span class="op">(</span><span class="str">"/personal"</span><span class="op">,</span> <span class="nam">methods</span><span class="op">=</span><span class="op">[</span><span class="str">"GET"</span><span class="op">]</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="run"><span class="n"><a id="t757" href="#t757">757</a></span><span class="t"><span class="op">@</span><span class="nam">login_required</span>&nbsp;</span><span class="r"></span></p>
    <p class="run"><span class="n"><a id="t758" href="#t758">758</a></span><span class="t"><span class="op">@</span><span class="nam">roles_required</span><span class="op">(</span><span class="nam">ROLE_ADMIN</span><span class="op">,</span> <span class="nam">ROLE_RRHH</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="run"><span class="n"><a id="t759" href="#t759">759</a></span><span class="t"><span class="key">def</span> <span class="nam">personal</span><span class="op">(</span><span class="op">)</span><span class="op">:</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t760" href="#t760">760</a></span><span class="t">    <span class="com"># 1. Usuarios INTERNOS (No operarios, O operarios de empresa interna)</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t761" href="#t761">761</a></span><span class="t">    <span class="nam">internos</span> <span class="op">=</span> <span class="nam">User</span><span class="op">.</span><span class="nam">query</span><span class="op">.</span><span class="nam">join</span><span class="op">(</span><span class="nam">Company</span><span class="op">,</span> <span class="nam">User</span><span class="op">.</span><span class="nam">company_id</span> <span class="op">==</span> <span class="nam">Company</span><span class="op">.</span><span class="nam">id</span><span class="op">,</span> <span class="nam">isouter</span><span class="op">=</span><span class="key">True</span><span class="op">)</span><span class="op">.</span><span class="nam">filter</span><span class="op">(</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis mis2 show_mis"><span class="n"><a id="t762" href="#t762">762</a></span><span class="t">        <span class="op">(</span><span class="nam">User</span><span class="op">.</span><span class="nam">role</span> <span class="op">!=</span> <span class="nam">ROLE_OPERARIO</span><span class="op">)</span> <span class="op">|</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis mis2 show_mis"><span class="n"><a id="t763" href="#t763">763</a></span><span class="t">        <span class="op">(</span><span class="op">(</span><span class="nam">User</span><span class="op">.</span><span class="nam">role</span> <span class="op">==</span> <span class="nam">ROLE_OPERARIO</span><span class="op">)</span> <span class="op">&amp;</span> <span class="op">(</span><span class="nam">Company</span><span class="op">.</span><span class="nam">is_internal</span> <span class="op">==</span> <span class="key">True</span><span class="op">)</span><span class="op">)</span><span class="op">,</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis mis2 show_mis"><span class="n"><a id="t764" href="#t764">764</a></span><span class="t">        <span class="nam">User</span><span class="op">.</span><span class="nam">is_deleted</span> <span class="op">==</span> <span class="key">False</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis mis2 show_mis"><span class="n"><a id="t765" href="#t765">765</a></span><span class="t">    <span class="op">)</span><span class="op">.</span><span class="nam">order_by</span><span class="op">(</span><span class="nam">User</span><span class="op">.</span><span class="nam">name</span><span class="op">)</span><span class="op">.</span><span class="nam">all</span><span class="op">(</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t766" href="#t766">766</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t767" href="#t767">767</a></span><span class="t">    <span class="com"># 2. Operarios EXTERNOS (Empresa con is_internal=False)</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t768" href="#t768">768</a></span><span class="t">    <span class="nam">base_operarios</span> <span class="op">=</span> <span class="nam">User</span><span class="op">.</span><span class="nam">query</span><span class="op">.</span><span class="nam">join</span><span class="op">(</span><span class="nam">Company</span><span class="op">)</span><span class="op">.</span><span class="nam">filter</span><span class="op">(</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis mis2 show_mis"><span class="n"><a id="t769" href="#t769">769</a></span><span class="t">        <span class="nam">User</span><span class="op">.</span><span class="nam">role</span> <span class="op">==</span> <span class="nam">ROLE_OPERARIO</span><span class="op">,</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis mis2 show_mis"><span class="n"><a id="t770" href="#t770">770</a></span><span class="t">        <span class="nam">Company</span><span class="op">.</span><span class="nam">is_internal</span> <span class="op">==</span> <span class="key">False</span><span class="op">,</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis mis2 show_mis"><span class="n"><a id="t771" href="#t771">771</a></span><span class="t">        <span class="nam">User</span><span class="op">.</span><span class="nam">is_deleted</span> <span class="op">==</span> <span class="key">False</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis mis2 show_mis"><span class="n"><a id="t772" href="#t772">772</a></span><span class="t">    <span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t773" href="#t773">773</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t774" href="#t774">774</a></span><span class="t">    <span class="com"># Filtro por empresa en la URL (?company_id=5)</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t775" href="#t775">775</a></span><span class="t">    <span class="nam">company_filter_id</span> <span class="op">=</span> <span class="nam">request</span><span class="op">.</span><span class="nam">args</span><span class="op">.</span><span class="nam">get</span><span class="op">(</span><span class="str">"company_id"</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t776" href="#t776">776</a></span><span class="t">    <span class="key">if</span> <span class="nam">company_filter_id</span><span class="op">:</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t777" href="#t777">777</a></span><span class="t">        <span class="nam">base_operarios</span> <span class="op">=</span> <span class="nam">base_operarios</span><span class="op">.</span><span class="nam">filter</span><span class="op">(</span><span class="nam">User</span><span class="op">.</span><span class="nam">company_id</span> <span class="op">==</span> <span class="nam">int</span><span class="op">(</span><span class="nam">company_filter_id</span><span class="op">)</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t778" href="#t778">778</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t779" href="#t779">779</a></span><span class="t">    <span class="nam">operarios_activos</span> <span class="op">=</span> <span class="nam">base_operarios</span><span class="op">.</span><span class="nam">filter</span><span class="op">(</span><span class="nam">User</span><span class="op">.</span><span class="nam">active</span> <span class="op">==</span> <span class="key">True</span><span class="op">)</span><span class="op">.</span><span class="nam">order_by</span><span class="op">(</span><span class="nam">User</span><span class="op">.</span><span class="nam">name</span><span class="op">)</span><span class="op">.</span><span class="nam">all</span><span class="op">(</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t780" href="#t780">780</a></span><span class="t">    <span class="nam">operarios_pendientes</span> <span class="op">=</span> <span class="nam">base_operarios</span><span class="op">.</span><span class="nam">filter</span><span class="op">(</span><span class="nam">User</span><span class="op">.</span><span class="nam">active</span> <span class="op">==</span> <span class="key">False</span><span class="op">)</span><span class="op">.</span><span class="nam">order_by</span><span class="op">(</span><span class="nam">User</span><span class="op">.</span><span class="nam">name</span><span class="op">)</span><span class="op">.</span><span class="nam">all</span><span class="op">(</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t781" href="#t781">781</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t782" href="#t782">782</a></span><span class="t">    <span class="com"># Para el dropdown de filtros en la vista</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t783" href="#t783">783</a></span><span class="t">    <span class="nam">companies</span> <span class="op">=</span> <span class="nam">Company</span><span class="op">.</span><span class="nam">query</span><span class="op">.</span><span class="nam">filter_by</span><span class="op">(</span><span class="nam">is_internal</span><span class="op">=</span><span class="key">False</span><span class="op">)</span><span class="op">.</span><span class="nam">all</span><span class="op">(</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t784" href="#t784">784</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t785" href="#t785">785</a></span><span class="t">    <span class="key">return</span> <span class="nam">render_template</span><span class="op">(</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis mis2 show_mis"><span class="n"><a id="t786" href="#t786">786</a></span><span class="t">        <span class="str">"gestion_personal_unificado.html"</span><span class="op">,</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis mis2 show_mis"><span class="n"><a id="t787" href="#t787">787</a></span><span class="t">        <span class="nam">view_mode</span><span class="op">=</span><span class="str">"admin"</span><span class="op">,</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis mis2 show_mis"><span class="n"><a id="t788" href="#t788">788</a></span><span class="t">        <span class="nam">internos</span><span class="op">=</span><span class="nam">internos</span><span class="op">,</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis mis2 show_mis"><span class="n"><a id="t789" href="#t789">789</a></span><span class="t">        <span class="nam">operarios_activos</span><span class="op">=</span><span class="nam">operarios_activos</span><span class="op">,</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis mis2 show_mis"><span class="n"><a id="t790" href="#t790">790</a></span><span class="t">        <span class="nam">operarios_pendientes</span><span class="op">=</span><span class="nam">operarios_pendientes</span><span class="op">,</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis mis2 show_mis"><span class="n"><a id="t791" href="#t791">791</a></span><span class="t">        <span class="nam">active_count</span><span class="op">=</span><span class="nam">len</span><span class="op">(</span><span class="nam">operarios_activos</span><span class="op">)</span><span class="op">,</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis mis2 show_mis"><span class="n"><a id="t792" href="#t792">792</a></span><span class="t">        <span class="nam">pending_count</span><span class="op">=</span><span class="nam">len</span><span class="op">(</span><span class="nam">operarios_pendientes</span><span class="op">)</span><span class="op">,</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis mis2 show_mis"><span class="n"><a id="t793" href="#t793">793</a></span><span class="t">        <span class="nam">companies</span><span class="op">=</span><span class="nam">companies</span><span class="op">,</span> <span class="com"># Pasamos objetos, no strings</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis mis2 show_mis"><span class="n"><a id="t794" href="#t794">794</a></span><span class="t">        <span class="nam">company_filter</span><span class="op">=</span><span class="nam">company_filter_id</span><span class="op">,</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis mis2 show_mis"><span class="n"><a id="t795" href="#t795">795</a></span><span class="t">        <span class="nam">next_url</span><span class="op">=</span><span class="nam">request</span><span class="op">.</span><span class="nam">path</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis mis2 show_mis"><span class="n"><a id="t796" href="#t796">796</a></span><span class="t">    <span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t797" href="#t797">797</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t798" href="#t798">798</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="run"><span class="n"><a id="t799" href="#t799">799</a></span><span class="t"><span class="op">@</span><span class="nam">admin_bp</span><span class="op">.</span><span class="nam">route</span><span class="op">(</span><span class="str">"/deactivate_operario/&lt;int:user_id>"</span><span class="op">,</span> <span class="nam">methods</span><span class="op">=</span><span class="op">[</span><span class="str">"POST"</span><span class="op">]</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="run"><span class="n"><a id="t800" href="#t800">800</a></span><span class="t"><span class="op">@</span><span class="nam">login_required</span>&nbsp;</span><span class="r"></span></p>
    <p class="run"><span class="n"><a id="t801" href="#t801">801</a></span><span class="t"><span class="op">@</span><span class="nam">roles_required</span><span class="op">(</span><span class="nam">ROLE_ADMIN</span><span class="op">,</span> <span class="nam">ROLE_RRHH</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="run"><span class="n"><a id="t802" href="#t802">802</a></span><span class="t"><span class="key">def</span> <span class="nam">deactivate_operario</span><span class="op">(</span><span class="nam">user_id</span><span class="op">)</span><span class="op">:</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t803" href="#t803">803</a></span><span class="t">    <span class="nam">user</span> <span class="op">=</span> <span class="nam">User</span><span class="op">.</span><span class="nam">query</span><span class="op">.</span><span class="nam">get</span><span class="op">(</span><span class="nam">user_id</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
