    <p class="pln"><span class="n"><a id="t54" href="#t54">54</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t55" href="#t55">55</a></span><span class="t">    <span class="com"># 2. LLAMADA AL SERVICIO CENTRALIZADO</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t56" href="#t56">56</a></span><span class="t">    <span class="com"># Esta funci&#243;n ya hace las queries, filtros de seguridad, c&#225;lculos de fechas,</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t57" href="#t57">57</a></span><span class="t">    <span class="com"># contadores de libres/ocupados y l&#243;gica de timeline.</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t58" href="#t58">58</a></span><span class="t">    <span class="nam">context</span> <span class="op">=</span> <span class="nam">get_dashboard_data</span><span class="op">(</span><span class="nam">current_user</span><span class="op">,</span> <span class="nam">date_str</span><span class="op">,</span> <span class="nam">view_mode</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t59" href="#t59">59</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t60" href="#t60">60</a></span><span class="t">    <span class="com"># 3. A&#241;adir configuraci&#243;n espec&#237;fica de la vista de JEFE</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t61" href="#t61">61</a></span><span class="t">    <span class="com"># Sobrescribimos las URLs de navegaci&#243;n para que apunten a este blueprint</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t62" href="#t62">62</a></span><span class="t">    <span class="nam">context</span><span class="op">[</span><span class="str">'prev_month_url'</span><span class="op">]</span> <span class="op">=</span> <span class="nam">url_for</span><span class="op">(</span><span class="str">'jefe.obras_detailed'</span><span class="op">,</span> <span class="nam">selected_date</span><span class="op">=</span><span class="nam">context</span><span class="op">[</span><span class="str">'prev_date_str'</span><span class="op">]</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t63" href="#t63">63</a></span><span class="t">    <span class="nam">context</span><span class="op">[</span><span class="str">'next_month_url'</span><span class="op">]</span> <span class="op">=</span> <span class="nam">url_for</span><span class="op">(</span><span class="str">'jefe.obras_detailed'</span><span class="op">,</span> <span class="nam">selected_date</span><span class="op">=</span><span class="nam">context</span><span class="op">[</span><span class="str">'next_date_str'</span><span class="op">]</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t64" href="#t64">64</a></span><span class="t">    <span class="nam">context</span><span class="op">[</span><span class="str">'view_mode'</span><span class="op">]</span> <span class="op">=</span> <span class="str">'jefe'</span> <span class="com"># Para que el HTML oculte botones de Admin</span>&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t65" href="#t65">65</a></span><span class="t">&nbsp;</span><span class="r"></span></p>
    <p class="pln"><span class="n"><a id="t66" href="#t66">66</a></span><span class="t">    <span class="com"># 4. Renderizar pasando todo el diccionario del contexto</span>&nbsp;</span><span class="r"></span></p>
