    <p class="run"><span class="n"><a id="t32" href="#t32">32</a></span><span class="t"><span class="key">from</span> <span class="nam">app</span><span class="op">.</span><span class="nam">services</span><span class="op">.</span><span class="nam">dashboard_service</span> <span class="key">import</span> <span class="nam">get_dashboard_data</span><span class="op">,</span> <span class="nam">parse_date</span>&nbsp;</span><span class="r"></span></p>
