    <p class="run"><span class="n"><a id="t87" href="#t87">87</a></span><span class="t"><span class="key">def</span> <span class="nam">configurar_modulos_tenant</span><span class="op">(</span><span class="nam">id_tenant</span><span class="op">)</span><span class="op">:</span>&nbsp;</span><span class="r"></span></p>
    <p class="mis show_mis"><span class="n"><a id="t88" href="#t88">88</a></span><span class="t">    <span class="nam">tenant</span> <span class="op">=</span> <span class="nam">Tenant</span><span class="op">.</span><span class="nam">query</span><span class="op">.</span><span class="nam">get_or_404</span><span class="op">(</span><span class="nam">id_tenant</span><span class="op">)</span>&nbsp;</span><span class="r"></span></p>
