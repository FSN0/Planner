    fecha_str = request.form.get('fecha')
    descripcion = request.form.get('descripcion')
    
    if fecha_str:
        try:
            fecha_obj = datetime.strptime(fecha_str, '%Y-%m-%d').date()
            # Comprobar si ya existe
