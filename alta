    <script>
    (function () {
      var nombre = document.getElementById('nombre_empresa');
      var sub = document.getElementById('subdominio');
      var preview = document.getElementById('preview-sub');
      var tocado = false;

      function slugify(texto) {
        return (texto || '')
          .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '')
          .replace(/-{2,}/g, '-')
          .slice(0, 32)
          .replace(/-+$/g, '');
      }

      var fallback = "tuempresa";
      function refrescarPreview() {
        var valor = (sub.value || '').trim() || slugify(nombre.value) || fallback;
        preview.textContent = valor;
      }

      nombre.addEventListener('input', function () {
        if (!tocado) {
          sub.value = slugify(nombre.value);
        }
        refrescarPreview();
      });
      sub.addEventListener('input', function () {
        tocado = true;
        refrescarPreview();
      });
      refrescarPreview();
    })();
    </script>
    

