{
    on_demand_tls {
        ask http://web:5000/api/v6/check-domain
    }
}

# Un solo host indexable: apex. www redirige (Search Console estaba partido).
www.signaplan.com {
    redir https://signaplan.com{uri} 301
}

signaplan.com {
    # Match Gunicorn timeout for large notas-por-voz uploads (~10 min).
    reverse_proxy web:5000 {
        transport http {
            read_timeout 600s
            write_timeout 600s
            dial_timeout 10s
        }
    }
    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-XSS-Protection "1; mode=block"
        -Server
    }
}

# Dominio dedicado Soltec (login local SignaPlan, sin Forward Auth)
planner.soltecgrupo.es {
    reverse_proxy web:5000 {
        transport http {
            read_timeout 600s
            write_timeout 600s
            dial_timeout 10s
        }
    }
    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-XSS-Protection "1; mode=block"
        -Server
    }
}

# Subdominios *.signaplan.com y dominios propios de clientes (on-demand TLS).
# Caddy abre :80 automáticamente para los retos ACME http-01.
# No añadir un bloque :80 con reverse_proxy aquí: rompería la emisión de certificados.
#
# IMPORTANTE: el catch-all puede acabar sirviendo www con 200 y duplicar el apex
# en Google. Redirigimos www también aquí (cinturón + tirantes junto al bloque de arriba).
https:// {
    @www host www.signaplan.com
    redir @www https://signaplan.com{uri} 301

    tls {
        on_demand
    }

    reverse_proxy web:5000 {
        transport http {
            read_timeout 600s
            write_timeout 600s
            dial_timeout 10s
        }
    }
    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-XSS-Protection "1; mode=block"
        -Server
    }
}
