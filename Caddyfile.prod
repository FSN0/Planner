{
    on_demand_tls {
        # Ahora sí apunta al contenedor 'web' y a la ruta exacta de tu API v6
        ask http://web:5000/api/v6/check-domain

    }
}

# Dominios base (generan el certificado normal)
signaplan.com, www.signaplan.com {
    reverse_proxy web:5000
    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-XSS-Protection "1; mode=block"
        -Server
    }
}

# Bloque atrapalotodo para los subdominios de los clientes (On-Demand TLS)
https:// {
    tls {
        on_demand
    }

    reverse_proxy web:5000
    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-XSS-Protection "1; mode=block"
        -Server
    }
}