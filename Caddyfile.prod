{
    on_demand_tls {
        ask http://web:5000/api/v6/check-domain
    }
}

# Dominio raíz SignaPlan (certificado estático)
signaplan.com, www.signaplan.com {
    reverse_proxy web:5000
    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-XSS-Protection "1; mode=block"
        -Server
    }
}

# Soltec Hub SSO — planner.soltecgrupo.es (Forward Auth → Authentik en apps.soltecgrupo.es)
# Instalado por hub/provision/install_planner_hub_sso.py
planner.soltecgrupo.es {
    handle /outpost.goauthentik.io/* {
        reverse_proxy https://apps.soltecgrupo.es {
            header_up Host planner.soltecgrupo.es
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host planner.soltecgrupo.es
        }
    }

    handle /sso/hub* {
        forward_auth {
            uri /outpost.goauthentik.io/auth/caddy
            copy_headers X-authentik-username X-authentik-email X-authentik-name X-authentik-uid X-authentik-groups X-authentik-jwt X-authentik-entitlements
        }
        reverse_proxy web:5000
    }

    handle {
        reverse_proxy web:5000
    }

    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-XSS-Protection "1; mode=block"
        -Server
    }
}

# Subdominios *.signaplan.com y dominios propios de clientes (on-demand TLS).
# Caddy abre :80 automáticamente para los retos ACME http-01.
# No añadir un bloque :80 con reverse_proxy aquí: rompería la emisión de certificados.
https:// {
    tls {
        on_demand
    }

    reverse_proxy web:5000
    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-XSS-Protection "1; mode=block"
        -Server
    }
}
