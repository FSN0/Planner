# Ruta al código en el servidor (hermano de project/)
ODOO_ALTA_BUILD_CONTEXT=../soltec_creacion_contactos/odoo_web_app

# =============================================================================
# DNS - Configurar en tu proveedor (IONOS / Cloudflare / etc.):
#   signaplan.com         -> A record -> IP_SERVIDOR
#   *.signaplan.com       -> A record -> IP_SERVIDOR
#   alta-odoo.signaplan.com -> A record -> IP_SERVIDOR  (o mismo wildcard)
#
# Caddy generará certificados HTTPS automáticamente (On-Demand TLS)
# =============================================================================
