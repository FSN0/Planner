# =============================================================================
# SignaPlan - Variables de entorno para PRODUCCIÓN
# =============================================================================
# Copia este archivo en el servidor: cp .env.production.example .env
# NUNCA subas el .env real al repositorio.s
# =============================================================================

# --- DOMINIO ---
DOMAIN=signaplan.com

# --- SEGURIDAD (OBLIGATORIOS - genera valores únicos) ---
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# python3 -c "import secrets; print(secrets.token_hex(32))"
SSO_SECRET_KEY=

# --- BASE DE DATOS ---
# python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# --- SUPERADMIN (panel /superadmin para gestionar tenants) ---
SUPERADMIN_USER=
SUPERADMIN_PASS=

# --- CORREO (IONOS — info@signaplan.com) ---
MAIL_SERVER=smtp.ionos.es
MAIL_PORT=587
MAIL_USERNAME=info@signaplan.com
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=info@signaplan.com

# --- ODOO (sincronización / también usado por la app Alta Odoo) ---
ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_PASSWORD=

# --- ENLACE A APP ALTA ODOO (Soltec — servidor independiente) ---
ODOO_ALTA_APP_URL=https://alta.soltecgrupo.es
# Tenant cuyos usuarios pueden usar el módulo (API login remoto)
ODOO_ALTA_TENANT_SLUG=soltec
# SSO_SECRET_KEY debe coincidir con el .env de la app de altas del cliente

# --- PROXY / HOSTS DEDICADOS ---
# BEHIND_PROXY=true detrás de Caddy (HTTPS, IPs reales)
BEHIND_PROXY=true
# Hosts dedicados → tenant (csv). Entradas con punto = hostname; sin punto = subdominio.
# Ej: planner.soltecgrupo.es resuelve al tenant soltec
TENANT_HOST_ALIASES=soltec,planner.soltecgrupo.es

# --- FACTURACIÓN ---
# false: sin cobro ni cupos (fase pre-autónomo / pre-Stripe).
# true: freemium + geo de pago cuando haya entidad fiscal y Stripe.
BILLING_ENFORCED=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
# SIGNAPLAN_BASE_DOMAIN=signaplan.com

# --- ANALÍTICA (opcional; solo tras consentimiento en el banner de cookies) ---
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# --- DATOS DEMO (trial post-alta) ---
# DEMO_N_OBRAS=10
# DEMO_N_EMPLEADOS=28
# DEMO_N_VEHICULOS=5
# DEMO_N_JEFES=2
# DEMO_N_DIAS=14

# --- LEGALES (titular del servicio) ---
LEGAL_RAZON_SOCIAL=Francisco Navarro Hernández
LEGAL_NIF=18461268L
LEGAL_DOMICILIO=Calle La Ermita 23, Teruel
LEGAL_EMAIL=info@signaplan.com
CONTACT_EMAIL=info@signaplan.com

# =============================================================================
# DNS SignaPlan:
#   signaplan.com           -> A record -> IP_SERVIDOR_SIGNAPLAN
#   *.signaplan.com         -> A record -> IP_SERVIDOR_SIGNAPLAN
#   planner.soltecgrupo.es  -> A record -> IP_SERVIDOR_SIGNAPLAN (opcional)
# La app de altas tiene su propio DNS y despliegue
# =============================================================================
