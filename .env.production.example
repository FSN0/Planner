# =============================================================================
# SIGNAPLAN - Variables de entorno para producción
# =============================================================================
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el .env real al repositorio.

# --- DOMINIO ---
DOMAIN=signaplan.com

# --- SEGURIDAD (OBLIGATORIOS) ---
# Genera con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Genera con: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Genera con: python3 -c "import secrets; print(secrets.token_hex(32))"
SSO_SECRET_KEY=

# --- BASE DE DATOS ---
POSTGRES_PASSWORD=

# --- SUPERADMIN (panel /superadmin para gestionar tenants) ---
SUPERADMIN_USER=admin@signaplan.com
SUPERADMIN_PASS=

# --- CORREO (SMTP) ---
# Configurar cuando se active el servicio de email
MAIL_SERVER=smtp.tuservidor.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- ODOO (sincronización) ---
ODOO_URL=https://tu-instancia-odoo.com
ODOO_DB=nombre_base_datos_odoo
ODOO_USER=usuario_odoo
ODOO_PASSWORD=password_odoo

# --- DNS (IONOS) ---
# Configura en IONOS:
#   signaplan.com      -> A record -> IP_DEL_SERVIDOR
#   *.signaplan.com    -> A record -> IP_DEL_SERVIDOR
# Caddy generará certificados HTTPS automáticamente (on-demand TLS)
