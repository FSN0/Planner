# --- SSO HUB (Authentik Forward Auth en /sso/hub) ---
HUB_SSO_ENABLED=true
BEHIND_PROXY=true
HUB_URL=https://apps.soltecgrupo.es
# Subdominio tenant o dominio custom permitidos (csv)
HUB_SSO_TENANTS=soltec,planner.soltecgrupo.es
HUB_AUTHENTIK_URL=https://apps.soltecgrupo.es

