# --- ODOO (sincronización / también usado por la app Alta Odoo) ---
ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_PASSWORD=

# --- ENLACE A APP ALTA ODOO (Soltec — servidor independiente) ---
ODOO_ALTA_APP_URL=https://alta.soltecgrupo.es
# Tenant cuyos usuarios pueden usar el módulo (API login remoto)
ODOO_ALTA_TENANT_SLUG=soltec
# SSO_SECRET_KEY debe coincidir con el .env de la app de altas del cliente

# --- PROXY / HOSTS DEDICADOS ---
# BEHIND_PROXY=true detrás de Caddy (HTTPS, IPs reales)
BEHIND_PROXY=true
# Hosts dedicados → tenant (csv). Entradas con punto = hostname; sin punto = subdominio.
# Ej: planner.soltecgrupo.es resuelve al tenant soltec
TENANT_HOST_ALIASES=soltec,planner.soltecgrupo.es

# --- FACTURACIÓN ---
# false: sin cobro ni cupos (fase pre-autónomo / pre-Stripe).
# true: freemium + geo de pago cuando haya entidad fiscal y Stripe.
BILLING_ENFORCED=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
