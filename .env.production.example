# Tenant SignaPlan que puede usar Alta Odoo
ODOO_ALTA_TENANT_SLUG=soltec
ODOO_ALTA_TENANT_HOST=soltec.signaplan.com
ODOO_ALTA_TENANT_NAME=Soltec
# Secreto de sesión Flask de la app de altas (generar uno nuevo)
# python3 -c "import secrets; print(secrets.token_hex(32))"
