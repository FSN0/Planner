# =============================================================================
# SignaPlan - .gitignore
# =============================================================================

# --- Entornos y secretos ---
.env
.env.test
.env.production
.env.local

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
venv/
.venv/

# --- Backups y subidas ---
backups/
uploads/
app/static/uploads/

# --- Celery ---
celerybeat-schedule
celerybeat-schedule.db
celerybeat-schedule.dir
celerybeat-schedule.bak

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/
*.coverage
.tox/
coverage.xml

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db

# --- Docker (no ignorar compose files) ---
# Los volúmenes de datos se manejan por Docker, no por el repo
