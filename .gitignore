# =============================================================================
# SignaPlan - .gitignore
# =============================================================================

# --- Entornos y secretos ---
# Se ignora cualquier .env y se rescatan solo los de ejemplo. Antes se listaban
# uno a uno y .env.SAS, con credenciales reales, se coló en el repositorio por
# no coincidir con ninguno de los nombres previstos.
.env
.env.*
!.env.example
!.env.*.example

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
venv/
.venv/

# --- Backups y subidas ---
backups/
uploads/
app/static/uploads/

# --- Celery ---
celerybeat-schedule
celerybeat-schedule.db
celerybeat-schedule.dir
celerybeat-schedule.bak

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/
*.coverage
.tox/
coverage.xml

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db

# --- Basura / dumps accidentales ---
salida.txyt
*.txyt

# --- Docker (no ignorar compose files) ---
# Los volúmenes de datos se manejan por Docker, no por el repo
