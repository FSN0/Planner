

===== ./docker-compose.yml =====

version: '3.8'

services:
  web:
    build: .
    container_name: odoo_alta_personal
    restart: always
    env_file:
      - .env
    ports:
      - "5002:5002"

===== ./templates/login.html =====

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Acceso - Alta Personal</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 h-screen flex items-center justify-center">
    <div class="bg-white p-8 rounded-lg shadow-xl w-full max-w-md">
        <h2 class="text-2xl font-bold mb-6 text-center text-gray-800">Acceso Soltec</h2>
        
        {% with messages = get_flashed_messages(category_filter=["error"]) %}
          {% if messages %}
            <div class="bg-red-100 text-red-700 p-3 rounded mb-4 text-sm text-center">
              {{ messages[0] }}
            </div>
          {% endif %}
        {% endwith %}

        <form method="POST">
            <div class="mb-4">
                <label class="block text-gray-700 text-sm font-bold mb-2">Código BIM / Asistencia</label>
                <input type="text" name="codigo_bim" required class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div class="mb-6">
                <label class="block text-gray-700 text-sm font-bold mb-2">Nombre y Apellidos</label>
                <input type="text" name="nombre_empleado" required class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline transition duration-300">
                Entrar
            </button>
        </form>
    </div>
</body>
</html>

===== ./templates/dashboard.html =====

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Dashboard - Alta Personal</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
    <nav class="bg-blue-800 p-4 text-white flex justify-between items-center shadow-md">
        <h1 class="text-xl font-bold">Portal Alta Subcontratas - Soltec</h1>
        <div class="flex items-center gap-4">
            <span class="text-sm">Hola, <b>{{ usuario }}</b></span>
            <a href="{{ url_for('logout') }}" class="bg-red-500 hover:bg-red-600 px-3 py-1 rounded text-sm transition">Salir</a>
        </div>
    </nav>

    <div class="max-w-2xl mx-auto mt-10 mb-10">
        <div class="bg-white p-8 rounded-lg shadow-lg">
            <h2 class="text-2xl font-bold mb-6 text-gray-800">Alta de Nuevo Trabajador</h2>
            
            {% with messages = get_flashed_messages(category_filter=["success"]) %}
              {% if messages %}
                <div class="bg-green-100 text-green-800 p-4 rounded mb-6 font-medium border-l-4 border-green-500">
                  {{ messages[0] }}
                </div>
              {% endif %}
            {% endwith %}
            
            {% with messages = get_flashed_messages(category_filter=["warning"]) %}
              {% if messages %}
                <div class="bg-yellow-100 text-yellow-800 p-4 rounded mb-6 font-medium border-l-4 border-yellow-500">
                  {{ messages[0] }}
                </div>
              {% endif %}
            {% endwith %}

            {% with messages = get_flashed_messages(category_filter=["error"]) %}
              {% if messages %}
                <div class="bg-red-100 text-red-800 p-4 rounded mb-6 font-medium border-l-4 border-red-500">
                  {{ messages[0] }}
                </div>
              {% endif %}
            {% endwith %}

            <form method="POST">
                <div class="mb-4">
                    <label class="block text-gray-700 font-bold mb-2">Nombre completo del trabajador</label>
                    <input type="text" name="nombre_trabajador" required class="w-full px-3 py-2 border rounded focus:ring-2 focus:ring-blue-500 outline-none">
                </div>
                
                <div class="mb-4">
                    <label class="block text-gray-700 font-bold mb-2">DNI / NIE</label>
                    <input type="text" name="dni" required class="w-full px-3 py-2 border rounded focus:ring-2 focus:ring-blue-500 outline-none uppercase">
                </div>
                
                <div class="mb-6">
                    <label class="block text-gray-700 font-bold mb-2">Empresa Subcontrata</label>
                    <div class="flex gap-2" id="empresa-container">
                        <select name="empresa_id" id="empresa_select" required class="w-full px-3 py-2 border rounded focus:ring-2 focus:ring-blue-500 outline-none bg-white">
                            <option value="" disabled selected>Selecciona una empresa...</option>
                            {% for emp in empresas %}
                                <option value="{{ emp.id }}">{{ emp.name }}</option>
                            {% endfor %}
                        </select>
                        
                        <input type="text" name="nueva_empresa" id="nueva_empresa_input" placeholder="Nombre de la nueva empresa" class="hidden w-full px-3 py-2 border rounded focus:ring-2 focus:ring-blue-500 outline-none">
                        
                        <button type="button" id="btn_toggle_empresa" title="Crear nueva empresa" class="bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-2 px-4 rounded transition">
                            ➕
                        </button>
                    </div>
                    <p class="text-xs text-gray-500 mt-1" id="empresa_help">Selecciona una empresa existente o pulsa ➕ para crear una nueva.</p>
                </div>
                
                <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-4 rounded transition duration-300 shadow-md">
                    📥 Guardar Trabajador en Odoo
                </button>
            </form>
        </div>
    </div>

    <script>
        const btnToggle = document.getElementById('btn_toggle_empresa');
        const selectEmpresa = document.getElementById('empresa_select');
        const inputEmpresa = document.getElementById('nueva_empresa_input');
        const helpText = document.getElementById('empresa_help');

        btnToggle.addEventListener('click', () => {
            if (inputEmpresa.classList.contains('hidden')) {
                inputEmpresa.classList.remove('hidden');
                inputEmpresa.required = true;
                selectEmpresa.classList.add('hidden');
                selectEmpresa.required = false;
                selectEmpresa.value = '';
                btnToggle.textContent = '❌';
                helpText.textContent = 'Introduce el nombre de la nueva empresa que se creará en Odoo.';
            } else {
                inputEmpresa.classList.add('hidden');
                inputEmpresa.required = false;
                inputEmpresa.value = '';
                selectEmpresa.classList.remove('hidden');
                selectEmpresa.required = true;
                btnToggle.textContent = '➕';
                helpText.textContent = 'Selecciona una empresa existente o pulsa ➕ para crear una nueva.';
            }
        });
    </script>
</body>
</html>

===== ./app.py =====

import os
import xmlrpc.client
import unicodedata
from flask import Flask, render_template, request, redirect, url_for, session, flash
from dotenv import load_dotenv

load_dotenv()

app = Flask(__name__)
app.secret_key = os.getenv('FLASK_SECRET_KEY')

# --- CONFIGURACIÓN ---
URL = os.getenv('ODOO_URL')
DB = os.getenv('ODOO_DB')
USER = os.getenv('ODOO_USER')
PASSWORD = os.getenv('ODOO_PASSWORD')

CAMPO_CODIGO_EMPLEADO = 'attendance_password'

def conectar_odoo():
    common = xmlrpc.client.ServerProxy(f'{URL}/xmlrpc/2/common')
    uid = common.authenticate(DB, USER, PASSWORD, {})
    if not uid:
        raise Exception("Error de autenticación con Odoo.")
    models = xmlrpc.client.ServerProxy(f'{URL}/xmlrpc/2/object')
    return uid, models

def normalizar_texto(texto):
    if not texto: return ""
    texto = texto.upper().strip()
    return ''.join(c for c in unicodedata.normalize('NFD', texto) if unicodedata.category(c) != 'Mn')

@app.route('/', methods=['GET', 'POST'])
def login():
    if request.method == 'POST':
        codigo = request.form.get('codigo_bim', '').strip()
        nombre_input = request.form.get('nombre_empleado', '').strip()

        try:
            uid, models = conectar_odoo()
            empleado = models.execute_kw(DB, uid, PASSWORD, 'hr.employee', 'search_read',
                [[[CAMPO_CODIGO_EMPLEADO, '=', codigo]]],
                {'fields': ['name'], 'limit': 1}
            )

            if empleado:
                nombre_db = empleado[0]['name']
                if normalizar_texto(nombre_input) in normalizar_texto(nombre_db) or normalizar_texto(nombre_db) in normalizar_texto(nombre_input):
                    session['logged_in'] = True
                    session['user_name'] = nombre_db
                    return redirect(url_for('dashboard'))
                else:
                    flash('El nombre no coincide con el registro.', 'error')
            else:
                flash('Código no válido.', 'error')
        except Exception as e:
            flash(f'Error de conexión: {str(e)}', 'error')

    return render_template('login.html')

@app.route('/dashboard', methods=['GET', 'POST'])
def dashboard():
    if not session.get('logged_in'):
        return redirect(url_for('login'))

    uid, models = conectar_odoo()
    
    # 1. ASEGURAR ETIQUETA 'Subcontrata'
    tag_search = models.execute_kw(DB, uid, PASSWORD, 'res.partner.category', 'search', [[['name', '=ilike', 'subcontrata']]])
    if tag_search:
        tag_id = tag_search[0]
    else:
        tag_id = models.execute_kw(DB, uid, PASSWORD, 'res.partner.category', 'create', [{'name': 'Subcontrata'}])

    # 2. CARGAR EMPRESAS (Cualquier partner que sea compañía Y tenga la etiqueta)
    empresas = models.execute_kw(DB, uid, PASSWORD, 'res.partner', 'search_read',
        [[['is_company', '=', True], ['category_id', 'in', [tag_id]]]],
        {'fields': ['id', 'name'], 'order': 'name asc'}
    )

    # --- FALLBACK DE SEGURIDAD AÑADIDO AQUÍ ---
    # Si Odoo no devuelve nada (por fallos de caché de etiquetas), cargamos TODAS las compañías.
    if not empresas:
        empresas = models.execute_kw(DB, uid, PASSWORD, 'res.partner', 'search_read',
            [[['is_company', '=', True]]],
            {'fields': ['id', 'name'], 'order': 'name asc'}
        )
        # Esto te avisará visualmente si el filtro de etiquetas ha fallado
        flash("Aviso: Mostrando todas las empresas porque el filtro de etiquetas no encontró resultados.", "warning")
    # ------------------------------------------

    if request.method == 'POST':
        nombre_trabajador = request.form.get('nombre_trabajador').strip()
        dni = request.form.get('dni').strip().upper()
        empresa_id_form = request.form.get('empresa_id')
        nueva_empresa_nombre = request.form.get('nueva_empresa', '').strip()

        try:
            # CHECK TRABAJADOR DUPLICADO
            duplicado = models.execute_kw(DB, uid, PASSWORD, 'res.partner', 'search', 
                [[['attendance_password', '=ilike', dni], ['is_company', '=', False]]])
            if duplicado:
                flash(f'⚠️ El DNI {dni} ya existe como trabajador. No se ha creado.', 'error')
                return redirect(url_for('dashboard'))

            # LÓGICA DE EMPRESA
            if nueva_empresa_nombre:
                # Búsqueda agresiva: ¿Existe alguien con este nombre?
                emp_existente = models.execute_kw(DB, uid, PASSWORD, 'res.partner', 'search', 
                    [[['name', '=ilike', nueva_empresa_nombre]]])
                
                if emp_existente:
                    empresa_id = emp_existente[0]
                    # REPARACIÓN: Si existe, nos aseguramos de que sea "Compañía" y tenga la etiqueta
                    models.execute_kw(DB, uid, PASSWORD, 'res.partner', 'write', [
                        [empresa_id], 
                        {
                            'is_company': True, 
                            'category_id': [(4, tag_id)] # (4, ID) añade la etiqueta si no la tiene
                        }
                    ])
                    flash(f'ℹ️ La empresa "{nueva_empresa_nombre}" ya existía. Se ha actualizado y vinculado.', 'warning')
                else:
                    # CREACIÓN LIMPIA
                    empresa_id = models.execute_kw(DB, uid, PASSWORD, 'res.partner', 'create', [{
                        'name': nueva_empresa_nombre, 
                        'is_company': True, 
                        'category_id': [(6, 0, [tag_id])] # (6, 0, [IDs]) establece estas etiquetas exactamente
                    }])
            else:
                empresa_id = int(empresa_id_form)

            # CREAR TRABAJADOR
            models.execute_kw(DB, uid, PASSWORD, 'res.partner', 'create', [{
                'name': nombre_trabajador,
                'is_company': False,
                'parent_id': empresa_id,
                'type': 'contact',
                'vat': dni,
                'attendance_password': dni
            }])
            
            flash(f'✅ {nombre_trabajador} dado de alta correctamente.', 'success')
            return redirect(url_for('dashboard'))
            
        except Exception as e:
            flash(f'❌ Error: {str(e)}', 'error')

    return render_template('dashboard.html', empresas=empresas, usuario=session.get('user_name'))

@app.route('/logout')
def logout():
    session.clear()
    return redirect(url_for('login'))

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=5002)

===== ./Dockerfile =====

FROM python:3.10-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Usamos Gunicorn para producción, exponiendo el puerto 5000
CMD ["gunicorn", "-w", "4", "-b", "0.0.0.0:5002", "app:app"]