# =============================================================================
# Alta Odoo — Producción (referencia)
# =============================================================================
# En producción estas variables las inyecta docker-compose.prod.yml de SignaPlan.
# Solo necesitas este archivo si despliegas la app de altas por separado.
# =============================================================================

FLASK_SECRET_KEY=
SSO_SECRET_KEY=
SESSION_COOKIE_SECURE=true

# Llamada interna al API de SignaPlan (misma red Docker)
SIGNAPLAN_AUTH_URL=http://web:5000/api/v6/odoo-alta/login
SIGNAPLAN_TENANT=soltec
SIGNAPLAN_TENANT_HOST=soltec.signaplan.com
SIGNAPLAN_TENANT_NAME=Soltec

ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_PASSWORD=
